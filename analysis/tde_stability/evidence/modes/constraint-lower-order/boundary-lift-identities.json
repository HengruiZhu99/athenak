{
  "exact_symbolic_checks": {
    "Hamiltonian_spatial_curvature_vs_warped_metric": true,
    "background_Hamiltonian": true,
    "radial_momentum_covariant_divergence": true,
    "constraint_incoming_normal_derivative_identities": true
  },
  "definitions": {
    "C1": "alpha Theta + chi Gamma/2 + u_prime",
    "C2": "4k/(3alpha)+2Theta/(3alpha)-2aTF/alpha-Gamma+h_prime",
    "F_Theta": "alpha*C1_prime+L_Theta",
    "F_Q": "-chi*C2_prime+L_Q",
    "outgoing_coordinate_speed": "r**2/(r + 1)**2 - r/(r + 1)**2",
    "falloff_weights": "coordinate p1: omegaT=omegaQ=1/r; physical amplitude: omegaT=1/(r+1), omegaQ=1/r"
  },
  "L_Theta_coefficients": {
    "u(r)": "5/(r*(r + 1)**3)",
    "h(r)": "r*(9*r**2 + 9*r + 1)/(3*(r + 1)**5)",
    "k(r)": "2*r/(3*(r + 1)**3)",
    "Theta(r)": "(3*omega_Theta*r**3 - 3*omega_Theta*r - 6*r**3*sigma - 18*r**2*sigma - 18*r*sigma + r - 6*sigma)/(3*(r + 1)**3)",
    "aTF(r)": "2*r/(r + 1)**3",
    "q(r)": "r**3/(r + 1)**4",
    "Derivative(u(r), r)": "(2*r - 3)/(r + 1)**2",
    "Derivative(h(r), r)": "r**2*(r - 2)/(r + 1)**4"
  },
  "L_Q_coefficients": {
    "u(r)": "-8/(r**2*(r + 1)**2)",
    "h(r)": "(9*r**2 + 22*r + 9)/(3*(r + 1)**4)",
    "k(r)": "-4/(3*(r + 1)**2)",
    "Theta(r)": "-2/(3*(r + 1)**2)",
    "aTF(r)": "2*(3*r + 1)/(r + 1)**2",
    "q(r)": "(omega_Q*r**2 - omega_Q*r - 2*r**2*sigma - 4*r*sigma - 2*sigma)/(r + 1)**2",
    "Derivative(u(r), r)": "4/(r*(r + 1))",
    "Derivative(h(r), r)": "-r*(9*r - 1)/(3*(r + 1)**3)"
  }
}
