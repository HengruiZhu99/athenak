+        std::cerr << "Mode input byte count mismatch.\n";
+        std::exit(EXIT_FAILURE);
+      }
+      stream.seekg(0);
+      stream.read(reinterpret_cast<char*>(h.data()), count*sizeof(Real));
+      if (!stream) std::exit(EXIT_FAILURE);
+      for (std::size_t i=0; i<count; ++i) {
+        if (!std::isfinite(h.data()[i])) std::exit(EXIT_FAILURE);
+      }
+      Kokkos::deep_copy(z->u0, h);
+      // Refresh reconstructed full metric and ADM cache; preserve supplied
+      // ghost state. Initialization has already completed/cleared exchanges.
+      z->Z4cToADM(pmesh->pmb_pack);
+    }
+  }
