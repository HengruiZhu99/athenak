index 00000000..c9debe9d
--- /dev/null
+++ b/src/z4c/covariant_sources.hpp
@@ -0,0 +1,62 @@
+#ifndef Z4C_COVARIANT_SOURCES_HPP_
+#define Z4C_COVARIANT_SOURCES_HPP_
+
+// Coupled lower-order constraint additions from covariant CCZ4 (kappa3=1),
+// expressed in the repository's Khat=K-2Theta and chi=psi^-4 variables.
+// KOKKOS_INLINE_FUNCTION is supplied by the including translation unit.
+// No gauge, matter, projection, or principal derivative operator is changed.
+namespace z4c {
+
+template <typename Scalar>
+struct CovariantConstraintSource {
+  Scalar khat = 0.0;
+  Scalar theta = 0.0;
+  Scalar gamma[3] = {};
+  Scalar A[3][3] = {};
+};
+
+template <typename Scalar>
+KOKKOS_INLINE_FUNCTION
+CovariantConstraintSource<Scalar> BuildCovariantConstraintSource(
+    Scalar alpha, Scalar chi, Scalar K, Scalar Theta,
+    const Scalar g[3][3], const Scalar gi[3][3], const Scalar A[3][3],
+    const Scalar Q[3], const Scalar dalpha[3], const Scalar dchi[3],
+    const Scalar dg[3][3][3], const Scalar dbeta[3][3]) {
+  CovariantConstraintSource<Scalar> out;
+  Scalar E[3][3] = {};
+  Scalar Qlower[3] = {};
+  Scalar Qdchi = 0.0, Qdalpha = 0.0, divbeta = 0.0;
+  for (int a = 0; a < 3; ++a) {
+    Qdchi += Q[a]*dchi[a];
+    Qdalpha += Q[a]*dalpha[a];
+    divbeta += dbeta[a][a];
+    for (int b = 0; b < 3; ++b) Qlower[a] += g[a][b]*Q[b];
+  }
+  // E_ij = D_i Z_j + D_j Z_i - gtilde_k(i d_j)Q^k.
+  // dg[c][a][b] and dbeta[c][a] carry the derivative index first.
+  Scalar trE = 0.0;  // Conformal trace; physical trace is chi*trE.
+  for (int a = 0; a < 3; ++a)
+  for (int b = 0; b < 3; ++b) {
+    for (int c = 0; c < 3; ++c) E[a][b] += 0.5*Q[c]*dg[c][a][b];
+    E[a][b] += (Qlower[a]*dchi[b] + Qlower[b]*dchi[a] -
+                g[a][b]*Qdchi)/(2.0*chi);
+    trE += gi[a][b]*E[a][b];
+  }
+  out.khat = chi*Qdalpha;
+  out.theta = 0.5*alpha*chi*trE - alpha*K*Theta - 0.5*chi*Qdalpha;
+  for (int a = 0; a < 3; ++a) {
+    out.gamma[a] = -(2.0/3.0)*alpha*K*Q[a] +
+                   (2.0/3.0)*Q[a]*divbeta;
+    for (int b = 0; b < 3; ++b) {
+      out.gamma[a] -= 2.0*gi[a][b]*Theta*dalpha[b] + Q[b]*dbeta[b][a];
+    }
+    for (int b = 0; b < 3; ++b) {
+      out.A[a][b] = alpha*chi*(E[a][b] - g[a][b]*trE/3.0) -
+                    2.0*alpha*Theta*A[a][b];
+    }
+  }
+  return out;
+}
