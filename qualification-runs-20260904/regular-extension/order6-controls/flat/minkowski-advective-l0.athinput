project_reduction_constraints = false
project_gauge_constraints = false

<problem>
pgen_name = pc_gh_minkowski

<output1>
file_type = tab
variable = pcgh
dt = 1.0
slice_x2 = 0.0
slice_x3 = 0.0

<output2>
file_type = rst
