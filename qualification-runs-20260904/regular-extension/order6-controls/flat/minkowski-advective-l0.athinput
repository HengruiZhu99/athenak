# Research candidate input; no numerical qualification implied.

<job>
basename = pc_gh_minkowski

<mesh>
nghost = 4
nx1 = 8
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = -1.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 4
x3min = -1.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 4
nx3 = 4

<time>
evolution = dynamic
integrator = rk3
cfl_number = .2
nlim = -1
