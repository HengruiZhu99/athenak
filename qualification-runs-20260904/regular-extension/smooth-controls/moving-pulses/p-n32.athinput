# Research candidate input; no numerical qualification implied.

<job>
basename = pc_gh_gauge_wave

<mesh>
nghost = 2
nx1 = 32
x1min = -2
x1max = 2
ix1_bc = periodic
ox1_bc = periodic
nx2 = 32
x2min = -2
x2max = 2
ix2_bc = periodic
ox2_bc = periodic
nx3 = 32
x3min = -2
x3max = 2
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<time>
evolution = dynamic
integrator = rk4
