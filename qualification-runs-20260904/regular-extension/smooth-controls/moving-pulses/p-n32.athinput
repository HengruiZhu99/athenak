reduction_core_radius = 0.2
reduction_taper_radius = 0.8
reduction_follow_trackers = true
co_0 = true
co_0_type = BH
co_0_x = -0.25
co_0_y = 0
co_0_z = 0
co_1 = true
co_1_type = BH
co_1_x = 0.25
co_1_y = 0
co_1_z = 0

<problem>
pgen_name = regular_extension_pulse
pulse_family = p
pulse_direction = 1
pulse_amplitude = 1e-8
pulse_width = 0.75
pulse_shift = 0.5
pulse_radial = true

<output1>
file_type = rst
dt = .25
