#!/bin/bash -l
#PBS -A CompactBinaryMerger
#PBS -q debug
#PBS -N telegraph-ah
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -l filesystems=flare:home
#PBS -l place=scatter
#PBS -j oe

set -euo pipefail
campaign=/lus/flare/projects/CompactBinaryMerger/hzhu/telegrapher_lapse_20260929
source_root="$campaign/source"
workflow="$source_root/experiments/telegrapher_aurora_20260929"
input_directory="${INPUT_DIRECTORY:-$workflow/inputs}"
executable_build="${EXECUTABLE_BUILD:-$source_root/build/aurora-sycl}"
exe="$executable_build/src/athena"
tile_wrapper="$(command -v gpu_tile_compact.sh)"
test -x "$exe"
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=8
export OMP_PLACES=threads
export OMP_PROC_BIND=spread
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
bind='list:1-8:9-16:17-24:25-32:33-40:41-48:53-60:61-68:69-76:77-84:85-92:93-100'
phase=${PHASE:-smoke}
if [[ $phase == smoke ]]; then
  cases='g1_fastflow_L5 g1_bhahaha_L5'
elif [[ $phase == ladder ]]; then
  cases='g1.5_fastflow_L5 g1.5_bhahaha_L5 g2_fastflow_L5 g2_bhahaha_L5 g3_fastflow_L6 g3_bhahaha_L6 g4_fastflow_L6 g4_bhahaha_L6 g5_fastflow_L6 g5_bhahaha_L6'
else
  cases=${CASE:?Set CASE to the input stem for an evolution}
fi
group="$campaign/runs/${phase}_${PBS_JOBID%%.*}"
mkdir -p "$group"
cp "$executable_build/source_commit.txt" "$group/source_commit.txt"
git -C "$source_root" rev-parse HEAD > "$group/input_commit.txt"
sha256sum "$exe" > "$group/executable.sha256"
module list > "$group/modules.txt" 2>&1
cat "$PBS_NODEFILE" > "$group/nodes.txt"
nodes=$(sort -u "$PBS_NODEFILE" | wc -l)
ranks=$((12 * nodes))
deadline=$((SECONDS + ${JOB_BUDGET_SECONDS:-3000}))
for case_name in $cases; do
  remaining=$((deadline - SECONDS))
  if (( remaining < 180 )); then
    echo "Batch time budget exhausted before starting $case_name"
    break
  fi
  printf -v time_budget '%02d:%02d:%02d' $((remaining / 3600)) \
    $((remaining % 3600 / 60)) $((remaining % 60))
  run="$group/$case_name"
  mkdir -p "$run"
  cp "$input_directory/$case_name.athinput" "$run/input.athinput"
  git -C "$source_root" rev-parse HEAD > "$run/input_commit.txt"
  sha256sum "$exe" > "$run/executable.sha256"
  cd "$run"
  overrides=()
  if (( nodes > 1 )); then
    capacity=128
    if [[ $case_name == *_L7 ]]; then capacity=384; fi
    overrides+=(mesh_refinement/max_nmb_per_rank=$((capacity / nodes + 32)))
  fi
  if [[ $phase == smoke || $phase == ladder ]]; then
    overrides+=(time/nlim=4)
  fi
  input_args=(-i "$run/input.athinput")
  if [[ -n ${RESTART_FILE:-} && ${RESTART_CASE:-$case_name} == "$case_name" ]]; then
    # Preserve the checkpoint's evolving tracker and output parameters.
    input_args=(-r "$RESTART_FILE")
    printf '%s\n' "$RESTART_FILE" > restart_source.txt
  fi
  if [[ -n ${FASTFLOW_FIND_DT:-} && $case_name == *fastflow* ]]; then
    overrides+=("fastflow/dt=$FASTFLOW_FIND_DT")
  fi
  printf '%q ' "$exe" "${input_args[@]}" -t "$time_budget" "${overrides[@]}" \
    > actual_arguments.txt
  printf '\n' >> actual_arguments.txt
  set +e
  mpiexec -n "$ranks" -ppn 12 --cpu-bind="$bind" \
    "$tile_wrapper" "$exe" "${input_args[@]}" \
    -t "$time_budget" "${overrides[@]}" > run.log 2>&1
  rc=$?
  set -e
  echo "$rc" > exit_status.txt
  if (( rc != 0 )); then
    tail -50 run.log
    exit "$rc"
  fi
done
