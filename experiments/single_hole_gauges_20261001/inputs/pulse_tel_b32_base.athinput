<comment>
problem = z4c one puncture
reference = e.g. Cook. Living Rev. Relativ. 3, 5 (2000)

<job>
basename = pulse_tel_b32_base

<mesh>
nghost = 4
nx1 = 128
x1min = -64
x1max = 64
ix1_bc = outflow
ox1_bc = outflow
nx2 = 128
x2min = -64
x2max = 64
ix2_bc = outflow
ox2_bc = outflow
nx3 = 128
x3min = -64
x3max = 64
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.25
nlim = -1
tlim = 6
ndiag = 50

<z4c>
lapse_harmonic = 0.0
lapse_oplog = 2.0
shift_eta = 2.0
shift_Gamma = 1.0
diss = 0.1
chi_div_floor = 0.00001
damp_kappa1 = 0.01
damp_kappa2 = 0.00
slow_start_lapse = false
ssl_damping_time = 20
ssl_damping_amp = 0.6
telegraph_lapse = true
telegraph_tau = 0.1
telegraph_kappa = 0.2
co_0_x = 0.0
co_0_y = 0.0
co_0_z = 0.0
co_0_mass = 1.0
co_0_radius = 0.8
co_0_reflevel = 5
tracker_mode = ode
spatial_order = 6
horizon_finder = bhahaha
co_0_type = BH
history_interior_radius = 8
history_inner_radius = 1
history_boundary_speed = 8
history_boundary_buffer = 4

<mesh_refinement>
refinement = static
max_nmb_per_rank = 128
num_levels = 7
refinement_interval = 1

<z4c_amr>
method = tracker

<problem>
pgen_name = z4c_one_puncture
punc_ADM_mass = 1
lapse_pulse_amplitude = 0
lapse_pulse_width = 1
lapse_pulse_x = 4
lapse_pulse_y = 0
lapse_pulse_z = 0

<refined_region1>
level = 5
x1min = -1
x1max = 1
x2min = -1
x2max = 1
x3min = -1
x3max = 1

<output1>
file_type = hst
dt = 0.05
data_format = %24.16e

<output2>
file_type = tab
variable = adm
dt = 0.05
slice_x2 = 0
slice_x3 = 0
data_format = %24.16e

<output3>
file_type = tab
variable = z4c
dt = 0.05
slice_x2 = 0
slice_x3 = 0
data_format = %24.16e

<output4>
file_type = tab
variable = con
dt = 0.05
slice_x2 = 0
slice_x3 = 0
data_format = %24.16e

<bhahaha>
bah_num_horizons = 1
bah_mass_0 = 1.0
bah_dt = 2
bah_initial_dt = 0.01
bah_max_itr = 20000
bah_Theta_Linf_tol = 1e-2
bah_Theta_L2_tol = 1e-3
bah_Nr_interp = 256
bah_max_search_radius = 2.0
bah_interp_half_width = 4
bah_num_resolutions_multigrid = 1
bah_Ntheta_array_multigrid_0 = 32
bah_Nphi_array_multigrid_0 = 64
bah_output_shape_every = 5
bah_verbosity = 1
bah_cold_start_each_find = true

<refined_region2>
level = 4
x1min = -8
x1max = 8
x2min = -2
x2max = 2
x3min = -2
x3max = 2

<refined_region3>
level = 3
x1min = -8
x1max = 8
x2min = -8
x2max = 8
x3min = -8
x3max = 8
