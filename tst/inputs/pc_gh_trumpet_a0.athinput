# PC-GH stationary Schwarzschild 1+log trumpet pointwise residual audit

<job>
basename = pc_gh_trumpet_a0

<mesh>
nghost = 2
nx1 = 32
x1min = -8.0
x1max = 8.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 32
x2min = -8.0
x2max = 8.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 32
x3min = -8.0
x3max = 8.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.1
nlim = 0
tlim = 0.0
ndiag = 1

<pc_gh>
spatial_order = 2
gauge = a0
gauge_a0_table = inputs/pc_gh/gauge_a0_m1.dat
gauge_mass = 1.0
kappa = 0.0
dissipation = 0.0
initial_data_division_floor = 1.0e-14
boundedness_output = false

<problem>
pgen_name = pc_gh_trumpet_a0
audit_r_min = 0.5
audit_r_max = 4.0
