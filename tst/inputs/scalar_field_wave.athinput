# Periodic real-scalar plane wave on a nontrivial, stationary ADM background

<job>
basename = scalar_field_wave

<mesh>
nghost = 2
nx1 = 16
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 16
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 1

<mesh_refinement>
refinement = none

<coord>
general_rel = true
minkowski = true

<adm>
dynamic = false

<scalar_field>
field_type = real
potential = free
mass = 0.7
lambda = 0.0
backreaction = false
diss = 0.0
spatial_order = 2

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.2
nlim = -1
tlim = 0.2
ndiag = 1

<problem>
pgen_name = scalar_field_plane_wave

# Present only so validation can exercise scalar rejection of shear-periodic
# boundaries without maintaining a second otherwise identical 2D input.
<shearing_box>
qshear = 1.5
omega0 = 1.0

# Disabled template used by the curved-volume history regression.
<output1>
file_type = hst
data_format = %.16e
dt = 0.0
