# Local pointwise puncture-exponent hard gate.  The production first-order-state
# estimator and the independent direct-FD diagnostic use the same actual
# Cartesian cell-center shell 2h <= r < 8h.  This input is intentionally strict:
# it exits nonzero if the two estimators do not converge toward one another.

<job>
basename = ref_gh_generic_singular_estimator

<mesh>
nghost = 4
nx1 = 8
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = -1.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = -1.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.05
nlim = 0
tlim = 0.0
ndiag = 1

<ref_gh>
reference = trumpet
source = covariant
fd_order = 4
validate_reference_cache = true
gamma0 = 1.0
diss = 0.0

<problem>
pgen_name = ref_gh_source_unit
puncture_exponent_gate = true
puncture_exponent_gate_strict = true
