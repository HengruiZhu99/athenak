# One forward-Euler step of additive ideal-GRMHD and real-scalar matter

<job>
basename = scalar_field_mhd_coupling

<mesh>
nghost = 2
nx1 = 4
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 4
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 4
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 4
nx2 = 4
nx3 = 4

<mesh_refinement>
refinement = none

<coord>
minkowski = true

<z4c>
spatial_order = 2
diss = 0.0
damp_kappa1 = 0.0
damp_kappa2 = 0.0
use_z4c = true
lapse_harmonicf = 0.0
lapse_harmonic = 0.0
lapse_oplog = 0.0
lapse_advect = 0.0
shift_Gamma = 0.0
shift_alpha2Gamma = 0.0
shift_H = 0.0
shift_advect = 0.0
shift_eta = 0.0

<mhd>
reconstruct = plm
rsolver = llf
gamma = 1.5
tfloor = 1.0e-10
dyn_eos = ideal
eos = ideal
dyn_error = reset_floor

<scalar_field>
field_type = real
potential = free
mass = 0.7
lambda = 0.0
backreaction = true
diss = 0.0
spatial_order = 2

<time>
evolution = dynamic
integrator = rk1
cfl_number = 0.1
nlim = 1
tlim = 1.0
ndiag = 1

<problem>
pgen_name = scalar_field_coupling
amplitude = 0.2
fluid_density = 1.25
fluid_pressure = 0.3
magnetic_x = 0.4
magnetic_y = -0.2
magnetic_z = 0.1
