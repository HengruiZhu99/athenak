# AthenaK Z4c-parity robust Minkowski stability test for vacuum FO-GH

<job>
basename = fo_gh_stability

<mesh>
nghost = 2
nx1 = 8
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.05
nlim = -1
tlim = 0.05
ndiag = 1

<mesh_refinement>
refinement = none

<refined_region1>
level = 1
x1min = 0.1
x1max = 0.4
x2min = -0.49
x2max = 0.49
x3min = -0.49
x3max = 0.49

<fo_gh>
fd_order = 2
kappa = 1.0
mu_H = 1.0
eta_H = 1.0
eta_beta = 2.0
diss = 0.02

<problem>
pgen_name = fo_gh_stability
user_hist = true
rho = 1.0

<output1>
file_type = hst
dt = 0.005
