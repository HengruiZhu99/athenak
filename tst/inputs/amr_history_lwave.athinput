# Small deterministic 2D Z4c AMR history record/replay integration fixture.

<job>
basename = amr_history_lwave

<mesh>
nghost = 2
nx1 = 16
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<mesh_refinement>
refinement = adaptive
max_nmb_per_rank = 512
num_levels = 3
ncycle_check = 1
refinement_interval = 1
amr_history_mode = off
amr_history_file = unused.jsonl

<amr_criterion0>
method = user

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.1
nlim = 4
tlim = 0.2
ndiag = 1

<z4c>
spatial_order = 2
diss = 0.02
user_Sbc = true

<problem>
pgen_name = z4c_linear_wave
amp = 1.0e-8
kx1 = 1
kx2 = 1
kx3 = 0

<output1>
file_type = bin
variable = z4c
dcycle = 1
id = state

<output2>
file_type = rst
dcycle = 2
