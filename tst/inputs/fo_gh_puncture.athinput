# AthenaK static regularized Schwarzschild puncture boundedness test

<job>
basename = fo_gh_puncture

<mesh>
nghost = 4
nx1 = 8
x1min = -2.0
x1max = 2.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = -2.0
x2max = 2.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = -2.0
x3max = 2.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<time>
evolution = static
cfl_number = 0.05

<fo_gh>
fd_order = 4
kappa = 1.0
mu_H = 1.0
eta_H = 1.0
eta_beta = 2.0
excise_lapse = 0.25
diss = 0.0

<problem>
pgen_name = fo_gh_puncture
mass = 1.0

<output1>
file_type = bin
variable = fo_gh
dt = 1.0

<output2>
file_type = bin
variable = adm
dt = 1.0

<output3>
file_type = bin
variable = fo_gh_con
dt = 1.0
