# Initialization-only half-plane regression for the Liu-Etienne-Shapiro Kerr puncture.

<job>
basename = z4c_kerr_half_plane_init

<mesh>
nghost = 4
nx1 = 32
x1min = 0.0
x1max = 8.0
ix1_bc = axis
ox1_bc = outflow
nx2 = 64
x2min = -8.0
x2max = 8.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 1

<mesh_refinement>
refinement = none

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.1
nlim = 1
tlim = 1.0e-4
ndiag = 1

<z4c>
symmetry = cartoon_so2
coordinate_map = half_rho_z_suppressed_y_v2
symmetry_schema = 2
spatial_order = 6
diss = 0.02
chi_div_floor = 1.0e-5
excise_chi = 0.0625
damp_kappa1 = 0.02
damp_kappa2 = 0.0
lapse_oplog = 2.0
lapse_harmonicf = 1.0
lapse_harmonic = 0.0
lapse_advect = 1.0
shift_Gamma = 0.0
shift_eta = 0.0
shift_advect = 0.0

<problem>
pgen_name = kerr_puncture
M = 1.0
chi = 0.5
z_h = 0.0
initial_gauge = precollapsed

<output1>
file_type = hst
dcycle = 1

<output2>
file_type = bin
variable = z4c
dcycle = 1
id = z4c

<output3>
file_type = bin
variable = con
dcycle = 1
id = con
