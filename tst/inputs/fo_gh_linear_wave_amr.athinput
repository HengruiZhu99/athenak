# AthenaK dynamic-regrid regression for compatible vacuum FO-GH gradients

<job>
basename = fo_gh_linear_wave_amr

<mesh>
nghost = 4
nx1 = 16
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.1
nlim = 2
tlim = 0.1
ndiag = 1

<mesh_refinement>
refinement = adaptive
num_levels = 2
max_nmb_per_rank = 64
refinement_interval = 1

<amr_criterion0>
method = location
location_x1 = 0.25
location_x2 = 0.25
location_x3 = 0.25
location_rad = 0.1

<fo_gh>
fd_order = 4
kappa = 1.0
mu_H = 1.0
eta_H = 1.0
eta_beta = 2.0
diss = 0.02

<problem>
pgen_name = fo_gh_linear_wave
amp = 1.0e-6
kx1 = 1.0
kx2 = 0.0
kx3 = 0.0
