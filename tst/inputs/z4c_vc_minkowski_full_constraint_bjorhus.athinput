# Bounded native-VC Cartoon smoke fixture for the default-off full-field
# constraint Bjorhus boundary RHS treatment.

<job>
basename = z4c_vc_minkowski_full_constraint_bjorhus

<mesh>
nghost = 4
nx1 = 32
x1min = 0.0
x1max = 4.0
ix1_bc = axis
ox1_bc = outflow
nx2 = 32
x2min = -2.0
x2max = 2.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 1

<mesh_refinement>
refinement = none

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.1
nlim = 3
tlim = 0.01
ndiag = 1

<z4c>
grid_centering = vertex
symmetry = cartoon_so2
coordinate_map = half_rho_z_suppressed_y_v2
symmetry_schema = 2
spatial_order = 6
diss = 0.02
chi_div_floor = 1.0e-5
damp_kappa1 = 0.0
damp_kappa2 = 0.0
history_constraint_radius = -1.0
lapse_oplog = 2.0
lapse_harmonicf = 1.0
lapse_harmonic = 0.0
lapse_advect = 1.0
shift_Gamma = 0.0
shift_eta = 0.0
shift_advect = 0.0
boundary_rhs = full_constraint_bjorhus

<problem>
pgen_name = z4c_vc_minkowski

<output1>
file_type = hst
dcycle = 1
