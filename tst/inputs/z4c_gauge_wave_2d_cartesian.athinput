# Analytic harmonic gauge wave for native CC/VC 2D Cartesian qualification.

<job>
basename = z4c_gauge_wave

<mesh>
nghost = 4
nx1 = 16
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 1

<mesh_refinement>
refinement = none
max_nmb_per_rank = 8

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.1
nlim = -1
tlim = 0.05
ndiag = 1

<z4c>
grid_centering = vertex
symmetry = cartesian3d
coordinate_map = cartesian_xyz
symmetry_schema = 1
spatial_order = 4
diss = 0.02
floor_chi = false
damp_kappa1 = 0.0
damp_kappa2 = 0.0
lapse_oplog = 0.0
lapse_harmonicf = 1.0
lapse_harmonic = 1.0
lapse_advect = 0.0
shift_mode = prescribed_zero
shift_Gamma = 0.0
shift_eta = 0.0
shift_advect = 0.0

<problem>
pgen_name = z4c_gauge_wave
amp = 1.0e-3

<output1>
file_type = hst
dcycle = 1
data_format = %24.16e

<output2>
file_type = bin
variable = adm
id = adm
dt = 0.05

<output3>
file_type = tab
variable = adm
id = line
slice_x2 = 0.0
data_format = %24.16e
dt = 0.05
