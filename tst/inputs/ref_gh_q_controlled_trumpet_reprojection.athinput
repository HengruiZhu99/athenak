# Actual Ref-GH state initialization of one exact physical stationary trumpet
# in a static mismatched q-controlled reference frame.

<job>
basename = ref_gh_q_controlled_trumpet_reprojection

<mesh>
nghost = 4
nx1 = 16
x1min = -2.0
x1max = 2.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 16
x2min = -2.0
x2max = 2.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 16
x3min = -2.0
x3max = 2.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.05
nlim = 0
tlim = 0.0
ndiag = 1

<ref_gh>
reference = trumpet_q_controlled
source = covariant
reference_mass = 1.0
q_gaussian_width = 3.0
q_initial = 0.9
q_controller_enabled = false
fd_order = 4
validate_reference_cache = true
gamma0 = 1.0
gamma2 = 1.0
gauge_driver_enabled = true
gauge_reference_subtraction = true
gauge_mu = 1.0
gauge_eta = 1.0
shift_nu = 0.75
shift_eta = 1.0
exclude_puncture_stencil_diagnostics = true
diss = 0.0

<problem>
pgen_name = ref_gh_stationary_trumpet
user_hist = true
stationary_rhs_convergence_mode = true
common_adm_history = true
common_adm_fd_order = 4
common_adm_exclude_puncture_stencils = true
common_adm_puncture_x = 0.0
common_adm_puncture_y = 0.0
common_adm_puncture_z = 0.0
stationary_region0_min = 0.125
stationary_region0_max = 0.25
stationary_region1_min = 0.25
stationary_region1_max = 0.375
stationary_region2_min = 0.375
stationary_region2_max = 0.5

<output1>
file_type = hst
dt = 0.005
data_format = %20.15e
