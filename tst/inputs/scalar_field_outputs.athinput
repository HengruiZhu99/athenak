# Direct, derived, and history outputs for a homogeneous complex scalar field

<job>
basename = scalar_field_outputs

<mesh>
nghost = 2
nx1 = 24
x1min = -1.0
x1max = 2.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 1
x2min = -0.5
x2max = 1.5
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -1.5
x3max = 2.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 1
nx3 = 1

<mesh_refinement>
refinement = none

<coord>
general_rel = true
minkowski = true

<adm>
dynamic = false

<scalar_field>
field_type = complex
potential = free
mass = 0.7
lambda = 0.0
backreaction = false
diss = 0.0
spatial_order = 2

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.4
nlim = -1
tlim = 0.6
ndiag = 1

<problem>
pgen_name = scalar_field_oscillator
test_case = complex_free
amplitude = 0.2

<output1>
file_type = tab
variable = sf_phi0
id = sf_phi0
data_format = %.16e
slice_x2 = 0.0
slice_x3 = 0.0
dt = 10.0

<output2>
file_type = tab
variable = sf_pi0
id = sf_pi0
data_format = %.16e
slice_x2 = 0.0
slice_x3 = 0.0
dt = 10.0

<output3>
file_type = tab
variable = sf_phi1
id = sf_phi1
data_format = %.16e
slice_x2 = 0.0
slice_x3 = 0.0
dt = 10.0

<output4>
file_type = tab
variable = sf_pi1
id = sf_pi1
data_format = %.16e
slice_x2 = 0.0
slice_x3 = 0.0
dt = 10.0

<output5>
file_type = tab
variable = sf
id = sf
data_format = %.16e
slice_x2 = 0.0
slice_x3 = 0.0
dt = 10.0

<output6>
file_type = tab
variable = sf_amplitude
id = sf_amplitude
data_format = %.16e
slice_x2 = 0.0
slice_x3 = 0.0
dt = 10.0

<output7>
file_type = tab
variable = sf_energy
id = sf_energy
data_format = %.16e
slice_x2 = 0.0
slice_x3 = 0.0
dt = 10.0

<output8>
file_type = tab
variable = sf_charge
id = sf_charge
data_format = %.16e
slice_x2 = 0.0
slice_x3 = 0.0
dt = 10.0

<output9>
file_type = hst
data_format = %.16e
dt = 10.0

# Disabled two-dimensional PDF template used to exercise scalar-only PDF output.
<output10>
file_type = pdf
variable = sf_phi0
variable_2 = sf_pi0
id = sf_pdf
bin_min = -0.25
bin_max = 0.25
nbin = 8
logscale = false
bin2_min = -0.25
bin2_max = 0.25
nbin2 = 8
logscale2 = false
mass_weighted = false
dt = 0.0
