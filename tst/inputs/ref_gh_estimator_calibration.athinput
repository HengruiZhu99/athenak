# Stationary-trumpet planted-exponent estimator calibration (T3).

<job>
basename = ref_gh_estimator_calibration

<mesh>
nghost = 4
nx1 = 32
x1min = -1.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 32
x2min = -1.0
x2max = 1.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 32
x3min = -1.0
x3max = 1.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<time>
evolution = static
start_time = 20.0
cfl_number = 0.05

<ref_gh>
reference = controlled_transition
source = covariant
reference_mass = 1.0
fd_order = 4
validate_reference_cache = false
controller_enabled = false
controller_delta_q = 0.0
controller_delta_p = 0.0
r_core0 = 0.30
tau_core = 1.5
kappa_core = 1.0
tau_transition = 4.0
r_fit_min = 0.15
r_fit_max = 0.40
regularization_outer_start = 0.50
regularization_outer_end = 0.60

<problem>
pgen_name = ref_gh_estimator_calibration
user_hist = false
