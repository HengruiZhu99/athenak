# AthenaK input for FO-GH linear gravitational-wave convergence

<job>
basename = fo_gh_linear_wave

<mesh>
nghost = 4
nx1 = 16
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.1
nlim = -1
tlim = 0.1
ndiag = 10

<mesh_refinement>
refinement = none

<refined_region1>
level = 1
x1min = 0.1
x1max = 0.4
x2min = 0.01
x2max = 0.99
x3min = 0.01
x3max = 0.99

<fo_gh>
fd_order = 4
kappa = 1.0
mu_H = 1.0
eta_H = 1.0
eta_beta = 2.0
diss = 0.02

<problem>
pgen_name = fo_gh_linear_wave
amp = 1.0e-8
kx1 = 1.0
kx2 = 0.0
kx3 = 0.0
