# AthenaK input for the PC-GH construction and ADM-conversion smoke test

<job>
basename = pc_gh_minkowski

<mesh>
nghost = 2
nx1 = 8
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 4
x2min = -1.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 4
x3min = -1.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 4
nx3 = 4

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.25
nlim = 0
tlim = 0.0
ndiag = 1

<pc_gh>
spatial_order = 2
gauge = harmonic
kappa = 0.0
dissipation = 0.0

<problem>
pgen_name = pc_gh_minkowski

<output1>
file_type = tab
variable = pcgh
dt = 1.0
slice_x2 = 0.0
slice_x3 = 0.0

<output2>
file_type = rst
dt = 1.0
