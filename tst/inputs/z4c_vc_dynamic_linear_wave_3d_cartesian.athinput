# Nonconstant native-VC carrier for deterministic 3D refine/derefine comparison.

<job>
basename = z4c_vc_dynamic_linear_wave

<mesh>
nghost = 4
nx1 = 16
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = -1.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = -1.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<mesh_refinement>
refinement = adaptive
max_nmb_per_rank = 128
num_levels = 2
ncycle_check = 1
refinement_interval = 1

<amr_criterion0>
method = user

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.1
nlim = -1
tlim = 0.08
ndiag = 1

<z4c>
grid_centering = vertex
symmetry = cartesian3d
coordinate_map = cartesian_xyz
symmetry_schema = 1
spatial_order = 4
diss = 0.02
floor_chi = false
damp_kappa1 = 0.0
damp_kappa2 = 0.0
lapse_oplog = 0.0
lapse_harmonic = 0.0
lapse_advect = 0.0
shift_mode = prescribed_zero
shift_Gamma = 0.0
shift_eta = 0.0
shift_advect = 0.0

<problem>
pgen_name = z4c_linear_wave
amp = 1.0e-4
kx1 = 0.5
kx2 = 0.5
kx3 = 0.5
write_period_error = false
exercise_deterministic_amr = true
amr_target_lx1 = 0
amr_target_lx2 = 1
amr_target_lx3 = 1
amr_refine_time = 0.01
amr_derefine_time = 0.024

<output1>
file_type = hst
dcycle = 1
data_format = %24.16e

<output2>
file_type = bin
variable = z4c
id = state
dt = 0.04

<output3>
file_type = tab
variable = z4c
id = line
slice_x2 = 0.25
slice_x3 = 0.25
data_format = %24.16e
dt = 0.04
