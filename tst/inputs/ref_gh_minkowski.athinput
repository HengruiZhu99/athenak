# Exact dynamic Minkowski smoke test for the 50-field reference-frame GH module.

<job>
basename = ref_gh_minkowski

<mesh>
nghost = 2
nx1 = 8
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.1
nlim = -1
tlim = 0.02
ndiag = 1

<ref_gh>
fd_order = 2
gamma0 = 1.0
diss = 0.0

<problem>
pgen_name = ref_gh_minkowski
