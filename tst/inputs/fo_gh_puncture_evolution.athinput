# AthenaK short regularized Schwarzschild puncture evolution smoke test

<job>
basename = fo_gh_puncture_evolution

<mesh>
nghost = 4
nx1 = 16
x1min = -4.0
x1max = 4.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 16
x2min = -4.0
x2max = 4.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 16
x3min = -4.0
x3max = 4.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.025
nlim = -1
tlim = 0.02
ndiag = 1

<fo_gh>
fd_order = 4
extrap_order = 2
kappa = 1.0
mu_H = 1.0
eta_H = 1.0
eta_beta = 2.0
diss = 0.02
excise_lapse = 0.25

<problem>
pgen_name = fo_gh_puncture
mass = 1.0

<output1>
file_type = hst
dt = 0.01
data_format = %20.15e
