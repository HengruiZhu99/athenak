# Homogeneous canonical scalar oscillator on a fixed Minkowski ADM background

<job>
basename = scalar_field_real_oscillator

<mesh>
nghost = 2
nx1 = 8
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 4
nx2 = 1
nx3 = 1

<mesh_refinement>
refinement = none

<coord>
general_rel = true
minkowski = true

<adm>
dynamic = false

<scalar_field>
field_type = real
potential = free
mass = 0.7
lambda = 0.0
backreaction = false
diss = 0.0
spatial_order = 2

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.4
nlim = -1
tlim = 1.1
ndiag = 1

<problem>
pgen_name = scalar_field_oscillator
test_case = real_free
amplitude = 0.2
initial_pi = 0.0
expansion_rate = 0.0

# Disabled output templates used by restart/output regression tests.  A non-positive
# interval prevents these blocks from changing the standalone oscillator tests.
<output1>
file_type = tab
variable = sf_phi0
id = sf_phi0
data_format = %.17e
slice_x2 = 0.0
slice_x3 = 0.0
dt = 0.0

<output2>
file_type = tab
variable = sf_pi0
id = sf_pi0
data_format = %.17e
slice_x2 = 0.0
slice_x3 = 0.0
dt = 0.0

<output3>
file_type = tab
variable = sf_phi1
id = sf_phi1
data_format = %.17e
slice_x2 = 0.0
slice_x3 = 0.0
dt = 0.0

<output4>
file_type = tab
variable = sf_pi1
id = sf_pi1
data_format = %.17e
slice_x2 = 0.0
slice_x3 = 0.0
dt = 0.0

<output5>
file_type = rst
single_file_per_rank = false
dt = 0.0
