# Deterministic native-VC 3D Cartesian refine/derefine lifecycle fixture.

<job>
basename = z4c_vc_minkowski_dynamic

<mesh>
nghost = 4
nx1 = 16
x1min = -2.0
x1max = 2.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 16
x2min = -2.0
x2max = 2.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 16
x3min = -2.0
x3max = 2.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<mesh_refinement>
refinement = adaptive
max_nmb_per_rank = 64
num_levels = 2
ncycle_check = 1
refinement_interval = 1
amr_history_mode = off
amr_history_file = unused.jsonl
amr_history_topology_only_centering_compatibility = none

<amr_criterion0>
method = user

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.1
nlim = 3
tlim = 1.0
ndiag = 1

<z4c>
grid_centering = vertex
symmetry = cartesian3d
coordinate_map = cartesian_xyz
symmetry_schema = 1
spatial_order = 6
diss = 0.02
chi_div_floor = 1.0e-5
damp_kappa1 = 0.0
damp_kappa2 = 0.0
lapse_oplog = 2.0
lapse_harmonicf = 1.0
lapse_harmonic = 0.0
lapse_advect = 1.0
shift_Gamma = 0.0
shift_eta = 0.0
shift_advect = 0.0

<problem>
pgen_name = z4c_vc_minkowski
exercise_dynamic_vc_amr = true
amr_target_lx1 = 0
amr_target_lx2 = 0
amr_target_lx3 = 0

<output1>
file_type = hst
dcycle = 1

<output2>
file_type = rst
dcycle = 1
