# Uniform one-dimensional Cartesian native-VC O4 convergence carrier.

<job>
basename = z4c_vc_linear_wave_o4

<mesh>
nghost = 4
nx1 = 64
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 4
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 64
nx2 = 4
nx3 = 4

<mesh_refinement>
refinement = none
num_levels = 1

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.15
nlim = -1
tlim = 1.0
ndiag = 16

<z4c>
grid_centering = vertex
symmetry = cartesian3d
coordinate_map = cartesian_xyz
symmetry_schema = 1
spatial_order = 4
diss = 0.02
floor_chi = false
damp_kappa1 = 0.0
damp_kappa2 = 0.0
lapse_oplog = 0.0
lapse_harmonic = 0.0
lapse_advect = 0.0
shift_Gamma = 0.0
shift_eta = 0.0
shift_advect = 0.0

<problem>
pgen_name = z4c_linear_wave
amp = 1.0e-4
kx1 = 1.0
kx2 = 0.0
kx3 = 0.0

<output1>
file_type = hst
dcycle = 0

<output2>
file_type = tab
variable = z4c
slice_x2 = 0.0
slice_x3 = 0.0
data_format = %24.16e
dt = 1.0
