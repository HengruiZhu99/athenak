#!/bin/bash -l
#PBS -A CompactBinaryMerger
#PBS -N hybrid-science
#PBS -q debug
#PBS -l select=2
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -j oe
set -euo pipefail
ulimit -c 0
root=/lus/flare/projects/CompactBinaryMerger/hzhu/hybrid-overlap-20261111
[[ ${HYBRID_N:-} == 12 || ${HYBRID_N:-} == 16 ]]
[[ ${HYBRID_MODE:-} == legacy || ${HYBRID_MODE:-} == masked || ${HYBRID_MODE:-} == agreement ]]
case_name=N${HYBRID_N}-${HYBRID_MODE}
[[ ${HYBRID_PREVIOUS_JOB:-} =~ ^[0-9]+$ ]]
previous=$root/science/$case_name/segment-$HYBRID_PREVIOUS_JOB/segment-result.json
restart=$(/usr/bin/python3.11 - "$previous" <<'PYRESTART'
import hashlib,json,sys
from pathlib import Path
result=json.loads(Path(sys.argv[1]).read_text())
if result['complete']:
    print('COMPLETE')
else:
    path=Path(result['last_checkpoint'])
    digest=hashlib.sha256()
    with path.open('rb') as f:
        for block in iter(lambda:f.read(8*1024*1024),b''):digest.update(block)
    assert digest.hexdigest()==result['last_checkpoint_sha256']
    print(path)
PYRESTART
)
if [[ $restart == COMPLETE ]]; then
  echo 'This isolated case already reached its fixed cycle limit; no evolution requested.'
  exit 0
fi
export HYBRID_RESTART="$restart"
run=$root/science/$case_name/segment-${PBS_JOBID%%.*}
[[ ! -e "$run" && -r ${PBS_NODEFILE:-} ]]
[[ $(sort -u "$PBS_NODEFILE" | wc -l) == 2 ]]
module load oneapi/release/2025.3.1
mkdir -p "$run/cache/neo" "$run/cache/sycl"
cp "$PBS_NODEFILE" "$run/nodes.txt"
cp "$root/science-inputs/$case_name.athinput" "$run/input.athinput"
cp "$root/hybrid-science-continue-two.pbs" "$run/hybrid-science-two.pbs"
cp "$root/hybrid_rank_environment.py" "$run/"
module list > "$run/modules.txt" 2>&1
export OMP_NUM_THREADS=1 ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export ZE_ENABLE_PCI_ID_DEVICE_ORDER=1 ONEAPI_DEVICE_SELECTOR=level_zero:gpu MPIR_CVAR_ENABLE_GPU=1
source "$root/candidate-source-v1/tst/z4c_hyperboloidal/aurora/mpi-gpu-cache.sh"
export NEO_CACHE_DIR="$run/cache/neo" SYCL_CACHE_DIR="$run/cache/sycl"
unset ZE_AFFINITY_MASK NATIVE_TIMING_WARMUP NATIVE_TIMING_STEPS NATIVE_TIMING_WINDOWS
binding='1-8:9-16:17-24:25-32:33-40:41-48:53-60:61-68:69-76:77-84:85-92:93-100'
wrapper=$(command -v gpu_tile_compact.sh)
mpiexec -n 24 -ppn 12 --cpu-bind=list:"$binding" "$wrapper" /usr/bin/python3.11 \
 "$root/hybrid_rank_environment.py" > "$run/rank-environment.txt"
restart_args=()
if [[ -n ${HYBRID_RESTART:-} ]]; then restart_args=(--restart "$HYBRID_RESTART"); fi
/usr/bin/python3.11 "$root/hybrid_science_segment_v4.py" --root "$root" --run "$run" --wrapper "$wrapper" --binding "$binding" --n "$HYBRID_N" --mode "$HYBRID_MODE" "${restart_args[@]}"
