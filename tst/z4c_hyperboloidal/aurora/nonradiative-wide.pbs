#!/bin/bash -l
#PBS -A CompactBinaryMerger
#PBS -N nonradiative-wide
#PBS -q debug
#PBS -l select=2
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -j oe
set -euo pipefail
ulimit -c 0
root=/lus/flare/projects/CompactBinaryMerger/hzhu/nonradiative-followup-20261115
source_root=$root/${SOURCE_SNAPSHOT:-source}
[[ ${SOURCE_SNAPSHOT:-source} =~ ^source(-v[0-9]+)?$ ]]
[[ -r ${PBS_NODEFILE:-} && $(sort -u "$PBS_NODEFILE" | wc -l) == 2 ]]
[[ ${RESOLUTION:-} =~ ^(12|16|20)$ ]]
run=$root/runs/N${RESOLUTION}-${PBS_JOBID%%.*}
mkdir -p "$run/cache/neo" "$run/cache/sycl"
cp "$PBS_NODEFILE" "$run/nodes.txt"
cp "$source_root/tst/z4c_hyperboloidal/aurora/nonradiative-wide.pbs" "$run/launcher.pbs"
module load oneapi/release/2025.3.1
module list > "$run/modules.txt" 2>&1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE ZE_ENABLE_PCI_ID_DEVICE_ORDER=1
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu MPIR_CVAR_ENABLE_GPU=1
source "$root/source/tst/z4c_hyperboloidal/aurora/mpi-gpu-cache.sh"
export NEO_CACHE_DIR="$run/cache/neo" SYCL_CACHE_DIR="$run/cache/sycl"
unset ZE_AFFINITY_MASK NATIVE_TIMING_WARMUP NATIVE_TIMING_STEPS NATIVE_TIMING_WINDOWS
export NONRAD_BINDING='1-8:9-16:17-24:25-32:33-40:41-48:53-60:61-68:69-76:77-84:85-92:93-100'
export NONRAD_WRAPPER=$(command -v gpu_tile_compact.sh)
python=$root/../n12-full-scri-20261115/analysis-env/bin/python
set +e
"$python" "$source_root/tst/z4c_hyperboloidal/nonradiative_wide.py" evolve "$root" "$run" "$RESOLUTION" > "$run/evolution.log" 2>&1
status=$?
printf '%s\n' "$status" > "$run/evolution-exit.txt"
if [[ $status == 0 ]]; then
  mpiexec -n 2 -ppn 1 "$python" "$source_root/tst/z4c_hyperboloidal/nonradiative_wide.py" analyze "$root" "$run" "$RESOLUTION" > "$run/analysis.log" 2>&1
  status=$?
fi
printf '%s\n' "$status" > "$run/exit-code.txt"
exit "$status"
