#!/bin/bash -l
#PBS -A CompactBinaryMerger
#PBS -N scri-pulse-seeds
#PBS -q debug
#PBS -l select=2
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -j oe
set -euo pipefail
ulimit -c 0
root=/lus/flare/projects/CompactBinaryMerger/hzhu/scri-regularity-20261110
out=$root/pulse-seeds-gpu-v1
[[ ! -e "$out" && -x "$root/pulse-writer-v1/scri_pulse" ]]
[[ -r ${PBS_NODEFILE:-} && $(sort -u "$PBS_NODEFILE" | wc -l) == 2 ]]
mkdir -p "$out/cache/neo" "$out/cache/sycl"
trap 'status=$?; printf "%s\n" "$status" > "$out/exit-code.txt"' EXIT
cp "$PBS_NODEFILE" "$out/nodes.txt"
cp "$root/prepare-scri-pulses-two.pbs" "$out/"
module load oneapi/release/2025.3.1
module list > "$out/modules.txt" 2>&1
export OMP_NUM_THREADS=1 ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export ZE_ENABLE_PCI_ID_DEVICE_ORDER=1 ONEAPI_DEVICE_SELECTOR=level_zero:gpu MPIR_CVAR_ENABLE_GPU=1
source "$root/mpi-gpu-cache.sh"
export NEO_CACHE_DIR="$out/cache/neo" SYCL_CACHE_DIR="$out/cache/sycl"
unset ZE_AFFINITY_MASK NATIVE_TIMING_WARMUP NATIVE_TIMING_STEPS NATIVE_TIMING_WINDOWS
export PULSE_MPI_BINDING='1-8:9-16:17-24:25-32:33-40:41-48:53-60:61-68:69-76:77-84:85-92:93-100'
export PULSE_GPU_WRAPPER=$(command -v gpu_tile_compact.sh)
sha256sum -c "$root/pulse-writer-v1/executable.sha256" > "$out/writer-check.txt"
sha256sum -c "$root/build-v1/executable.sha256" > "$out/production-check.txt"
mpiexec -n 24 -ppn 12 --cpu-bind=list:"$PULSE_MPI_BINDING" "$PULSE_GPU_WRAPPER" /bin/bash -c \
 'printf "%s rank=%s tile=%s cache=%s size=%s entries=%s\n" "$(hostname)" "${MPI_LOCALRANKID:-${PALS_LOCAL_RANKID:-unknown}}" "$ZE_AFFINITY_MASK" "$MPIR_CVAR_CH4_IPC_GPU_HANDLE_CACHE" "$MPIR_CVAR_CH4_IPC_GPU_CACHE_SIZE" "$MPIR_CVAR_CH4_IPC_GPU_MAX_CACHE_ENTRIES"' > "$out/rank-environment.txt"
python3 "$root/prepare_scri_pulses_aurora.py" "$root" > "$out/generation.log" 2>&1
sha256sum -c "$root/build-v1/executable.sha256" >> "$out/production-check.txt"
