# Bounded four-cycle binary evolution with native chi-minimum AMR.
# First export this same initial mesh with binary_initialize.athinput.
# Set problem/binary_directory and binary_identity to the verified export.
# chi_min is ordinary isotropic chi; the adapter applies scale^2/Omega^2.
# Preserve initial orbital refinement by disabling coarsening for this short test.
# a=.30 covers centers |x|=.202337 plus the intended orbital region;
# b=.55 is below the resolved flat-Omega radius .6402906611935943.
<job>
basename = native_binary
<mesh>
nghost = 4
nx1 = 36
nx2 = 36
nx3 = 36
x1min = -.3
x1max = .3
x2min = -.3
x2max = .3
x3min = -.3
x3max = .3
ix1_bc = mapped
ox1_bc = mapped
ix2_bc = mapped
ox2_bc = mapped
ix3_bc = mapped
ox3_bc = mapped
<meshblock>
nx1 = 12
nx2 = 12
nx3 = 12
<mesh_atlas>
type = cubed_sphere
spherical_inner_radius = .28
shell_radii = .40,.48,.56,.64,.72,.80,.88,.94,1
evolved_overlap = 3
outer_endpoint_grid = true
<mesh_refinement>
refinement = adaptive
num_levels = 6
max_nmb_per_rank = 450
refinement_interval = 0
ncycle_check = 1
# Resolve the entire orbital region, then both displaced horizons.
<refined_region0>
x1min = -.25
x1max = .25
x2min = -.25
x2max = .25
x3min = -.04
x3max = .04
level = 1
<refined_region1>
x1min = .18
x1max = .225
x2min = -.025
x2max = .025
x3min = -.025
x3max = .025
level = 4
<refined_region2>
x1min = -.225
x1max = -.18
x2min = -.025
x2max = .025
x3min = -.025
x3max = .025
level = 4
<time>
cfl_number = .2
evolution = dynamic
integrator = rk4_classical
nlim = 4
tlim = 1
ndiag = 1
dt = 0.0005208333333333333
<problem>
pgen_name = z4c_hyperboloidal_binary
binary_prepare = false
binary_directory = binary-data
binary_identity = 6a2dcfc395c6a466ac5688b4fb6763a3040e5fcf2eca893500d95dfa208defc0
<z4c_hyperboloidal>
residual_weight = regular_c6
weight_inner = .30
weight_outer = .55
inner_z4c_radius_M = 20
compact_slicing_end = .97
outer_lapse_damping = .25
ko = .3
chi_floor = 1e-10
floor_inner_amr_chi = true
scri_penalty = .5

<fastflow>
lmax = 12
ntheta = 24
center_x_0 = 0.20233727083953934
center_x_1 = -0.20233727083953934
center_y_0 = 0
center_z_0 = 0
center_y_1 = 0
center_z_1 = 0
initial_radius_0 = .009
initial_radius_1 = .009

<amr_criterion0>
method = user
<z4c_amr>
method = chi
chi_min = .05
max_ref_lev = 5
allow_coarsening = false
<output1>
file_type = hst
dcycle = 1
