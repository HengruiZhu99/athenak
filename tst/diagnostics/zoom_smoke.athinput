# Matched hydro Michel control / circular binary. G=M_total=c=1.
# Generated companion files use the same gas; hierarchy follows the horizons.
<job>
basename = matched_bondi
<mesh>
nghost = 4
nx1 = 16
nx2 = 16
nx3 = 16
x1min = -8
x1max = 8
x2min = -8
x2max = 8
x3min = -8
x3max = 8
ix1_bc = user
ox1_bc = user
ix2_bc = user
ox2_bc = user
ix3_bc = user
ox3_bc = user
<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8
<mesh_refinement>
refinement = adaptive
num_levels = 2
max_nmb_per_rank = 128
ncycle_check = 1
refinement_interval = 1
<refined_region1>
level = 1
x1min = -1
x1max = 1
x2min = -1
x2max = 1
x3min = -1
x3max = 1
<amr_criterion1>
method = cyclic_zoom
nlevels = 2
ncenters = 1
r_0 = 1
f_ref = 2
f_exc = 0
trun_fac = 0.15
trun_pow = 0
<cyclic_zoom>
verbose = true
max_nzmb_per_dvce = 128
max_nzmb_per_host = 128
<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.25
nlim = 12
tlim = 1
ndiag = 100
<coord>
general_rel = true
a = 0
excise = true
excision_scheme = puncture
excise_1_rad = 0.8
excise_2_rad = 0.8
dexcise = 1e-8
pexcise = 1e-12
require_resolved_horizon = false
<mhd>
dyn_flux_team_size = 0
eos = ideal
dyn_eos = ideal
dyn_error = reset_floor
reconstruct = ppm4
rsolver = hlle
gamma = 1.6666666666666667
dfloor = 1e-10
pfloor = 1e-14
tfloor = 1e-12
fofc = true
gamma_max = 10
enforce_maximum = false
calculate_tmunu = false
<adm>
dynamic = false
<problem>
flux_diagnostics = true
flux_new_epoch = false
flux_modeled_horizons = true
flux_ntheta = 8
flux_nphi = 16
flux_rsurf_inner = 3.5
flux_rsurf_outer = 4
flux_dr_surf = 0.5
flux_horizon1 = true
flux_radius1 = 3
flux_min_cells_per_radius = 1

initial_condition = bondi_inflow
# Optional initial cavity only; exterior feeding remains the Michel solution.
bondi_cavity_radius = 0
bondi_cavity_fraction = 0
bondi_cavity_core_fraction = 0
bondi_cache_boundary = true
single_black_hole = true
corotating = true
sep = 32
q = 1
frame_omega = 0.005524271728019903
a1 = 0
a2 = 0
r_crit = 8
k_adi = 1
b_inf = 0
metric_derivative = ad
user_hist = true
<output1>
file_type = hst
data_format = %24.16e
dcycle = 1
<output2>
file_type = rst
dcycle = 2
