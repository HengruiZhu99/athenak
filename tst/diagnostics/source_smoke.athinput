# Matched hydro Michel control / circular binary. G=M_total=c=1.
# Generated companion files use the same gas; hierarchy follows the horizons.
<job>
basename = matched_bondi
<mesh>
nghost = 4
nx1 = 16
nx2 = 16
nx3 = 16
x1min = -8
x1max = 8
x2min = -8
x2max = 8
x3min = -8
x3max = 8
ix1_bc = user
ox1_bc = user
ix2_bc = user
ox2_bc = user
ix3_bc = user
ox3_bc = user
<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8
<time>
evolution = dynamic
integrator = rk1
cfl_number = 0.25
nlim = 1
tlim = 0.00001
ndiag = 100
<coord>
general_rel = true
a = 0
excise = true
excision_scheme = puncture
excise_1_rad = 0.4
excise_2_rad = 0.4
dexcise = 1e-8
pexcise = 1e-12
require_resolved_horizon = false
<mhd>
dyn_flux_team_size = 0
eos = ideal
dyn_eos = ideal
dyn_error = reset_floor
reconstruct = ppm4
rsolver = hlle
gamma = 1.6666666666666667
dfloor = 1e-10
pfloor = 1e-14
tfloor = 1e-12
fofc = true
gamma_max = 10
enforce_maximum = false
calculate_tmunu = false
<adm>
dynamic = false
<problem>
flux_horizon2=true
flux_radius2=1.2
flux_diagnostics = true
flux_new_epoch = false
flux_budget = true
budget_r_inner = 3.5
budget_r_outer = 4
budget_subcells = 2

flux_modeled_horizons = false
flux_ntheta = 8
flux_nphi = 16
flux_rsurf_inner = 3.5
flux_rsurf_outer = 4
flux_dr_surf = 0.5
flux_horizon1 = true
flux_radius1 = 1.2
flux_min_cells_per_radius = 1

initial_condition = bondi_inflow
# Optional initial cavity only; exterior feeding remains the Michel solution.
bondi_cavity_radius = 0
bondi_cavity_fraction = 0
bondi_cavity_core_fraction = 0
bondi_cache_boundary = true
single_black_hole = false
corotating = true
sep = 4
q = 1
frame_omega = 0.125
a1 = 0
a2 = 0
r_crit = 8
k_adi = 1
b_inf = 0
metric_derivative = ad
user_hist = true
<output1>
file_type = hst
data_format = %24.16e
dcycle = 1
<output2>
file_type = rst
dcycle = 2

<mhd_srcterms>
const_accel=true
const_accel_dir=2
const_accel_val=0.2
<output3>
file_type=bin
variable=mhd_w
dt=1
data_format=%24.16e
