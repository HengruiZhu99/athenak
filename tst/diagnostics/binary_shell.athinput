# Matched hydro Michel control / circular binary. G=M_total=c=1.
# Generated companion files use the same gas; hierarchy follows the horizons.
<job>
basename = matched_bondi
<mesh>
nghost = 4
nx1 = 48
nx2 = 48
nx3 = 48
x1min = -5
x1max = 5
x2min = -5
x2max = 5
x3min = -5
x3max = 5
ix1_bc = user
ox1_bc = user
ix2_bc = user
ox2_bc = user
ix3_bc = user
ox3_bc = user
<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16
<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.0001
nlim = 2
tlim = 1
ndiag = 100
<coord>
general_rel = true
a = 0
excise = true
excision_scheme = puncture
excise_1_rad = 0.12
excise_2_rad = 0.12
dexcise = 1e-8
pexcise = 1e-12
require_resolved_horizon = false
<mhd>
dyn_flux_team_size = 0
eos = ideal
dyn_eos = ideal
dyn_error = reset_floor
reconstruct = ppm4
rsolver = hlle
gamma = 1.6666666666666667
dfloor = 1e-10
pfloor = 1e-14
tfloor = 1e-12
fofc = true
gamma_max = 10
enforce_maximum = false
calculate_tmunu = false
<adm>
dynamic = true
<problem>
flux_diagnostics = true
flux_new_epoch = false
flux_modeled_horizons = true
flux_ntheta = 24
flux_nphi = 48
flux_rsurf_inner = 3.75
flux_rsurf_outer = 4.75
flux_dr_surf = 0.5
flux_horizon1 = false
flux_radius1 = 3
flux_min_cells_per_radius = 3
flux_shell_budget = true
shell_subcells = 8
flux_ks_radius1 = 1.4
flux_ks_radius2 = 1.2

initial_condition = bondi_inflow
# Optional initial cavity only; exterior feeding remains the Michel solution.
bondi_cavity_radius = 0
bondi_cavity_fraction = 0
bondi_cavity_core_fraction = 0
bondi_cache_boundary = true
single_black_hole = false
corotating = true
sep = 4
q = 0.75
frame_omega = 0.125
a1 = 0.3
a2 = 0.2
r_crit = 8
k_adi = 1
b_inf = 0
metric_derivative = ad
user_hist = true
<output1>
file_type = hst
data_format = %24.16e
dcycle = 1
<output2>
file_type = rst
dcycle = 2
