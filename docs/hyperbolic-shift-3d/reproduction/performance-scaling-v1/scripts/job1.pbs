#!/bin/bash -l
#PBS -N hyp-perf-v1
#PBS -A CompactBinaryMerger
#PBS -q debug
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -l filesystems=home
#PBS -j oe
set -euo pipefail
ulimit -c 0
cd /home/hzhu/hyperboloidal-performance-scaling-20261103
module load oneapi/release/2025.3.1
export OMP_NUM_THREADS=1 ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE ZE_ENABLE_PCI_ID_DEVICE_ORDER=1
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu MPIR_CVAR_ENABLE_GPU=1
export NEO_CACHE_DIR="$PWD/runtime-cache/neo" SYCL_CACHE_DIR="$PWD/runtime-cache/sycl"
mkdir -p "$NEO_CACHE_DIR" "$SYCL_CACHE_DIR" job1-components
unset ZE_AFFINITY_MASK
module list > job1-components/modules.txt 2>&1
cat "$PBS_NODEFILE" > job1-components/nodes.txt
lscpu > job1-components/lscpu.txt
export HYPERBOLIC_MAPPING_PREFIX="$PWD/job1-components/mapping"
timeout 180 mpiexec -n 12 -ppn 12 --cpu-bind=list:1-8:9-16:17-24:25-32:33-40:41-48:53-60:61-68:69-76:77-84:85-92:93-100 gpu_tile_compact.sh m1-build/tst/hyperbolic_shift_3d/hyperbolic_shift_3d_amr_device_mapping > job1-components/mapping.log 2>&1
for p in 1 2 4; do
 case "$p" in 1) bind="1-8";; 2) bind="1-8:9-16";; 4) bind="1-8:9-16:17-24:25-32";; esac
 timeout 180 mpiexec -n "$p" -ppn "$p" "--cpu-bind=list:$bind" gpu_tile_compact.sh control-build-v2/tst/hyperbolic_shift_3d/hyperbolic_shift_3d_amr_transfer 12 > "job1-components/transfer-$p.log" 2>&1
done
timeout 180 mpiexec -n 4 -ppn 4 --cpu-bind=list:1-8:9-16:17-24:25-32 gpu_tile_compact.sh m1b-bin/hyperbolic_shift_3d_radial_field_batch > job1-components/radial-mask.log 2>&1
timeout 180 mpiexec -n 4 -ppn 4 --cpu-bind=list:1-8:9-16:17-24:25-32 gpu_tile_compact.sh m1-build/tst/hyperbolic_shift_3d/hyperbolic_shift_3d_owned_padded_snapshot > job1-components/diagnostic-transfer.log 2>&1
lfs quota -u hzhu /home > job1-components/quota-before.txt
exec /usr/bin/python3.11 run_plan.py gpu-plan1.json gpu-job1
