+// Copyright(C) 2026 AthenaK contributors. BSD-3-Clause; see LICENSE.
+#ifndef Z4C_HYPERBOLOIDAL_FIXED_STEP_ADMISSION_HPP_
+#define Z4C_HYPERBOLOIDAL_FIXED_STEP_ADMISSION_HPP_
+#include "z4c_hyperboloidal/surface_exchange.hpp"
+
+namespace z4c_hyperboloidal {
+namespace fixed_step_admission {
+struct Summary {Real probe_cfl=0;int invalid=0;};
+struct Evaluate {
+  using value_type=Summary;
+  DvceArray1D<BlockPoint> points;
+  DvceArray1D<mapped::Point> geometry;
+  DvceArray1D<CartesianChartJets> reference;
+  DvceArray5D<Real> residual;
+  SurfaceExchange::Kernel surface;
+  HyperbolicShiftParameters<Real> parameters;
+  int n;
+  KOKKOS_INLINE_FUNCTION void init(value_type &out) const {out={};}
+  KOKKOS_INLINE_FUNCTION void join(value_type &a,const value_type &b) const {
+    a.probe_cfl=fmax(a.probe_cfl,b.probe_cfl);a.invalid+=b.invalid;
+  }
+  KOKKOS_INLINE_FUNCTION void operator()(int p,value_type &out) const {
+    const auto c=points(p);const auto map=geometry(p);CartesianChartJets jets{};
+    const Real r=SphericalPolicy::Radius(map.x);
+    if (!(r>0 && Kokkos::isfinite(r))) {++out.invalid;return;}
+    for (int f=0;f<Fields::count;++f) if (Fields::Independent(f))
+      jets[f].f=residual(c.m,f,c.k,c.j,c.i);
+    // Endpoint derivative reconstruction keeps the central field value. Only
+    // the already solved shift-normal lift can alter its characteristic value.
+    if (!SphericalPolicy::Restore(map.x,jets,reference(p))) {++out.invalid;return;}
+    if (surface.HasRadialRow(p)) for (int a=0;a<3;++a)
+      jets[22+a].f+=surface.NormalCorrection(p,map,a).f;
+    const auto u=SphericalPolicy::Physical(map.x,jets);
+    if (!(u.chi.value>0 && u.alpha.value>0 && Kokkos::isfinite(u.chi.value)
+          && Kokkos::isfinite(u.alpha.value))) {++out.invalid;return;}
+    for (int a=0;a<3;++a) {
+      if (!Kokkos::isfinite(u.beta.value[a])) {++out.invalid;return;}
+      for (int b=0;b<3;++b) if (!Kokkos::isfinite(u.metric.g[a][b])
+          || !Kokkos::isfinite(map.J[a][b])) {++out.invalid;return;}
+    }
+    // Identical determinant/cofactor arithmetic to Geometry, without any
+    // connection, curvature, derivative, gauge RHS or dissipation calculation.
+    const auto &g=u.metric.g;
+    const Real det=g[0][0]*(g[1][1]*g[2][2]-g[1][2]*g[2][1])
+        -g[0][1]*(g[1][0]*g[2][2]-g[1][2]*g[2][0])
+        +g[0][2]*(g[1][0]*g[2][1]-g[1][1]*g[2][0]);
+    if (!(Kokkos::isfinite(det)&&det>0&&g[0][0]>0&&
+          g[0][0]*g[1][1]-g[0][1]*g[1][0]>0)) {++out.invalid;return;}
+    Real inverse[3][3];
+    for (int i=0;i<3;++i) {const int p=(i+1)%3,q=(i+2)%3;
+      for (int j=0;j<3;++j) {const int r=(j+1)%3,s=(j+2)%3;
+        inverse[j][i]=(g[p][r]*g[q][s]-g[p][s]*g[q][r])/det;
+      }
+    }
+    const auto coefficient=ShiftCoefficients(r,u.alpha.value,u.chi.value,parameters);
+    const auto omega=parameters.profile.At(map.x);
+    Real characteristic_chi=u.chi.value;
+    if (parameters.cartesian_chi_guard)
+      characteristic_chi+=coefficient.inner*(fmax(characteristic_chi,
+          parameters.inner_chi_guard/(omega.omega*omega.omega))-characteristic_chi);
+    Real speed=0;
+    for (int A=0;A<3;++A) {
+      Real transport=0,Q=0,E=0;
+      for (int a=0;a<3;++a) {
+        transport+=map.J[A][a]*u.beta.value[a];E+=map.J[A][a]*map.J[A][a];
+        for (int b=0;b<3;++b)Q+=inverse[a][b]*map.J[A][a]*map.J[A][b];
+      }
+      if (!(Q>0 && E>0 && Kokkos::isfinite(Q) && Kokkos::isfinite(E)
+            && Kokkos::isfinite(transport))) {++out.invalid;return;}
+      const Real shift2=GaugeShiftSpeedSquared(coefficient,Q);
+      const Real lapse2=GaugeLapseSpeedSquared(u.alpha.value,characteristic_chi,
+                                              coefficient,Q,E,parameters);
+      // fmax can hide a NaN in one branch, so validate each component first.
+      if (!(shift2>=0 && lapse2>=0 && Kokkos::isfinite(shift2)
+            && Kokkos::isfinite(lapse2))) {++out.invalid;return;}
+      Real speed2=fmax(shift2,lapse2);
+      if (parameters.enforce_cfl) {
+        const Real physical2=u.alpha.value*u.alpha.value*characteristic_chi*Q;
+        if (!(physical2>=0 && Kokkos::isfinite(physical2))) {++out.invalid;return;}
+        speed2=fmax(speed2,physical2);
+      }
+      speed+=fabs(transport)+sqrt(speed2);
+    }
+    if (!(speed>0&&Kokkos::isfinite(speed))) {++out.invalid;return;}
+    // Preserve the available predecessor probe's multiplication and division
+    // order rather than changing a threshold by silently cancelling probe.
+    out.probe_cfl=fmax(out.probe_cfl,Real(1e-8)*n*speed);
+  }
+};
+}  // namespace fixed_step_admission
+}  // namespace z4c_hyperboloidal
+#endif
