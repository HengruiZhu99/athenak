+void Z4cHyperboloidal::CheckFixedStepAdmission(bool continuing) {
+  auto &mesh=*pmy_pack->pmesh;
+  if (!mesh.adaptive) return;  // Pinned fixed-SMR policy is unchanged.
+  const Real target=continuing ? Real(.4) : mesh.cfl_no;
+  int invalid=(!initialized_ || !plans_ready_ || !std::isfinite(target) || target<=0
+               || !std::isfinite(requested_dt) || requested_dt<=0) ? 1 : 0;
+#if MPI_PARALLEL_ENABLED
+  MPI_Allreduce(MPI_IN_PLACE,&invalid,1,MPI_INT,MPI_MAX,MPI_COMM_WORLD);
+#endif
+  if (invalid)
+    throw std::runtime_error("Adaptive fixed-step admission needs valid policy and prepared state");
+  fixed_step_admission::Summary summary;
+  fixed_step_admission::Evaluate evaluate{points.d_view,geometry,reference,residual,
+      surface_exchange_->BindKernel(),parameters,n[0]};
+  Kokkos::parallel_reduce("adaptive fixed-step characteristic admission",
+      Kokkos::RangePolicy<>(0,npoints),evaluate,summary);
+#if MPI_PARALLEL_ENABLED
+  MPI_Allreduce(MPI_IN_PLACE,&summary.invalid,1,MPI_INT,MPI_SUM,MPI_COMM_WORLD);
+  MPI_Allreduce(MPI_IN_PLACE,&summary.probe_cfl,1,MPI_ATHENA_REAL,MPI_MAX,MPI_COMM_WORLD);
+#endif
+  if (summary.invalid || !(summary.probe_cfl>0 && std::isfinite(summary.probe_cfl)))
+    throw std::runtime_error("Invalid adaptive characteristic admission state");
+  const Real rate=summary.probe_cfl/Real(1e-8);
+  const Real allowed=std::min({requested_dt,target/rate,Real(.005)});
+  // Optional angular dissipation is absent from this native formulation. Its
+  // predecessor cap must be added if that independent operator is introduced.
+  if (requested_dt>allowed*(1+1e-12))
+    throw std::runtime_error("Adaptive fixed timestep exceeds current characteristic bound");
+}
