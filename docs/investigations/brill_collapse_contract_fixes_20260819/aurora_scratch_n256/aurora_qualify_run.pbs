#!/bin/bash -l
#PBS -N brill-n256-run
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -q debug
#PBS -k doe
#PBS -j oe
set -euo pipefail
: "${ATHENAK_ROOT:?}"
: "${BUILD_PHASE_ROOT:?}"
: "${INPUT_ROOT:?}"
: "${AURORA_RUN_ROOT:?}"
test ! -e "${AURORA_RUN_ROOT}"
grep -Fx 'AURORA_N256_SCRATCH_HEAD_BUILD_PASS' "${BUILD_PHASE_ROOT}/status" >/dev/null
test -x "${BUILD_PHASE_ROOT}/athena-build/src/athena"
test "$(sha256sum "${INPUT_ROOT}/n256_scratch.athinput" | awk '{print $1}')" = 570de812a89c6fca778175485479dd0257b2018bc441a07b1476d6fe30e20c84
test "$(sha256sum "${INPUT_ROOT}/brill_global_48x32.coefficients" | awk '{print $1}')" = ff0993c390513c15d6aa65857a0a3c710f2e2c3faf5717d9d63245203ccf2d6b
mkdir -p "${AURORA_RUN_ROOT}"
run_root="$(cd "${AURORA_RUN_ROOT}" && pwd)"
module purge
module load oneapi/release/2025.3.1 gcc/13.4.0 cmake/3.31.11 python/3.12.12
export OMP_NUM_THREADS=1 KOKKOS_NUM_THREADS=1
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE ZE_AFFINITY_MASK=0.0
cp "${INPUT_ROOT}/n256_scratch.athinput" "${INPUT_ROOT}/brill_global_48x32.coefficients" "${run_root}/"
{
  date --iso-8601=seconds
  hostname
  printf 'PBS_JOBID=%s\n' "${PBS_JOBID:-unknown}"
  git -C "${ATHENAK_ROOT}" rev-parse HEAD HEAD^{tree}
  test -z "$(git -C "${ATHENAK_ROOT}" status --porcelain)"
  module list
  sycl-ls
  env | LC_ALL=C sort | grep -E '^(ONEAPI|ZE_|OMP_|KOKKOS_)'
  sha256sum "${BUILD_PHASE_ROOT}/athena-build/src/athena" "${run_root}/n256_scratch.athinput" "${run_root}/brill_global_48x32.coefficients"
} > "${run_root}/provenance.log" 2>&1
"${BUILD_PHASE_ROOT}/athena-build/athena_z4c_state_admissibility_unit_test" > "${run_root}/state-test.log" 2>&1
"${BUILD_PHASE_ROOT}/athena-build/athena_z4c_amr_jump_diagnostic_unit_test" > "${run_root}/jump-test.log" 2>&1
"${BUILD_PHASE_ROOT}/athena-build/athena_z4c_cartoon_amr_transfer_qualification_unit_test" > "${run_root}/transfer-test.log" 2>&1
printf 'PVC_FOCUSED_TESTS_PASS\n' > "${run_root}/qualification-status"
set +e
(cd "${run_root}" && "${BUILD_PHASE_ROOT}/athena-build/src/athena" -i n256_scratch.athinput > stdout.log 2> stderr.log)
run_status=$?
set -e
printf 'athena_exit=%s\n' "${run_status}" > "${run_root}/run-status"
if [[ ${run_status} -eq 0 ]] && grep -Fq 'completed requested Z4c AMR-jump diagnostic window: target cycle 1722 plus 8 accepted cycles' "${run_root}/stdout.log" && [[ -d "${run_root}/z4c_amr_jump_n256_scratch" ]]; then
  printf 'AURORA_N256_SCRATCH_RUN_PASS\n' > "${run_root}/status"
else
  printf 'AURORA_N256_SCRATCH_RUN_INCOMPLETE_OR_FAILED\n' > "${run_root}/status"
fi
find "${run_root}" -type f ! -name SHA256SUMS -print0 | LC_ALL=C sort -z | xargs -0r sha256sum > "${run_root}/SHA256SUMS"
test "$(cat "${run_root}/status")" = AURORA_N256_SCRATCH_RUN_PASS
