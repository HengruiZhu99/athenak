# Bounded native-VC Cartoon smoke fixture for the default-off full-field
# constraint Bjorhus boundary RHS treatment.

<job>
basename = z4c_vc_minkowski_full_constraint_bjorhus

<mesh>
nghost = 4
nx1 = 32
x1min = 0.0
x1max = 4.0
ix1_bc = axis
ox1_bc = outflow
nx2 = 32
x2min = -2.0
x2max = 2.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 1

<mesh_refinement>
refinement = static
num_levels = 1

<time>
subcycle_probe_dt = 1e-4
subcycle_probe_ratio = 2
evolution = dynamic
integrator = rk4
cfl_number = 0.1
nlim = 1
tlim = 1.0
ndiag = 1

<z4c>
telegraph_lapse = true
telegraph_damping_prescription = max_domain_abs_K
telegraph_tau = 1
telegraph_kappa = 1
shift_mode = prescribed_zero
target_kappa1 = 0
grid_centering = vertex
symmetry = cartoon_so2
coordinate_map = half_rho_z_suppressed_y_v2
symmetry_schema = 2
spatial_order = 6
diss = 0.02
chi_div_floor = 1.0e-5
damp_kappa1 = 0.0
damp_kappa2 = 0.0
history_constraint_radius = -1.0
lapse_oplog = 2.0
lapse_harmonicf = 1.0
lapse_harmonic = 0.0
lapse_advect = 1.0
shift_Gamma = 0.0
shift_eta = 0.0
shift_advect = 0.0
boundary_rhs = full_constraint_bjorhus

<problem>
lapse_gaussian_amplitude = 0.1
pgen_name = z4c_vc_minkowski

<output1>
file_type = hst
dcycle = 1

<refined_region1>
level = 1
x1min = 0
x1max = 1
x2min = -1
x2max = 0
<output2>
file_type = rst
dcycle = 1
