#!/bin/bash -l
#PBS -N z4c-shock-n512
#PBS -A CompactBinaryMerger
#PBS -l select=2
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -l filesystems=home:flare
#PBS -q debug-scaling
#PBS -k doe
#PBS -j oe
set -euo pipefail

campaign=/lus/flare/projects/CompactBinaryMerger/hzhu/z4c-vc-reference-shock-gauge-figure3-aurora-20260828
: "${SEGMENT:?three-digit segment identifier}"
: "${RUN_TLIM:?coordinate-time ceiling}"
: "${QUALIFICATION_ID:?passed Aurora qualification job ID}"

export CASE_LABEL=n512
export RUN_NODES=2
export RANKS_PER_NODE=12
export ATHENA_WALL_LIMIT=00:20:00
export RUN_ROOT=${campaign}/runs/n512_reference_shock_seg${SEGMENT}
export HISTORY_FILE=${campaign}/authority/n256_reference_shock_authority.jsonl
export RUN_TLIM QUALIFICATION_ID
if [[ -n "${PREVIOUS_SEGMENT:-}" ]]; then
  previous=${campaign}/runs/n512_reference_shock_seg${PREVIOUS_SEGMENT}
  grep -Fxq HEALTHY_WALLTIME_RESTART_REQUIRED "${previous}/disposition"
  mapfile -t restarts < <(find "${previous}/rst" -maxdepth 1 -type f -name '*.rst' -printf '%T@ %p\n' |
    LC_ALL=C sort -n | awk '{print $2}')
  test "${#restarts[@]}" -gt 0
  RESTART_FILE=${restarts[-1]}
fi
if [[ -n "${RESTART_FILE:-}" ]]; then export RESTART_FILE; fi
exec "${campaign}/aurora_run_reference_replay.sh"
