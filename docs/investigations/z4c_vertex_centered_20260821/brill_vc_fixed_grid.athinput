<job>
basename = brill_vc_fixed

<mesh>
nghost = 4
nx1 = 128
x1min = 0.0
x1max = 16.0
ix1_bc = axis
ox1_bc = outflow
nx2 = 256
x2min = -16.0
x2max = 16.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<mesh_refinement>
refinement = none
num_levels = 1
max_nmb_per_rank = 128

<coord>
minkowski = true

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.15
nlim = -1
tlim = 0.5
ndiag = 4

<z4c>
grid_centering = vertex
vertex_axis_correction_tolerance = 1.0e-8
symmetry = cartoon_so2
coordinate_map = half_rho_z_suppressed_y_v2
symmetry_schema = 2
spatial_order = 4
history_kretschmann = true
diss = 0.02
excise_chi = 0.0
floor_chi = false
lapse_oplog = 0.0
lapse_harmonic = 0.0
lapse_advect = 1.0
slow_start_lapse = false
telegraph_lapse = true
telegraph_max_K = true
telegraph_damping_prescription = max_domain_abs_K
telegraph_tau = 1.0
telegraph_kappa = 1.0
shift_Gamma = 1.0
shift_alpha2Gamma = 0.0
shift_H = 0.0
shift_eta = 2.0
shift_eta_max_K = false
shift_advect = 1.0
sss_damping_amp = 0.0
damp_kappa1 = 0.0
damp_kappa2 = 0.0
damp_kappa1_max_K = false
roll_kappa = false
target_kappa1 = 0.0
rhs_stage_diagnostics = false
rhs_stage_diagnostics_start_time = 0.0
rhs_stage_diagnostics_rho_max = 0.5
rhs_stage_diagnostics_abs_z_max = 0.5

<z4c_amr>
method = trivial

<fastflow>
num_horizons = 0

<problem>
pgen_name = z4c_irisk_xcts
irisk_adm_import_mode = direct_global_coefficients
brill_global_coefficients_file = brill_global_48x32.coefficients
brill_direct_initial_lapse = precollapsed_psi_minus_2
require_ghost_coverage = true
write_constraint_summary = true
constraint_summary_file = brill_vc_fixed.constraints.dat
fail_if_c_rms_above = 1.0e300
fail_if_h_rms_above = 1.0e300
fail_if_m_rms_above = 1.0e300
fail_if_z_rms_above = 1.0e300
stop_on_horizon = false
stop_on_dispersion = false
xy_plane_output = EMPTY
xz_plane_output = EMPTY

<output1>
file_type = hst
data_format = %24.16e
dcycle = 4

<output2>
file_type = bin
variable = z4c
dt = 0.5
single_file_per_rank = true

<output3>
file_type = bin
variable = con
dt = 0.5
single_file_per_rank = true

<output4>
file_type = bin
variable = adm
dt = 0.5
single_file_per_rank = true

<output5>
file_type = bin
variable = z4c_diag
dt = 0.5
single_file_per_rank = true
