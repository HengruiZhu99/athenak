#!/bin/bash -l
#PBS -N z4c-vc-sycl-v3
#PBS -A CompactBinaryMerger
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -l filesystems=home:flare
#PBS -q debug
#PBS -k doe
#PBS -j oe
set -euo pipefail

base=/lus/flare/projects/CompactBinaryMerger/hzhu
stage="${base}/z4c-vc-qual-5d37b5e5-v3-20260822"
source_root="${stage}/source"
build_root="${stage}/build"
root="${stage}/campaign-v1"
wrapper="${stage}/input/aurora_vc_mpiexec_wrapper.sh"
expected_source=5d37b5e5c278ac4a1afd52f9553dee6ffed48d0e
expected_tree=e391e2889647471e2e8c0cf8bfbfeb5fe3c00edf
expected_kokkos=6739bc623081648af9e752b616d9671527922cbf
expected_exe=4189f822560b979693c2336f66e175d183db7254f2e2479e10e91e9d44f4bd85
expected_cache=d376655892259902bb67a6a7015cdd2e130921202123f3967657018641b322a9

test ! -e "${root}"
test -x "${wrapper}"
test "$(git -C "${source_root}" rev-parse HEAD)" = "${expected_source}"
test "$(git -C "${source_root}" rev-parse HEAD^{tree})" = "${expected_tree}"
test -z "$(git -C "${source_root}" status --porcelain)"
test "$(git -C "${source_root}/kokkos" rev-parse HEAD)" = "${expected_kokkos}"
test "$(sha256sum "${build_root}/src/athena" | cut -d' ' -f1)" = "${expected_exe}"
test "$(sha256sum "${build_root}/CMakeCache.txt" | cut -d' ' -f1)" = "${expected_cache}"

mkdir -p "${root}/evidence" "${root}/qualification"
finish() {
  code=$?
  trap - EXIT
  set +e
  printf '%s\n' "${code}" > "${root}/orchestration-status"
  git -C "${source_root}" status --porcelain=v1 > "${root}/evidence/source-status.final"
  qstat -f "${PBS_JOBID}" > "${root}/evidence/qstat-final.txt" 2>&1
  find "${root}" -type f ! -name SHA256SUMS ! -name SHA256SUMS.sha256 \
    -print0 | LC_ALL=C sort -z | xargs -0r sha256sum > "${root}/SHA256SUMS"
  (cd "${root}" && sha256sum -c SHA256SUMS >/dev/null)
  sha256sum "${root}/SHA256SUMS" > "${root}/SHA256SUMS.sha256"
  exit "${code}"
}
trap finish EXIT

workflow="${base}/collapse-critical/collapse-critical-workflow"
export ATHENAK_ROOT="${source_root}"
export ATHENAK_BUILD_DIR="${build_root}"
export IRISK_ROOT="${base}/collapse-critical/bbhk"
export IRISK_BUILD_DIR="${IRISK_ROOT}/build/aurora-pvc"
source "${workflow}/profiles/aurora-pvc.sh"
export OMP_NUM_THREADS=8 KOKKOS_NUM_THREADS=8
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export MPIR_CVAR_ENABLE_GPU=1 MPICH_GPU_SUPPORT_ENABLED=1
tile_wrapper=/opt/aurora/26.26.0/support/tools/mpi_wrapper_utils/gpu_tile_compact.sh
test -x "${tile_wrapper}"

{
  date --iso-8601=seconds
  hostname
  git -C "${source_root}" rev-parse HEAD HEAD^{tree}
  git -C "${source_root}" submodule status -- kokkos
  module list
  command -v icpx mpicxx mpiexec sycl-ls
  icpx --version | head -1
  mpicxx -show
  cmake --version | head -1
  sycl-ls
  qstat -f "${PBS_JOBID}"
  sha256sum "${build_root}/src/athena" "${build_root}/CMakeCache.txt"
} > "${root}/evidence/provenance.txt" 2>&1

grep -qx 'Kokkos_ENABLE_SYCL:BOOL=ON' "${build_root}/CMakeCache.txt"
grep -qx 'Kokkos_ARCH_INTEL_PVC:BOOL=ON' "${build_root}/CMakeCache.txt"
grep -qx 'Athena_ENABLE_MPI:BOOL=ON' "${build_root}/CMakeCache.txt"
grep -qx 'Athena_BUILD_UNIT_TESTS:BOOL=ON' "${build_root}/CMakeCache.txt"

regex='^athena[.]z4c_(vc|cartoon_axis_centered)'
ctest --test-dir "${build_root}" --show-only=json-v1 -R "${regex}" \
  > "${root}/qualification/ctest-inventory.json"
python3 - "${root}/qualification/ctest-inventory.json" "${build_root}" \
  "${wrapper}" "${tile_wrapper}" \
  > "${root}/qualification/sycl-ctest.log" 2>&1 <<'PY'
import json, os, pathlib, subprocess, sys, time

inventory = json.loads(pathlib.Path(sys.argv[1]).read_text())
build_root = pathlib.Path(sys.argv[2])
mpi_wrapper = sys.argv[3]
tile_wrapper = sys.argv[4]
assert inventory["kind"] == "ctestInfo"
assert inventory["version"]["major"] == 1
tests = inventory["tests"]
assert len(tests) == 30, [test["name"] for test in tests]
assert len({test["name"] for test in tests}) == 30
for index, test in enumerate(tests, 1):
    command = list(test["command"])
    has_nested_mpi = "--mpiexec" in command
    if has_nested_mpi:
        location = command.index("--mpiexec")
        command[location + 1] = mpi_wrapper
    else:
        needs_device = not (
            pathlib.Path(command[0]).name.startswith("python") and
            "--athena" not in command
        )
        if needs_device:
            command = [
                "/opt/cray/pals/1.8/bin/mpiexec", "-n", "1", "-ppn", "1",
                "--depth", "8", "--cpu-bind", "depth", tile_wrapper,
            ] + command
    timeout = 300.0
    for prop in test.get("properties", []):
        if prop["name"] == "TIMEOUT":
            timeout = float(prop["value"])
        assert prop["name"] not in {
            "DISABLED", "WILL_FAIL", "SKIP_RETURN_CODE",
            "SKIP_REGULAR_EXPRESSION",
        }
    print(f"START {index}/30 {test['name']}", flush=True)
    start = time.monotonic()
    result = subprocess.run(
        command, cwd=build_root, text=True, stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT, timeout=timeout, env=os.environ.copy())
    print(result.stdout, end="")
    print(f"END {index}/30 {test['name']} status={result.returncode} "
          f"seconds={time.monotonic()-start:.6f}", flush=True)
    if result.returncode != 0:
        raise SystemExit(result.returncode)
print("100% tests passed, 0 tests failed out of 30", flush=True)
PY
grep -Fx '100% tests passed, 0 tests failed out of 30' \
  "${root}/qualification/sycl-ctest.log" >/dev/null
grep -Fq 'on SYCL' "${root}/qualification/sycl-ctest.log"
printf 'AURORA_PVC_VERTEX_TESTS_PASS\n' > "${root}/qualification/status"
printf 'AURORA_PVC_VERTEX_QUALIFICATION_PASS\n' > "${root}/status"
