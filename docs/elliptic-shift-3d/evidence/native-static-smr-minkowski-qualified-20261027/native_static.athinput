# Experimental Serial native Task integration. Global shell state is host-owned.
<job>
basename=native_smr
<mesh>
nx1=12
nx2=12
nx3=12
nghost=4
x1min=-.25
x1max=.25
x2min=-.25
x2max=.25
x3min=-.25
x3max=.25
ix1_bc=outflow
ox1_bc=outflow
ix2_bc=outflow
ox2_bc=outflow
ix3_bc=outflow
ox3_bc=outflow
<mesh_refinement>
refinement=static
max_nmb_per_rank=15
num_levels=2
<meshblock>
nx1=6
nx2=6
nx3=6
<time>
evolution=dynamic
integrator=rk4
cfl_number=.4
nlim=2
tlim=.0002
ndiag=1
<z4c>
composite_elliptic_experimental=true
composite_radii=.45,.55,.60,.65,.70,.75,1
composite_half_width=.25
composite_dt=.0001
composite_tolerance=1e-11
composite_output=native_smr
composite_output_every=1
composite_initial_lapse_amplitude=0
composite_initial_angular=false
composite_checkpoint_tag=native-composite-minkowski-v1
floor_chi=false
spatial_order=4
nrad_wave_extraction=0
<adm>
separate_z4c_gauge=true
<problem>
pgen_name=z4c_composite_minkowski
mass=0
lapse_pulse=0
<output1>
file_type=bin
variable=z4c
id=z4c
dt=.0001
ghost_zones=true
<output2>
file_type=bin
variable=adm
id=adm
dt=.0001
ghost_zones=true
<output3>
file_type=rst
dt=.0001

<refined_region1>
level=1
x1min=-.24
x1max=-.01
x2min=-.24
x2max=-.01
x3min=-.24
x3max=-.01
