// Bounded full-action Arnoldi witness; no spectral-gap or production claim.
#include <cstdint>
#include <fstream>
#include <iomanip>
#include <iostream>
#include <string>
#include "composed_metric_operator_probe.hpp"
namespace h=z4c::hyperboloidal;namespace c=cubed_sphere;namespace p=composed_metric_probe;
using V=p::V;
static void WriteBasis(const std::string&name,const std::vector<V>&q){std::ofstream f(name,std::ios::binary);std::uint64_t rows=q.size(),cols=q.at(0).size();f.write(reinterpret_cast<const char*>(&rows),8);f.write(reinterpret_cast<const char*>(&cols),8);for(const auto&v:q)f.write(reinterpret_cast<const char*>(v.data()),8*v.size());if(!f)throw std::runtime_error("basis write failure");}
static std::vector<V> ReadBasis(const std::string&name){std::ifstream f(name,std::ios::binary);std::uint64_t rows=0,cols=0;f.read(reinterpret_cast<char*>(&rows),8);f.read(reinterpret_cast<char*>(&cols),8);if(rows<1||rows>81||cols!=32400)throw std::runtime_error("basis shape");std::vector<V>q(rows,V(cols));for(auto&v:q)f.read(reinterpret_cast<char*>(v.data()),8*v.size());if(!f)throw std::runtime_error("basis read failure");return q;}
int main(int argc,char**argv){Kokkos::initialize(argc,argv);int status=0;try{
 if(argc<4)throw std::invalid_argument("usage: probe expanded|composed arnoldi|witness prefix [coefficients]");const std::string which=argv[1],mode=argv[2],prefix=argv[3];if(which!="expanded"&&which!="composed")throw std::invalid_argument("operator selector");
 const int n=6;c::CompositeMesh mesh(.25,{.45,.55,.60,.65,.70,.75,1},1,n,2,2);h::CompositeShiftStage stage(mesh,4,true,true,true,false);const auto&g=stage.grid;c::ScriSurface surface(g,6,7);const size_t N=g.active.size();std::vector<p::U>bulk(N),edge(surface.rows.size());std::vector<h::MetricJet<Real>>metrics;
 for(auto&u:bulk){u.alpha.value=u.chi.value=1;for(int a=0;a<3;++a)u.metric.g[a][a]=1;metrics.push_back(u.metric);}for(auto&u:edge){u.alpha.value=u.chi.value=1;for(int a=0;a<3;++a)u.metric.g[a][a]=1;}stage.SetGeometry(metrics);p::Operator composed(stage,surface,bulk,edge);
 auto dot=[&](const V&a,const V&b){return stage.Dot(a,b);};auto length=[&](const V&a){return std::sqrt(dot(a,a));};
 auto pre=[&](const V&a){V out(a.size());for(int v=0;v<3;++v){V scalar(N);for(size_t k=0;k<N;++k)scalar[k]=a[3*k+v];const auto x=stage.preconditioner.Cycle(scalar);for(size_t k=0;k<N;++k)out[3*k+v]=x[k];}return out;};
 auto apply=[&](const V&a){V out;if(which=="expanded")stage.Apply(a,out);else composed.Apply(a,out);return out;};auto AP=[&](const V&a){return apply(pre(a));};
 if(mode=="arnoldi"){
  constexpr int width=80;V first(3*N);std::uint64_t rng=0x114de34a51ULL;for(size_t k=0;k<N;++k){const auto&x=g.geometry[k].x;const Real r2=x[0]*x[0]+x[1]*x[1]+x[2]*x[2],envelope=std::pow(std::max(Real(0),1-r2),2);for(int v=0;v<3;++v){rng^=rng<<13;rng^=rng>>7;rng^=rng<<17;const Real noise=(rng>>11)*0x1.0p-53-.5;first[3*k+v]=envelope*(std::sin((v+2)*x[0]+(v+1)*x[1]-.3*x[2])+.1*noise);}}
  const Real initial=length(first);for(auto&v:first)v/=initial;std::vector<V>q{std::move(first)};std::vector<V>H(width+1,V(width,0));int columns=0;Real orthogonality=0;std::vector<Real>norms;
  for(int j=0;j<width;++j){V w=AP(q[j]);norms.push_back(length(w));for(int pass=0;pass<2;++pass)for(int i=0;i<=j;++i){const Real a=dot(w,q[i]);H[i][j]+=a;for(size_t k=0;k<w.size();++k)w[k]-=a*q[i][k];}const Real beta=length(w);H[j+1][j]=beta;columns=j+1;if(beta<1e-26)break;for(auto&v:w)v/=beta;for(const auto&v:q)orthogonality=std::max(orthogonality,std::abs(dot(v,w)));orthogonality=std::max(orthogonality,std::abs(dot(w,w)-1));q.push_back(std::move(w));}
  WriteBasis(prefix+".Q.bin",q);std::ofstream out(prefix+".H.json");out<<std::setprecision(17)<<"{\"operator\":\""<<which<<"\",\"n\":6,\"shells\":7,\"active_cells\":"<<N<<",\"dimension\":"<<3*N<<",\"arnoldi_columns\":"<<columns<<",\"basis_rows\":"<<q.size()<<",\"physical_dot\":\"CompositeShiftStage::Dot\",\"double_mgs\":true,\"orthogonality_max\":"<<orthogonality<<",\"hessenberg\":[";for(int i=0;i<=columns;++i){out<<(i?",":"")<<'[';for(int j=0;j<columns;++j)out<<(j?",":"")<<H[i][j];out<<']';}out<<"],\"AP_column_norms\":[";for(int i=0;i<columns;++i)out<<(i?",":"")<<norms[i];out<<"],\"production_adopted\":false,\"full_spectral_gap_proved\":false}\n";std::cout<<"Arnoldi "<<which<<" columns="<<columns<<" orthogonality="<<orthogonality<<'\n';
 }else if(mode=="witness"){
  if(argc!=5)throw std::invalid_argument("missing witness coefficients");const auto q=ReadBasis(prefix+".Q.bin");std::ifstream cf(argv[4]);V coeff;Real a;while(cf>>a)coeff.push_back(a);if(coeff.empty()||coeff.size()>80||coeff.size()>q.size())throw std::invalid_argument("witness coefficient shape");V v(3*N,0);for(size_t i=0;i<coeff.size();++i)for(size_t k=0;k<v.size();++k)v[k]+=coeff[i]*q[i][k];const Real scale=length(v);for(auto&x:v)x/=scale;const auto z=pre(v),av=apply(z);const Real actual=length(av),physical=length(z);
  std::ofstream csv(prefix+".witness.csv");csv<<"point,block,i,j,k,x,y,z,v0,v1,v2,Pv0,Pv1,Pv2,APv0,APv1,APv2\n"<<std::setprecision(17);struct Region{size_t cells=0;Real measure=0,v2=0,z2=0,a2=0,amax=0;};std::map<std::string,Region>regions;
  for(size_t k=0;k<N;++k){const int m=k/(n*n*n),i=k%n,j=k/n%n,l=k/(n*n)%n;const auto&b=g.mesh.blocks[m];const auto&x=g.geometry[k].x;std::vector<std::string>names{"all",b.face<0?"cartesian":"shell",b.layer==6?"outer_shell":"not_outer_shell"};if(b.face>=0&&b.layer==6&&i>=n-2)names.push_back("scri_stencil_band");if(i<2||i>=n-2||j<2||j>=n-2||l<2||l>=n-2)names.push_back("any_patch_stencil_band");else names.push_back("bulk");for(const auto&name:names){auto&r=regions[name];++r.cells;r.measure+=stage.norm_volume[k];for(int c=0;c<3;++c){r.v2+=stage.norm_volume[k]*v[3*k+c]*v[3*k+c];r.z2+=stage.norm_volume[k]*z[3*k+c]*z[3*k+c];r.a2+=stage.norm_volume[k]*av[3*k+c]*av[3*k+c];r.amax=std::max(r.amax,std::abs(av[3*k+c]));}}
   csv<<k<<','<<m<<','<<i<<','<<j<<','<<l;for(Real a:x)csv<<','<<a;for(const auto*data:std::array<const V*,3>{&v,&z,&av})for(int c=0;c<3;++c)csv<<','<<(*data)[3*k+c];csv<<'\n';}
  std::ofstream out(prefix+".witness.json");out<<std::setprecision(17)<<"{\"operator\":\""<<which<<"\",\"input_physical_norm\":"<<length(v)<<",\"independent_full_APv_norm\":"<<actual<<",\"Pv_physical_norm\":"<<physical<<",\"Az_over_z\":"<<actual/physical<<",\"coarse_fine_cells\":0,\"coarse_fine_reason\":\"fixed unrefined Cartesian core; no coarse-fine interface\",\"regions\":{";bool comma=false;for(const auto&[name,r]:regions){out<<(comma?",":"")<<'"'<<name<<"\":{\"cells\":"<<r.cells<<",\"physical_measure_fraction\":"<<r.measure<<",\"v_norm_contribution\":"<<std::sqrt(r.v2)<<",\"Pv_norm_contribution\":"<<std::sqrt(r.z2)<<",\"APv_norm_contribution\":"<<std::sqrt(r.a2)<<",\"APv_pointmax\":"<<r.amax<<'}';comma=true;}out<<"},\"production_adopted\":false,\"full_spectral_gap_proved\":false}\n";std::cout<<"Independent "<<which<<" APv="<<actual<<" Az/z="<<actual/physical<<'\n';
 }else throw std::invalid_argument("mode selector");
}catch(const std::exception&e){std::cerr<<e.what()<<'\n';status=2;}Kokkos::finalize();return status;}
