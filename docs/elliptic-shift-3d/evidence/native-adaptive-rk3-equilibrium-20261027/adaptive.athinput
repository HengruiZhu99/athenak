# Experimental Serial native Task integration. Global shell state is host-owned.
<job>
basename=native_adaptive
<mesh>
nx1=12
nx2=12
nx3=12
nghost=4
x1min=-.25
x1max=.25
x2min=-.25
x2max=.25
x3min=-.25
x3max=.25
ix1_bc=outflow
ox1_bc=outflow
ix2_bc=outflow
ox2_bc=outflow
ix3_bc=outflow
ox3_bc=outflow
<mesh_refinement>
refinement=adaptive
max_nmb_per_rank=32
num_levels=2
refinement_interval=1
ncycle_check=1
<meshblock>
nx1=6
nx2=6
nx3=6
<time>
evolution=dynamic
integrator=rk3
cfl_number=0.40000000000000002
nlim=4
tlim=.0004
ndiag=1
<z4c>
composite_elliptic_experimental=true
composite_radii=1
composite_half_width=.25
composite_dt=0.0001
composite_tolerance=1e-11
composite_output=native_adaptive
composite_output_every=1
composite_initial_lapse_amplitude=0
composite_initial_angular=true
composite_adaptive_experimental=true
composite_validation_refine_cycle=1
composite_validation_coarsen_cycle=3
composite_checkpoint_tag=native-composite-minkowski-v1
floor_chi=false
spatial_order=4
nrad_wave_extraction=0
<adm>
separate_z4c_gauge=true
<problem>
pgen_name=z4c_composite_minkowski
mass=0
lapse_pulse=0
<output1>
file_type=bin
variable=z4c
id=z4c
dt=.0001
ghost_zones=true
<output2>
file_type=bin
variable=adm
id=adm
dt=.0001
ghost_zones=true
<output3>
file_type=rst
dt=.0001

<amr_criterion1>
method=location
location_rad=0
