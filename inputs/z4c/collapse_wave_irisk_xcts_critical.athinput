# AthenaK Z4c critical-collapse evolution from an IrisK filled-sphere XCTS export.
# This input uses dimensionless gauge coefficients and dchi-driven AMR.  AthenaK
# requires a finite level budget up front; increase num_levels/max_ref_lev together
# when a longer DSS cascade is needed.
#
# Launch from a sibling athenak repository root after running IrisK's
# collapse_wave_xcts_export.athinput:
#   env OMP_NUM_THREADS=1 KOKKOS_NUM_THREADS=1 \
#     ./build_irisk_xcts/src/athena \
#     -i inputs/z4c/collapse_wave_irisk_xcts_critical.athinput \
#     -d ../collapse-wave-data/athenak-critical-A1
#
# The initial-data path is resolved before AthenaK applies -d. Override
# problem/irisk_adm_spectral_file with an absolute path for another layout.

<comment>
problem = IrisK compact collapsing-wave XCTS data with dchi AMR
reference = ../bbhk/inputs/xcts/collapse_wave_xcts_export.athinput

<job>
basename = collapse_wave_irisk_xcts_critical

<mesh>
nghost = 4
nx1 = 64
x1min = -32.0
x1max = 32.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -32.0
x2max = 32.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 64
x3min = -32.0
x3max = 32.0
ix3_bc = outflow
ox3_bc = outflow

# The initially uniform root grid has 4^3 MeshBlocks. Small blocks keep
# successively shrinking central features affordable.
<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<mesh_refinement>
refinement = adaptive
# This is a per-rank preallocation and therefore a memory/performance tuning knob.
max_nmb_per_rank = 1024
num_levels = 12
ncycle_check = 1
refinement_interval = 1

<refined_region1>
level = 1
x1min = -16.0
x1max = 16.0
x2min = -16.0
x2max = 16.0
x3min = -16.0
x3max = 16.0

<refined_region2>
level = 2
x1min = -8.0
x1max = 8.0
x2min = -8.0
x2max = 8.0
x3min = -8.0
x3max = 8.0

<amr_criterion0>
method = user

<z4c_amr>
method = dchi
# max over a block of the dimensionless centered two-cell difference in chi.
dchi_max = 0.02
max_ref_lev = 11

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.20
nlim = -1
tlim = 10.0
nmb_total_limit = 768
ndiag = 1

<z4c>
spatial_order = 6
diss = 0.02
excise_chi = 0.0
floor_chi = false

# Pure telegraph lapse: do not retain the default 1+log driver.
lapse_oplog = 0.0
lapse_harmonic = 0.0
lapse_advect = 1.0
slow_start_lapse = false
telegraph_lapse = true
telegraph_max_K = true
# In max-|K| mode tau and kappa are dimensionless:
# B_i,t = -(max|K|/tau) B_i + (kappa/tau) d_i alpha.
telegraph_tau = 1.0
telegraph_kappa = 1.0

# The effective shift damping is shift_eta*max|K|.
shift_Gamma = 1.0
shift_alpha2Gamma = 0.0
shift_H = 0.0
shift_eta = 2.0
shift_eta_max_K = true
shift_advect = 1.0
sss_damping_amp = 0.0

# Max-K scaling makes damp_kappa1 and target_kappa1 dimensionless multipliers.
damp_kappa1 = 0.02
damp_kappa2 = 0.0
damp_kappa1_max_K = true
roll_kappa = false
target_kappa1 = 0.02

<fastflow>
num_horizons = 1
ntheta = 5
lmax = 4
flow_iterations_0 = 100
# Before a horizon is found, r_guess=12.5*dx_min.  This follows the dchi=0.02
# Schwarzschild calibration and shrinks geometrically as central AMR deepens.
initial_radius_0 = 1.0
use_finest_dx_initial_radius_0 = true
finest_dx_initial_radius_factor_0 = 12.5
# Search accepted states every eight cycles. A negative stop time is unbounded.
find_interval_0 = 8
start_time_0 = 0.0
stop_time_0 = -1.0
use_puncture_0 = -1
use_puncture_massweighted_center_0 = false
use_minimum_lapse_center_0 = true

<problem>
pgen_name = z4c_irisk_xcts
irisk_adm_spectral_file = ../collapse-wave-data/collapse_wave_xcts_A1_N6.adm_spectral
write_constraint_summary = true
constraint_summary_file = collapse_wave_irisk_xcts_critical-constraints.dat
xy_plane_output = EMPTY
xz_plane_output = EMPTY

<output1>
file_type = hst
data_format = %24.16e
dcycle = 1

# Retain restart points while tuning toward threshold. The imported IrisK file
# is needed only for a fresh start; AthenaK restarts restore evolved Z4c data.
<output2>
file_type = rst
dcycle = 64

<output3>
file_type = bin
variable = z4c_alpha
dcycle = 1
slice_x3 = 0.0
id = lapse_xy

<output4>
file_type = bin
variable = z4c_alpha
dcycle = 1
slice_x2 = 0.0
id = lapse_xz

# Four-ghost sixth-order curvature diagnostics.
<output5>
file_type = bin
variable = z4c_diag
dcycle = 8
slice_x3 = 0.0
id = z4c_diag_xy

<output6>
file_type = bin
variable = z4c_diag
dcycle = 8
slice_x2 = 0.0
id = z4c_diag_xz
