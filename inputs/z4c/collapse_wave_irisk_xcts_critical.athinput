# AthenaK Z4c critical-collapse evolution from an IrisK filled-sphere XCTS export.
# This input uses dimensionless gauge coefficients and dchi-driven AMR.  AthenaK
# requires a finite level budget up front; increase num_levels/max_ref_lev together
# when a longer DSS cascade is needed.

<comment>
problem = IrisK compact collapsing-wave XCTS data with dchi AMR
reference = ../bbhk/inputs/xcts/collapse_wave_xcts_export.athinput

<job>
basename = collapse_wave_irisk_xcts_critical

<mesh>
nghost = 4
nx1 = 48
x1min = -7.0
x1max = 7.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 48
x2min = -7.0
x2max = 7.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 48
x3min = -7.0
x3max = 7.0
ix3_bc = outflow
ox3_bc = outflow

# Small blocks keep successively shrinking central features affordable.  The
# static convergence input retains its larger 48^3 blocks.
<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<mesh_refinement>
refinement = adaptive
# This is a per-rank preallocation and therefore a memory/performance tuning knob.
max_nmb_per_rank = 768
num_levels = 12
ncycle_check = 1
refinement_interval = 1

<amr_criterion0>
method = user

<z4c_amr>
method = dchi
# max over a block of the dimensionless centered two-cell difference in chi.
dchi_max = 0.02
max_ref_lev = 11

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.20
nlim = -1
tlim = 5.0
ndiag = 1

<z4c>
spatial_order = 6
diss = 0.0
excise_chi = 0.0
floor_chi = false

# Pure telegraph lapse: do not retain the default 1+log driver.
lapse_oplog = 0.0
lapse_harmonic = 0.0
lapse_advect = 1.0
slow_start_lapse = false
telegraph_lapse = true
telegraph_max_K = true
# In max-|K| mode tau and kappa are dimensionless:
# B_i,t = -(max|K|/tau) B_i + (kappa/tau) d_i alpha.
telegraph_tau = 0.1
telegraph_kappa = 0.1

# The effective shift damping is shift_eta*max|K|.
shift_eta = 2.0
shift_eta_max_K = true
shift_advect = 1.0
sss_damping_amp = 0.0

# Disabled for the planned critical-collapse run.  Enabling max-K scaling makes
# both damp_kappa1 and target_kappa1 dimensionless multipliers.
damp_kappa1 = 0.0
damp_kappa2 = 0.0
damp_kappa1_max_K = true
roll_kappa = false
target_kappa1 = 0.0

<fastflow>
num_horizons = 0

<problem>
pgen_name = z4c_irisk_xcts
irisk_adm_spectral_file = ../bbhk/collapse_wave_xcts.adm_spectral
require_ghost_coverage = true
write_constraint_summary = true
constraint_summary_file = collapse_wave_irisk_xcts_critical-constraints.dat
fail_if_c_rms_above = 1.0e300
fail_if_h_rms_above = 1.0e300
fail_if_m_rms_above = 1.0e300
fail_if_z_rms_above = 1.0e300
xy_plane_output = EMPTY
xz_plane_output = EMPTY

<output1>
file_type = hst
data_format = %24.16e
dt = 0.01
