# Short finite-pulse diagnostic; long stability is not established.
<job>
basename=hyp

<mesh>
nx1=24
nx2=24
nx3=24
nghost=3
x1min=-1.05
x1max=1.05
x2min=-1.05
x2max=1.05
x3min=-1.05
x3max=1.05
ix1_bc=outflow
ox1_bc=outflow
ix2_bc=outflow
ox2_bc=outflow
ix3_bc=outflow
ox3_bc=outflow

<meshblock>
nx1=24
nx2=24
nx3=24

<time>
evolution=dynamic
integrator=rk3
cfl_number=0.4
nlim=2
tlim=0.001
ndiag=1

<z4c>
hyperboloidal=true
hyperboloidal_slicing=2
hyperboloidal_shift_driver=0.1
hyperboloidal_lapse_damping=1.5
hyperboloidal_shift_damping=1
hyperboloidal_kappa1=5
hyperboloidal_dissipation=0.1
hyperboloidal_pole_cfl=0.04
hyperboloidal_ghost_degree=3
hyperboloidal_mass_diagnostics=false
hyperboloidal_mass_nmu=32
floor_chi=false
nrad_wave_extraction=0
spatial_order=4

<problem>
pgen_name=z4c_hyperboloidal
mass=0
lapse_pulse=0

<output1>
file_type=bin
variable=z4c
id=z4c
dt=0.0001
ghost_zones=true

<output2>
file_type=bin
variable=adm
id=adm
dt=0.0001
ghost_zones=true

<output3>
file_type=hst
dt=0.0001
data_format=%24.16e
# Experimental uniform Cartesian prototype. See docs/hyperboloidal.md.
# Layer mass>0 selects wormhole initial data; 0<M<2*layer_r0 is required.
# The Minkowski reference remains the gauge target. Long stability is unverified.

<output4>
file_type=bin
variable=con
id=con
dt=0.0001
ghost_zones=true

<output5>
file_type=rst
dt=0.0001

<z4c>
# Interior-only research prototype: exact scri is never assembled.
hyperboloidal_layer=true
hyperboloidal_layer_r0=0.35
hyperboloidal_layer_r1=0.75
hyperboloidal_gauge_r0=0.45
hyperboloidal_gauge_r1=0.85
hyperboloidal_gauge_q0=0.5
hyperboloidal_layer_lapse_inner=0
hyperboloidal_layer_lapse_outer=1.5
hyperboloidal_layer_shift_inner=0
hyperboloidal_layer_shift_outer=1
hyperboloidal_preferred_source=true

<z4c>
hyperboloidal_physical_trace_lapse=true
hyperboloidal_preferred_source=false
hyperboloidal_curvature_radius=.5
hyperboloidal_symmetric_ghosts=true
hyperboloidal_ghost_degree=2
hyperboloidal_layer_r0=.2
hyperboloidal_layer_r1=.8
<problem>
lapse_pulse=.1
shift_pulse=.02
pulse_angular=true
