# AthenaK Candidate-A/C gauge qualification template.
#
# The campaign runner changes only mesh/nx{1,2,3}, job/basename,
# z4c/shift_gauge, time/tlim, fastflow start/stop time, and output paths.
# All gauge cases at a given resolution otherwise use this identical deck.

<comment>
problem   = unit-mass isotropic Schwarzschild puncture gauge qualification
reference = Candidate-A/C moving-puncture experiment, 2026-08-13

<job>
basename = z4c_candidate_ac

<mesh>
nghost = 4
nx1    = 8
x1min  = -10.0
x1max  = 10.0
ix1_bc = outflow
ox1_bc = outflow
nx2    = 8
x2min  = -10.0
x2max  = 10.0
ix2_bc = outflow
ox2_bc = outflow
nx3    = 8
x3min  = -10.0
x3max  = 10.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 4
nx2 = 4
nx3 = 4

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.1
nlim       = -1
tlim       = 0.1
ndiag      = 1

<mesh_refinement>
refinement          = static
max_nmb_per_rank    = 512
num_levels          = 5

<z4c_amr>
method = tracker

<amr_criterion0>
method = user

<refined_region1>
level = 4
x1min = -0.6
x1max = 0.6
x2min = -0.6
x2max = 0.6
x3min = -0.6
x3max = 0.6

<z4c>
chi_psi_power        = -4.0
chi_div_floor        = -1000.0
floor_chi            = false
diss                 = 0.02
damp_kappa1          = 0.02
damp_kappa2          = 0.0
lapse_harmonicf      = 1.0
lapse_harmonic       = 0.0
lapse_oplog          = 2.0
lapse_advect         = 1.0
slow_start_lapse     = false
shift_gauge          = standard
shift_advect         = 1.0
shift_eta            = 2.0
use_z4c              = true
extrap_order         = 4
nrad_wave_extraction = 0
excise_chi           = 0.0625

# Compact-object tracker.
nco          = 1
co_0_type    = BH
co_0_x       = 0.0
co_0_y       = 0.0
co_0_z       = 0.0
co_0_mass    = 1.0
tracker_mode = ode

<fastflow>
npunct       = 1
num_horizons = 1
ntheta       = 10
lmax         = 6
use_puncture_0 = 0
initial_radius_0 = 1.0
center_x_0 = 0.0
center_y_0 = 0.0
center_z_0 = 0.0
flow_iterations_0 = 100
flow_alpha_beta_const_0 = 1.0
hmean_tol_0 = 100.0
mass_tol_0 = 1e-2
start_time_0 = 0.1
stop_time_0 = 0.1
output_ylm = false
output_grid = false
verbose = true

<problem>
pgen_name       = z4c_one_puncture
punc_ADM_mass   = 1.0
punc_center_x1  = 0.0
punc_center_x2  = 0.0
punc_center_x3  = 0.0
user_hist       = true
final_horizon   = true
gauge_diagnostics_file = z4c_gauge_source_diagnostics.csv

<output1>
file_type   = hst
data_format = %.17e
dt          = 0.1

<output2>
file_type = bin
variable  = z4c
dt        = 1000.0

<output3>
file_type = bin
variable  = adm
dt        = 1000.0

<output4>
file_type = bin
variable  = con
dt        = 1000.0

<output5>
file_type = tab
variable  = z4c
dt        = 0.1
slice_x2  = 0.0
slice_x3  = 0.0

<output6>
file_type = rst
dt        = 1000.0
