# Experimental actual Driver RK selected M=1/3 wormhole; host-owned shells.
# Generate initial.dat with the independent 1D IsotropicWormhole sampler.
# Global12³ / per-block6³: eight static native Cartesian blocks.
# Underresolved short pilot; no AMR/regrid or scientific acceptance claim.
<job>
basename=native_wormhole
<mesh>
nx1=12
nx2=12
nx3=12
nghost=3
x1min=-.25
x1max=.25
x2min=-.25
x2max=.25
x3min=-.25
x3max=.25
ix1_bc=outflow
ox1_bc=outflow
ix2_bc=outflow
ox2_bc=outflow
ix3_bc=outflow
ox3_bc=outflow
<mesh_refinement>
refinement=none
<meshblock>
nx1=6
nx2=6
nx3=6
<time>
evolution=dynamic
integrator=rk4
cfl_number=.4
nlim=2
tlim=.0002
ndiag=1
<z4c>
composite_elliptic_experimental=true
composite_radii=.45,.55,.60,.65,.70,.75,1
composite_half_width=.25
composite_dt=.0001
composite_tolerance=1e-11
composite_output=native_wormhole
composite_output_every=1
composite_initial_lapse_amplitude=0
composite_initial_angular=false
composite_positive_storage=2
composite_telegraph_width=.24
composite_initial_file=initial.dat
composite_checkpoint_tag=native-composite-wormhole-static8-v1
floor_chi=false
spatial_order=4
nrad_wave_extraction=0
<adm>
separate_z4c_gauge=true
<problem>
pgen_name=z4c_composite_wormhole
mass=.3333333333333333333
lapse_pulse=0
<output1>
file_type=bin
variable=z4c
id=z4c
dt=.0001
ghost_zones=true
<output2>
file_type=bin
variable=adm
id=adm
dt=.0001
ghost_zones=true
<output3>
file_type=rst
dt=.0001
