# File path is relative to the run directory. Use an absolute path with -d.
<job>
basename = torus

<mesh>
nghost = 4
nx1 = 48
x1min = 0
x1max = 24
ix1_bc = axis
ox1_bc = outflow
nx2 = 48
x2min = -12
x2max = 12
ix2_bc = outflow
ox2_bc = outflow
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 24
nx2 = 24
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.7
tlim = 0.03
nlim = -1
ndiag = 10

<z4c>
grid_centering = vertex
symmetry = cartoon_so2
coordinate_map = half_rho_z_suppressed_y_v2
symmetry_schema = 2
spatial_order = 6
lean_runtime = false
diss = 0.02

<boltzmann>
nmu_half = 24
npsi = 32
sign = prograde
backreaction = true

<problem>
pgen_name = photon_torus
torus_file = strong.adm
torus_audit_prefix = initial
user_hist = true

<output1>
file_type = hst
data_format = %24.16e
dcycle = 1
