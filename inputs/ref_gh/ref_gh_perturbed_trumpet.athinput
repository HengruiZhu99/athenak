# Smooth Gaussian perturbation of the stationary n=2 Schwarzschild trumpet.
# The trace-free Psi_22=-Psi_33 pulse is initialized with analytically compatible
# Phi_IAB.  Override root/MeshBlock sizes and coarsen_factor together for the
# 64/96/128 self-convergence ladder. Full-resolution output is retained only
# for the ten perturbed field components and six native constraints.

<job>
basename = ref_gh_perturbed_trumpet_dx16

<mesh>
nghost = 4
nx1 = 64
x1min = -2.0
x1max = 2.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -2.0
x2max = 2.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 64
x3min = -2.0
x3max = 2.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.05
nlim = -1
tlim = 0.2
ndiag = 10

<ref_gh>
reference = trumpet
source = covariant
reference_mass = 1.0
fd_order = 4
debug_task_fences = false
validate_reference_cache = false
gamma0 = 1.0
diss = 0.02
fail_closed_dt = 1.0e-12

<problem>
pgen_name = ref_gh_perturbed_trumpet
perturb_amplitude = 1.0e-6
perturb_width = 0.5
common_adm_history = true
common_adm_fd_order = 4
debug_repeat_initial_rhs = false

<output1>
file_type = hst
dt = 0.02
data_format = %20.15e

<output2>
file_type = rst
dt = 0.1

<output3>
file_type = cbin
variable = ref_gh_perturb
id = ref_gh_perturb
dt = 0.2
coarsen_factor = 1
compute_moments = false
single_file_per_rank = false

<output4>
file_type = cbin
variable = ref_gh_native_con
id = ref_gh_native_con
dt = 0.2
coarsen_factor = 1
compute_moments = false
single_file_per_rank = false
