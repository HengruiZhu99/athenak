# Medium-resolution SMR discriminator for open-loop Schwarzschild reference paths.
# Override ref_gh/reference=wormhole for the frozen case, or select one of the
# controlled transition_path values. Controller feedback remains disabled.

<job>
basename = ref_gh_transition_path_medium

<mesh>
nghost = 4
nx1 = 144
x1min = -6.0
x1max = 6.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 144
x2min = -6.0
x2max = 6.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 144
x3min = -6.0
x3max = 6.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 48
nx2 = 48
nx3 = 48

<mesh_refinement>
refinement = static
num_levels = 2
max_nmb_per_rank = 128

<refined_region1>
level = 1
x1min = -2.0
x1max = 2.0
x2min = -2.0
x2max = 2.0
x3min = -2.0
x3max = 2.0

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.05
nlim = -1
tlim = 4.0
ndiag = 10

<ref_gh>
reference = controlled_transition
source = covariant
reference_mass = 1.0
fd_order = 4
debug_task_fences = false
validate_reference_cache = false
max_location_diagnostics = true
controller_enabled = false
transition_path = shrinking_width
transition_width = 0.20
r_core0 = 0.30
tau_core = 1.5
kappa_core = 1.0
tau_transition = 4.0
r_fit_min = 0.15
r_fit_max = 0.40
controller_fit_buffer_cells = 1.0
regularization_outer_start = 0.50
regularization_outer_end = 0.60
controller_zeta = 1.0
controller_omega_q = 0.25
controller_omega_p = 0.25
controller_acceleration_limit = 0.05
controller_delta_bound = 0.25
controller_rate_bound = 0.10
gamma0 = 1.0
diss = 0.02
fail_closed_dt = 1.0e-12

<problem>
pgen_name = ref_gh_controlled_transition
user_hist = true
common_adm_history = true
common_adm_fd_order = 4

<output1>
file_type = hst
dt = 0.05
data_format = %20.15e

<output2>
file_type = rst
dt = 0.50
