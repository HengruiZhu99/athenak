# Diagnostic one-cycle stationary trumpet input with all output hooks disabled.
# It preserves the production equations and timestep parameters and is used only
# to distinguish output/diagnostic kernels from evolution-task kernels.

<job>
basename = ref_gh_stationary_trumpet_no_output

<mesh>
nghost = 4
nx1 = 64
x1min = -2.0
x1max = 2.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -2.0
x2max = 2.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 64
x3min = -2.0
x3max = 2.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 64
nx2 = 64
nx3 = 64

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.05
nlim = 1
tlim = 1.0
ndiag = 10

<ref_gh>
reference = trumpet
source = covariant
reference_mass = 1.0
fd_order = 4
debug_task_fences = true
validate_reference_cache = false
gamma0 = 1.0
diss = 0.02
fail_closed_dt = 1.0e-12

<problem>
pgen_name = ref_gh_stationary_trumpet
common_adm_history = false
common_adm_fd_order = 4
debug_repeat_initial_rhs = false
