# STANDARD-Phi fixed-core reference-motion discriminator.  The base trajectory
# is the established prescribed xi=t/(8M) motion.  The Aurora job restarts the
# same t_f state either with this motion continued or with
# continuation_mode=hard_freeze, continuation_xi=xi_f, and exact xi_dot=0.
# No formulation, gauge, stencil, RK, KO, damping, or blend coefficient differs
# between the two matched restart continuations.

<job>
basename = ref_gh_relative_damped_hard_freeze_outer24

<mesh>
nghost = 4
nx1 = 96
x1min = -24.0
x1max = 24.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 96
x2min = -24.0
x2max = 24.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 96
x3min = -24.0
x3max = 24.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<mesh_refinement>
refinement = static
num_levels = 4
max_nmb_per_rank = 128

<refined_region1>
level = 1
x1min = -12.0
x1max = 12.0
x2min = -12.0
x2max = 12.0
x3min = -12.0
x3max = 12.0

<refined_region2>
level = 2
x1min = -4.0
x1max = 4.0
x2min = -4.0
x2max = 4.0
x3min = -4.0
x3max = 4.0

<refined_region3>
level = 3
x1min = -2.0
x1max = 2.0
x2min = -2.0
x2max = 2.0
x3min = -2.0
x3max = 2.0

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.05
nlim = -1
tlim = 4.2
ndiag = 10

<ref_gh>
reference = controlled_transition
continuation_mode = legacy_time
continuation_self_test = false
transition_path = fixed_core
source = covariant
phi_ordering = standard
reference_mass = 1.0
reference_x = 0.0
reference_y = 0.0
reference_z = 0.0
fd_order = 4
extrap_order = 2
debug_task_fences = false
validate_reference_cache = false
max_location_diagnostics = true
power_mismatch_diagnostics = true

# Exponent feedback remains exactly disabled.
controller_enabled = false
controller_delta_q = 0.0
controller_delta_q_dot = 0.0
controller_delta_p = 0.0
controller_delta_p_dot = 0.0

r_core0 = 0.30
tau_core = 1.5
kappa_core = 1.0
transition_width = 0.20
tau_transition = 8.0
r_fit_min = 0.15
r_fit_max = 0.40
controller_fit_buffer_cells = 1.0
regularization_outer_start = 0.50
regularization_outer_end = 0.60

# Restart overrides set continuation_xi=0.25 and continuation_xi_dot=0 for
# hard_freeze.  These defaults describe the continued legacy-time trajectory.
continuation_xi = 0.0
continuation_xi_dot = 0.0
hard_freeze_reference_already_static = false
hard_freeze_previous_xi_dot = 0.125
hard_freeze_previous_xi_ddot = 0.0
continuation_v_max = 0.25
continuation_tau_v = 0.5
continuation_xi_end_start = 0.90
continuation_risk_slow = 0.70
continuation_risk_stop = 1.0
continuation_condition_stop = 8.0
continuation_lapse_min_stop = 0.5
continuation_lapse_max_stop = 3.0
continuation_v2_stop = 0.20
continuation_gh_warning = 2.0e-2
continuation_reduction_warning = 5.0e-3
continuation_curl_warning = 8.0e-2
continuation_growth_time = 0.5

gamma0 = 1.0
gamma2 = 1.0
gauge_mode = relative_damped
gauge_driver_enabled = false
gauge_reference_subtraction = false
relative_damped_mu_l = 1.0
relative_damped_mu_s = 1.0
relative_damped_r0 = 0.25
relative_damped_r1 = 0.50
exclude_puncture_stencil_diagnostics = true
diss = 0.02
fail_closed_dt = 1.0e-12

<problem>
pgen_name = ref_gh_controlled_transition
user_hist = true
common_adm_history = true
common_adm_fd_order = 4
common_adm_exclude_puncture_stencils = true
common_adm_puncture_x = 0.0
common_adm_puncture_y = 0.0
common_adm_puncture_z = 0.0

<output1>
file_type = hst
dt = 0.02
data_format = %20.15e

<output2>
file_type = rst
dt = 0.25
