<job>
basename = z4c_characteristic_cpbc_plane_pulse

<mesh>
nghost = 4
nx1 = 128
x1min = -8.0
x1max = 8.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 8
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 64
nx2 = 8
nx3 = 8

<mesh_refinement>
refinement = none

<time>
evolution = dynamic
integrator = rk3
cfl_number = 0.2
nlim = -1
tlim = 12.0
ndiag = 1

<mhd>
evolution = dynamic
fixed = true
zero_tmunu_feedback = true
eos = ideal
dyn_eos = ideal
dyn_error = reset_floor
reconstruct = wenoz
rsolver = llf
fofc_method = llf
gamma = 1.3333333333333333
dfloor = 1.0e-16
pfloor = 1.0e-22
dthreshold = 1.0
gamma_max = 10.0
fofc = false

<adm>

<coord>
general_rel = true
is_dynamical = true
minkowski = true
a = 0.0
excise = false

<z4c>
boundary_rhs = characteristic_cpbc
extrap_order = 2
characteristic_bc_diagnostics = true
characteristic_bc_diagnostic_interval = 1
characteristic_bc_max_energy_density = 1.0e-14
use_analytic_background = true
evolve_gauge_residual = true
evolve_lapse_residual = true
evolve_shift_residual = true
residual_gauge = background_adapted
residual_lapse_f = 1.0
residual_lapse_damping = 0.0
residual_shift_damping = 0.0
diss = 0.1
damp_kappa1 = 0.0
damp_kappa2 = 0.0
lapse_harmonic = 0.0
lapse_oplog = 2.0
lapse_advect = 1.0
shift_Gamma = 1.0
shift_advect = 1.0
shift_eta = 0.0

<problem>
pgen_name = z4c_tov_ks
user_hist = true
metric_diag_history = true
pure_background = true
zero_tmunu = true
bh_mass = 0.0
bh_spin = 0.0
bh_center_x1 = 0.0
bh_center_x2 = 0.0
bh_center_x3 = 0.0
use_direct_z4c_background = true
outer_sponge_enabled = false
excision_damp_rate = 0.0
excision_project_state = false
amr_rho_slope_refine = false
amr_bh_exclusion_radius = 0.0
amr_star_refine = false
characteristic_test_family = lapse
characteristic_test_axis = 1
characteristic_test_side = 1
characteristic_test_amplitude = 1.0e-6
characteristic_test_center = 3.0
characteristic_test_width = 0.5
characteristic_test_oblique = false
characteristic_test_oblique_dimensions = 3
characteristic_test_transverse_width = 1.0

<output1>
file_type = hst
dt = 0.1
data_format = %20.15e

<output2>
file_type = log
dcycle = 10

<output3>
file_type = bin
variable = z4c_residual
dt = 12.0
single_file_per_rank = true
