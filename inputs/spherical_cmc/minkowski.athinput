# Regular-center, vacuum CMC/Dirac radial experiment. See docs/spherical_cmc.tex.
<job>
basename=cmc
<mesh>
nx1=64
nx2=1
nx3=1
nghost=2
x1min=0
x1max=1
x2min=-0.5
x2max=0.5
x3min=-0.5
x3max=0.5
ix1_bc=outflow
ox1_bc=outflow
<meshblock>
nx1=64
nx2=1
nx3=1
<time>
evolution=dynamic
integrator=rk3
cfl_number=0.4
tlim=1
nlim=-1
ndiag=100
<spherical_cmc>
metric_pulse=0.05
dirac_damping=1
mass=0
state_version=1
<problem>
pgen_name=spherical_cmc
<output1>
file_type=tab
variable=spherical_cmc
ghost_zones=false
dt=0.1
data_format=%24.16e
<output2>
file_type=hst
dt=0.1
data_format=%24.16e
<output3>
file_type=rst
single_file_per_rank=false
dt=0.5
