+  ReferenceResidualValue conformal_gamma[3];  // NOLINT(runtime/arrays)
+  for (int i = 0; i < 3; ++i) {
+    conformal_gamma[i] = ReferenceResidualConstant(0.0);
+    for (int j = 0; j < 3; ++j) {
+      for (int k = 0; k < 3; ++k) {
