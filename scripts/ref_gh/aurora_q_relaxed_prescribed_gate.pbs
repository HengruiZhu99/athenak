#!/bin/bash -l
# Prescribed-q moving-reference qualification for the finite-h q controller.
# Submit one job from a fresh clean campaign checkout; large outputs stay on
# Aurora and only compact histories/logs are packaged after review.
#PBS -A CompactBinaryMerger
#PBS -q debug
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -N refgh_q_prescribed
#PBS -j oe

set -euo pipefail

: "${CAMPAIGN_ROOT:?submit with CAMPAIGN_ROOT=<fresh absolute path>}"
: "${EXPECTED_COMMIT:?submit with EXPECTED_COMMIT=<full source SHA>}"
SRC="${CAMPAIGN_ROOT}/src"
BUILD="${CAMPAIGN_ROOT}/build_${EXPECTED_COMMIT:0:12}"
OUT="${CAMPAIGN_ROOT}/runs/prescribed_gate_${PBS_JOBID}"
EXE="${BUILD}/src/athena"
REFERENCE_INPUT="${SRC}/tst/inputs/ref_gh_q_controlled_reference.athinput"
PULSE_INPUT="${SRC}/tst/inputs/ref_gh_q_controlled_trumpet_prescribed.athinput"

mkdir -p "${OUT}"
cd "${OUT}"
source "${HOME}/athenak_env"
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export FI_MR_CACHE_MONITOR=disabled
export FI_LOG_LEVEL=ERROR

actual_commit=$(git -C "${SRC}" rev-parse HEAD)
test "${actual_commit}" = "${EXPECTED_COMMIT}"
test -z "$(git -C "${SRC}" status --porcelain)"
{
  date -Is
  hostname
  qstat -f "${PBS_JOBID}"
  echo "source_commit=${actual_commit}"
  git -C "${SRC}" status --short --branch
  git -C "${SRC}" submodule status
  icpx --version | head -1
  mpicxx --version | head -1
  cmake --version | head -1
  env | grep -E '^(ONEAPI_DEVICE_SELECTOR|ZE_|MPICH_GPU|FI_)' | sort
  sha256sum "${REFERENCE_INPUT}" "${PULSE_INPUT}" "$0"
} > provenance.txt

cmake -S "${SRC}" -B "${BUILD}" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER="$(command -v icx)" \
  -DCMAKE_CXX_COMPILER="$(command -v icpx)" \
  -DAthena_ENABLE_MPI=ON \
  -DAthena_ENABLE_OPENMP=OFF \
  -DKokkos_ENABLE_SERIAL=ON \
  -DKokkos_ENABLE_OPENMP=OFF \
  -DKokkos_ENABLE_SYCL=ON \
  -DKokkos_ARCH_INTEL_PVC=ON \
  -DKokkos_ENABLE_DEBUG_BOUNDS_CHECK=OFF \
  -DPROBLEM=built_in_pgens > configure.log 2>&1
cmake --build "${BUILD}" -j 64 > build.log 2>&1
{
  grep -E 'CMAKE_(C|CXX)_COMPILER:|CMAKE_BUILD_TYPE:|Athena_ENABLE_MPI:|Athena_ENABLE_OPENMP:|Kokkos_ENABLE_(SYCL|SERIAL|OPENMP|DEBUG_BOUNDS_CHECK):|Kokkos_ARCH_INTEL_PVC:|PROBLEM:' "${BUILD}/CMakeCache.txt"
  sha256sum "${EXE}"
} >> provenance.txt

mpiexec -n 12 --ppn 12 --depth=8 --cpu-bind depth \
  gpu_tile_compact.sh bash -lc '
    echo "host=$(hostname) rank=${PALS_RANKID:-unset} local_rank=${PALS_LOCAL_RANKID:-unset} ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-unset}"
    sycl-ls 2>&1 | grep "Data Center GPU Max"
  ' > rank_gpu_mapping.txt 2>&1
test "$(grep -c '^host=' rank_gpu_mapping.txt)" -eq 12
test "$(grep '^host=' rank_gpu_mapping.txt | sed -n 's/.*ZE_AFFINITY_MASK=\([^ ]*\).*/\1/p' | sort -u | wc -l)" -eq 12

# Analytic provider, reprojection, gauge, scalar-ODE, and cache gates on PVC.
mkdir source_unit
cd source_unit
mpiexec -n 1 --ppn 1 --depth=8 --cpu-bind depth \
  gpu_tile_compact.sh "${EXE}" -i "${REFERENCE_INPUT}" \
  > source_unit.log 2>&1
grep -q 'q-controlled trumpet provider passed' source_unit.log
grep -q 'q-controlled trumpet reprojection passed' source_unit.log
grep -q 'q-controlled gauge reprojection passed' source_unit.log
grep -q 'q-controller manufactured histories passed' source_unit.log
grep -q 'production cache oracle conditioned scaled Linf' source_unit.log
cd "${OUT}"

run_pulse() {
  local tag="$1"
  local target="$2"
  local duration="$3"
  local tlim="$4"
  local ncell="$5"
  local ranks="$6"
  local directory="${OUT}/${tag}_n${ncell}_t${tlim}"
  mkdir -p "${directory}"
  cd "${directory}"
  mpiexec -n "${ranks}" --ppn "${ranks}" --depth=8 --cpu-bind depth \
    gpu_tile_compact.sh "${EXE}" -i "${PULSE_INPUT}" \
    mesh/nx1="${ncell}" mesh/nx2="${ncell}" mesh/nx3="${ncell}" \
    mesh/x1min=-0.5 mesh/x1max=0.5 \
    mesh/x2min=-0.5 mesh/x2max=0.5 \
    mesh/x3min=-0.5 mesh/x3max=0.5 \
    meshblock/nx1=8 meshblock/nx2=8 meshblock/nx3=8 \
    ref_gh/q_prescribed_target="${target}" \
    ref_gh/q_prescribed_duration="${duration}" \
    ref_gh/validate_reference_cache=false \
    time/tlim="${tlim}" output1/dt=0.05 output2/dt=100.0 \
    job/basename="${tag}_n${ncell}_t${tlim}" > run.log 2>&1
  grep -q 'Terminating on time limit' run.log
  ! grep -Eiq 'FATAL ERROR|(^|[^[:alnum:]_])(nan|[-+]?inf)([^[:alnum:]_]|$)' run.log
}

# Complete all four prescribed excursions on the h=M/16 grid.
run_pulse q090 0.90 4.0 4.0 16 8
run_pulse q110 1.10 4.0 4.0 16 8
run_pulse q075 0.75 8.0 8.0 16 8
run_pulse q125 1.25 8.0 8.0 16 8

# At the small-pulse extrema, compare the same physical trumpet at all three
# required resolutions.  The h=M/16 endpoints above retain complete-return
# evidence; these midpoint runs provide like-time fixed-region convergence.
run_pulse q090_peak 0.90 4.0 2.0 16 8
run_pulse q090_peak 0.90 4.0 2.0 24 12
run_pulse q090_peak 0.90 4.0 2.0 32 12
run_pulse q110_peak 1.10 4.0 2.0 16 8
run_pulse q110_peak 1.10 4.0 2.0 24 12
run_pulse q110_peak 1.10 4.0 2.0 32 12

cd "${OUT}"
{
  echo 'result=PASS_EXECUTION_ONLY'
  echo 'scientific_analysis=pending'
  echo 'complete_coarse_pulses=q090,q110,q075,q125'
  echo 'three_resolution_peak_ladders=q090,q110'
  sha256sum "${EXE}"
} > gate_status.txt
find . -type f \( -name '*.log' -o -name '*.txt' -o -name '*.hst' \
  -o -name '*-trumpet.dat' \) -print0 | sort -z | xargs -0 sha256sum \
  > compact_sha256.txt
