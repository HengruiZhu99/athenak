#!/bin/bash -l
# Resume the verified 64/96/128 Ref-GH trumpet checkpoints from t=1 to t=20.
#PBS -A CompactBinaryMerger
#PBS -q capacity
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=14:00:00
#PBS -l filesystems=home:flare
#PBS -N refgh_t20_8r
#PBS -j oe

set -euo pipefail

ROOT=/lus/flare/projects/CompactBinaryMerger/hzhu/refgh_reference_cache_task_20260820
SRC="${ROOT}/athenak"
BUILD="${ROOT}/build_sycl_pvc_8770307.aurora-pbs-0001.hostmgmt.cm.aurora.alcf.anl.gov"
BUILD_SOURCE_COMMIT=6eed3d9d6fb5d31ee8f240a771e18bfc220a0701
EXE="${BUILD}/src/athena"
INPUT="${SRC}/inputs/ref_gh/ref_gh_stationary_trumpet.athinput"
T1="${ROOT}/runs/cache_t1_eight_rank_8770508.aurora-pbs-0001.hostmgmt.cm.aurora.alcf.anl.gov"
OUT="${ROOT}/runs/stationary_t20_${PBS_JOBID}"

mkdir -p "${OUT}"
cd "${OUT}"

source "${HOME}/athenak_env"
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export FI_MR_CACHE_MONITOR=disabled
export FI_LOG_LEVEL=ERROR

git -C "${SRC}" diff --quiet "${BUILD_SOURCE_COMMIT}" HEAD -- src inputs

{
  date -Is
  hostname
  qstat -f "${PBS_JOBID}"
  git -C "${SRC}" rev-parse HEAD
  echo "build_source_commit=${BUILD_SOURCE_COMMIT}"
  git -C "${SRC}" status --short
  git -C "${SRC}" submodule status
  sha256sum "${EXE}"
  icpx --version | head -1
  grep -E 'CMAKE_(C|CXX)_COMPILER:|CMAKE_BUILD_TYPE:|Athena_ENABLE_MPI:|Athena_ENABLE_OPENMP:|Kokkos_ENABLE_(SYCL|SERIAL|OPENMP|DEBUG_BOUNDS_CHECK):|Kokkos_ARCH_INTEL_PVC:|PROBLEM:' "${BUILD}/CMakeCache.txt"
} > provenance.txt

mpiexec -n 8 --ppn 8 --depth=16 --cpu-bind depth \
  gpu_tile_compact.sh bash -lc '
    echo "host=$(hostname) rank=${PALS_RANKID:-unset} local_rank=${PALS_LOCAL_RANKID:-unset} ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-unset}"
    sycl-ls 2>&1 | grep "Data Center GPU Max"
  ' > rank_gpu_mapping.txt 2>&1

run_case() (
  local label="$1"
  local ncell="$2"
  local mbcell="$3"
  local checkpoint="$4"
  local work="${OUT}/${label}"
  test -s "${checkpoint}"
  mkdir -p "${work}"
  cd "${work}"
  sha256sum "${checkpoint}" > input_checkpoint.sha256
  /usr/bin/time -p mpiexec -n 8 --ppn 8 --depth=16 --cpu-bind depth \
    gpu_tile_compact.sh "${EXE}" -r "${checkpoint}" -i "${INPUT}" \
    job/basename="${label}" \
    mesh/nx1="${ncell}" mesh/nx2="${ncell}" mesh/nx3="${ncell}" \
    meshblock/nx1="${mbcell}" meshblock/nx2="${mbcell}" meshblock/nx3="${mbcell}" \
    ref_gh/debug_task_fences=false \
    ref_gh/validate_reference_cache=false \
    output1/dt=0.2 output2/dt=2.0 \
    time/nlim=-1 time/tlim=20.0 \
    > "${label}.log" 2>&1
  test -s "${label}.ref_gh.hst"
  awk 'BEGIN {reached=0} !/^#/ && $1 >= 19.99999999 {reached=1} END {exit !reached}' \
    "${label}.ref_gh.hst"
  test -n "$(find rst -maxdepth 1 -type f -name '*.rst' -print -quit)"
  ! grep -Eiq 'NotPresent|page fault|SYCL exception|(^|[^[:alpha:]])(nan|inf)([^[:alpha:]]|$)' \
    "${label}.log"
  grep 'reference-GH stationary trumpet:' "${label}.log" | tail -1
)

# Run the most expensive member first so a scheduler interruption cannot erase
# the hardest completed checkpoint chain.
run_case ref_gh_stationary_trumpet_dx32_t20_8r 128 64 \
  "${T1}/ref_gh_stationary_trumpet_dx32_t1_8r/rst/ref_gh_stationary_trumpet_dx32_t1_8r.00002.rst" \
  > dx32_status.txt
run_case ref_gh_stationary_trumpet_dx24_t20_8r 96 48 \
  "${T1}/ref_gh_stationary_trumpet_dx24_t1_8r/rst/ref_gh_stationary_trumpet_dx24_t1_8r.00002.rst" \
  > dx24_status.txt
run_case ref_gh_stationary_trumpet_dx16_t20_8r 64 32 \
  "${T1}/ref_gh_stationary_trumpet_dx16_t1_8r/rst/ref_gh_stationary_trumpet_dx16_t1_8r.00002.rst" \
  > dx16_status.txt

cat dx16_status.txt dx24_status.txt dx32_status.txt > case_status.txt
