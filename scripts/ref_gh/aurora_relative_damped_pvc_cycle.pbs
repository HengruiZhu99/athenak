#!/bin/bash -l
# Bounded 12-rank/12-tile portability gate for the relative-damped Ref-GH gauge.
# This job builds a clean exact commit staged under CAMPAIGN_ROOT/src and
# evolves one RK4 cycle of the 96^3 exact q=1 stationary trumpet.  The source
# must be staged from a login node because compute nodes have no GitHub route.
# It is not a stability test.
#PBS -A CompactBinaryMerger
#PBS -q debug
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -N refgh_relg_pvc
#PBS -j oe

set -euo pipefail

: "${CAMPAIGN_ROOT:?submit with a fresh absolute CAMPAIGN_ROOT}"
: "${EXPECTED_COMMIT:?submit with the full source SHA}"
: "${SOURCE_BRANCH:?submit with the source branch name}"

readonly SRC="${CAMPAIGN_ROOT}/src"
readonly BUILD="${CAMPAIGN_ROOT}/build_${PBS_JOBID}"
readonly OUT="${CAMPAIGN_ROOT}/pvc_cycle_${PBS_JOBID}"
readonly EXE="${BUILD}/src/athena"

mkdir -p "${CAMPAIGN_ROOT}" "${OUT}"
cd "${OUT}"
exec > >(tee -a bootstrap.log) 2>&1
trap 'status=$?; echo "pvc_gate_failure status=${status} line=${LINENO} command=${BASH_COMMAND}"; exit "${status}"' ERR

echo "bootstrap_begin=$(date -Is)"
source "${HOME}/athenak_env"
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export FI_MR_CACHE_MONITOR=disabled
export FI_LOG_LEVEL=ERROR
readonly BINDER=$(command -v gpu_tile_compact.sh)
test -x "${BINDER}"

test -d "${SRC}/.git"
test -f "${SRC}/kokkos/CMakeLists.txt"
test "$(git -C "${SRC}" rev-parse HEAD)" = "${EXPECTED_COMMIT}"
test -z "$(git -C "${SRC}" status --porcelain)"

readonly INPUT="${SRC}/inputs/ref_gh/ref_gh_relative_damped_stationary_trumpet.athinput"
{
  date -Is
  hostname
  qstat -f "${PBS_JOBID}"
  echo "campaign_root=${CAMPAIGN_ROOT}"
  echo "source_branch=${SOURCE_BRANCH}"
  echo "source_commit=${EXPECTED_COMMIT}"
  echo "ranks=12"
  echo "tiles=12"
  echo "grid=96x96x96"
  echo "meshblocks=216"
  echo "cycles=1"
  echo "gpu_tile_binder=${BINDER}"
  git -C "${SRC}" status --short --branch
  git -C "${SRC}" submodule status
  module list 2>&1
  icpx --version | head -1
  mpicxx --version | head -1
  cmake --version | head -1
  env | grep -E '^(ONEAPI_DEVICE_SELECTOR|ZE_|MPICH_GPU|FI_)' | sort
  sha256sum "${INPUT}" "$0"
} > provenance.txt

cmake -S "${SRC}" -B "${BUILD}" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER="$(command -v icx)" \
  -DCMAKE_CXX_COMPILER="$(command -v icpx)" \
  -DAthena_ENABLE_MPI=ON \
  -DAthena_ENABLE_OPENMP=OFF \
  -DKokkos_ENABLE_SERIAL=ON \
  -DKokkos_ENABLE_OPENMP=OFF \
  -DKokkos_ENABLE_SYCL=ON \
  -DKokkos_ARCH_INTEL_PVC=ON \
  -DKokkos_ENABLE_DEBUG_BOUNDS_CHECK=OFF \
  -DPROBLEM=built_in_pgens > configure.log 2>&1
cmake --build "${BUILD}" --verbose -j 64 > build.log 2>&1

{
  grep -E 'CMAKE_(C|CXX)_COMPILER:|CMAKE_BUILD_TYPE:|Athena_ENABLE_MPI:|Athena_ENABLE_OPENMP:|Kokkos_ENABLE_(SYCL|SERIAL|OPENMP|DEBUG_BOUNDS_CHECK):|Kokkos_ARCH_INTEL_PVC:|PROBLEM:' \
    "${BUILD}/CMakeCache.txt"
  grep -R -n -- '-fsycl-device-code-split=per_kernel' \
    "${BUILD}/src/CMakeFiles/athena.dir"
  sha256sum "${BUILD}/CMakeCache.txt" "${EXE}"
} >> provenance.txt
grep -q '^Athena_ENABLE_MPI:BOOL=ON$' "${BUILD}/CMakeCache.txt"
grep -q '^Kokkos_ENABLE_SYCL:BOOL=ON$' "${BUILD}/CMakeCache.txt"
grep -q '^Kokkos_ARCH_INTEL_PVC:BOOL=ON$' "${BUILD}/CMakeCache.txt"
grep -q -- '-fsycl-device-code-split=per_kernel' \
  "${BUILD}/src/CMakeFiles/athena.dir/flags.make"
grep -q -- '-fsycl-device-code-split=per_kernel' \
  "${BUILD}/src/CMakeFiles/athena.dir/link.txt"

mpiexec -n 12 --ppn 12 --depth=8 --cpu-bind depth \
  "${BINDER}" bash -lc '
    echo "host=$(hostname) rank=${PALS_RANKID:-unset} local_rank=${PALS_LOCAL_RANKID:-unset} ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-unset}"
    sycl-ls 2>&1 | grep "Data Center GPU Max"
  ' > rank_gpu_mapping.txt 2>&1
test "$(grep -c '^host=' rank_gpu_mapping.txt)" -eq 12
test "$(grep '^host=' rank_gpu_mapping.txt \
  | sed -n 's/.*ZE_AFFINITY_MASK=\([^ ]*\).*/\1/p' \
  | sort -u | wc -l)" -eq 12

mkdir run
cd run
/usr/bin/time -p mpiexec -n 12 --ppn 12 --depth=8 --cpu-bind depth \
  "${BINDER}" "${EXE}" -i "${INPUT}" \
  job/basename=refgh_relative_damped_pvc_cycle \
  ref_gh/debug_task_fences=true \
  time/nlim=1 time/tlim=1.0 \
  output1/dt=0.001 output2/dt=-1 \
  > run.log 2>&1

grep -q 'Root grid = 6 x 6 x 6 MeshBlocks' run.log
grep -q 'Total number of MeshBlocks = 216' run.log
grep -q 'Number of parallel ranks = 12' run.log
grep -q 'reference-GH initial RHS sector decomposition passed:' run.log
grep -q 'reference-GH stationary trumpet:' run.log
! grep -Eiq 'FATAL ERROR|NotPresent|page fault|SYCL exception|(^|[^[:alnum:]_])(nan|[-+]?inf)([^[:alnum:]_]|$)' run.log

python3 - refgh_relative_damped_pvc_cycle.ref_gh.hst \
  refgh_relative_damped_pvc_cycle.ref_gh_rhs_sectors.tsv \
  > ../gate_status.txt <<'PY'
import math
import pathlib
import sys

history = pathlib.Path(sys.argv[1])
sectors = pathlib.Path(sys.argv[2])
rows = [
    [float(token) for token in line.split()]
    for line in history.read_text(encoding="utf-8").splitlines()
    if line and not line.startswith("#")
]
if len(rows) < 2 or not rows[-1][0] > 0.0:
    raise SystemExit("one evolved history row was not written")
if not all(math.isfinite(value) for row in rows for value in row):
    raise SystemExit("nonfinite history value")
if rows[0][31] != 0.0 or rows[0][32] != 0.0 or rows[0][33] != 0.0:
    raise SystemExit("matched relative gauge is not exactly zero initially")

sector_rows = {}
for line in sectors.read_text(encoding="utf-8").splitlines():
    if not line or line.startswith("#") or line.startswith("sector"):
        continue
    fields = line.split("\t")
    sector_rows[(fields[0], fields[1])] = float(fields[2])
for family in ("Hhat", "theta", "Upsilon"):
    if sector_rows[("actual", family)] != 0.0:
        raise SystemExit(f"nonzero retained-driver RHS for {family}")

print("classification=PASS_PVC_ONE_CYCLE")
print(f"initial_time={rows[0][0]:.17e}")
print(f"final_time={rows[-1][0]:.17e}")
print(f"final_GH_L2sq={rows[-1][2]:.17e}")
print(f"final_reduction_L2sq={rows[-1][3]:.17e}")
print(f"final_curl_L2sq={rows[-1][4]:.17e}")
print(f"final_relative_D_Linf={rows[-1][31]:.17e}")
print(f"final_relative_WD_Linf={rows[-1][32]:.17e}")
print(f"final_relative_source_Linf={rows[-1][33]:.17e}")
print("retained_driver_rhs_exact_zero=true")
print("claim_boundary=one PVC RK4 cycle only; no stability or convergence claim")
PY

cd ..
sha256sum provenance.txt rank_gpu_mapping.txt gate_status.txt \
  run/run.log run/*.hst run/*.tsv > compact_sha256.txt
echo "pvc_gate_complete=$(date -Is)"
