#!/bin/bash -l
# Isolate Ref-GH history diagnostics from restart output on two Aurora PVC tiles.
#PBS -A CompactBinaryMerger
#PBS -q debug
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:20:00
#PBS -l filesystems=home:flare
#PBS -N refgh_out_iso
#PBS -j oe

set -euo pipefail

ROOT=/lus/flare/projects/CompactBinaryMerger/hzhu/refgh_aurora_stationary_frozen_20260819
SRC="${ROOT}/athenak"
BUILD="${ROOT}/build_sycl_pvc_bounds_20260819"
EXE="${BUILD}/src/athena"
INPUT="${SRC}/inputs/ref_gh/ref_gh_stationary_trumpet.athinput"
BINDER="${SRC}/scripts/ref_gh/aurora_gpu_tile_slot.sh"
OUT="${ROOT}/runs/output_isolation_${PBS_JOBID}"

mkdir -p "${OUT}"
cd "${OUT}"

source "$HOME/athenak_env"
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export FI_MR_CACHE_MONITOR=disabled
export FI_LOG_LEVEL=ERROR

{
  date -Is
  hostname
  qstat -f "${PBS_JOBID}"
  sha256sum "${EXE}"
  git -C "${SRC}" rev-parse HEAD
  git -C "${SRC}" status --short
} > provenance.txt

run_case() {
  local slot="$1"
  local label="$2"
  local disabled_output="$3"
  local common_history="$4"
  local work="${OUT}/${label}"
  mkdir -p "${work}"
  cd "${work}"
  /usr/bin/time -p mpiexec -n 1 --ppn 1 --depth=16 --cpu-bind depth \
    "${BINDER}" "${slot}" "${EXE}" -i "${INPUT}" \
    job/basename="${label}" \
    mesh/nx1=64 mesh/nx2=64 mesh/nx3=64 \
    meshblock/nx1=64 meshblock/nx2=64 meshblock/nx3=64 \
    ref_gh/debug_task_fences=true problem/common_adm_history="${common_history}" \
    "${disabled_output}"=-1 time/nlim=1 time/tlim=1.0 \
    > "${label}.log" 2>&1
}

run_case 0.0 history_only output2/dt true &
history_pid=$!
run_case 0.1 restart_only output1/dt false &
restart_pid=$!

status=0
wait "${history_pid}" || status=1
wait "${restart_pid}" || status=1
exit "${status}"
