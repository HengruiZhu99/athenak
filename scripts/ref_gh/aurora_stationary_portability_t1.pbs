#!/bin/bash -l
# Three-resolution stationary-trumpet t=1 convergence gate on separate PVC tiles.
#PBS -A CompactBinaryMerger
#PBS -q debug
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -N refgh_split_t1
#PBS -j oe

set -euo pipefail

ROOT=/lus/flare/projects/CompactBinaryMerger/hzhu/refgh_aurora_stationary_frozen_20260819
SRC="${ROOT}/athenak"
BUILD="${ROOT}/build_sycl_pvc_bounds_20260819"
EXE="${BUILD}/src/athena"
INPUT="${SRC}/inputs/ref_gh/ref_gh_stationary_trumpet.athinput"
BINDER="${SRC}/scripts/ref_gh/aurora_gpu_tile_slot.sh"
OUT="${ROOT}/runs/portability_t1_${PBS_JOBID}"

mkdir -p "${OUT}"
cd "${OUT}"

source "$HOME/athenak_env"
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export FI_MR_CACHE_MONITOR=disabled
export FI_LOG_LEVEL=ERROR

{
  date -Is
  hostname
  qstat -f "${PBS_JOBID}"
  sha256sum "${EXE}"
  git -C "${SRC}" rev-parse HEAD
  git -C "${SRC}" status --short
  git -C "${SRC}/kokkos" rev-parse HEAD
  icpx --version | head -1
  grep -E "Kokkos_ENABLE_(SYCL|SERIAL|DEBUG_BOUNDS_CHECK)|Kokkos_ARCH_INTEL_PVC|Athena_ENABLE_MPI" \
    "${BUILD}/CMakeCache.txt"
} > provenance.txt

run_case() {
  local slot="$1"
  local label="$2"
  local ncell="$3"
  local mbcell="$4"
  local work="${OUT}/${label}"
  mkdir -p "${work}"
  cd "${work}"
  /usr/bin/time -p mpiexec -n 1 --ppn 1 --depth=16 --cpu-bind depth \
    "${BINDER}" "${slot}" "${EXE}" -i "${INPUT}" \
    job/basename="${label}" \
    mesh/nx1="${ncell}" mesh/nx2="${ncell}" mesh/nx3="${ncell}" \
    meshblock/nx1="${mbcell}" meshblock/nx2="${mbcell}" meshblock/nx3="${mbcell}" \
    ref_gh/debug_task_fences=false time/tlim=1.0 \
    > "${label}.log" 2>&1
}

run_case 0.0 ref_gh_stationary_trumpet_dx16_t1 64 32 &
pid16=$!
run_case 0.1 ref_gh_stationary_trumpet_dx24_t1 96 48 &
pid24=$!
run_case 1.0 ref_gh_stationary_trumpet_dx32_t1 128 64 &
pid32=$!

status=0
wait "${pid16}" || status=1
wait "${pid24}" || status=1
wait "${pid32}" || status=1
exit "${status}"
