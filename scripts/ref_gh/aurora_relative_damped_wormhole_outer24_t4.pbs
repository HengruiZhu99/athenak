#!/bin/bash -l
# N96 fixed-core/tau-8 outer-24M relaxation discriminator through t=4M.
# Eight Aurora nodes reduce the 328-block production tree to 3--4 blocks/tile.
#PBS -A CompactBinaryMerger
#PBS -q debug-scaling
#PBS -l select=8
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -N refgh_worm_o4
#PBS -j oe

set -euo pipefail

: "${CAMPAIGN_ROOT:?submit with the established campaign root}"
: "${QUALIFIED_SOURCE:?submit with the exact PVC-qualified source path}"
: "${QUALIFIED_EXE:?submit with the exact PVC-qualified executable path}"
: "${EXPECTED_SOURCE_COMMIT:?submit with the qualified source SHA}"
: "${EXPECTED_EXE_SHA256:?submit with the qualified executable SHA-256}"
: "${CHECKPOINT_COMMIT:?submit with the input/analysis checkpoint SHA}"
: "${STAGED_INPUT:?submit with the staged outer24 input}"
: "${ANALYZER:?submit with the staged wormhole analysis script}"
: "${PROFILE_ANALYZER:?submit with the staged physical-profile analyzer}"

readonly OUT="${CAMPAIGN_ROOT}/wormhole_fixed_core_outer24_t4_${PBS_JOBID}"
readonly PRIOR_FAILURE_DIR=${PRIOR_FAILURE_DIR:-}

mkdir -p "${OUT}"
cd "${OUT}"
exec > >(tee -a bootstrap.log) 2>&1
trap 'status=$?; echo "wormhole_outer24_t4_error status=${status} line=${LINENO} command=${BASH_COMMAND}"; exit "${status}"' ERR

echo "bootstrap_begin=$(date -Is)"
source "${HOME}/athenak_env"
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export FI_MR_CACHE_MONITOR=disabled
export FI_LOG_LEVEL=ERROR
readonly BINDER=$(command -v gpu_tile_compact.sh)

test -x "${BINDER}"
test -x "${QUALIFIED_EXE}"
test -f "${STAGED_INPUT}"
test -f "${ANALYZER}"
test -f "${PROFILE_ANALYZER}"
test "$(git -C "${QUALIFIED_SOURCE}" rev-parse HEAD)" = "${EXPECTED_SOURCE_COMMIT}"
test -z "$(git -C "${QUALIFIED_SOURCE}" status --porcelain)"
test "$(sha256sum "${QUALIFIED_EXE}" | awk '{print $1}')" = "${EXPECTED_EXE_SHA256}"

{
  date -Is
  hostname
  qstat -f "${PBS_JOBID}"
  echo "campaign_root=${CAMPAIGN_ROOT}"
  echo "qualified_source=${QUALIFIED_SOURCE}"
  echo "qualified_source_commit=${EXPECTED_SOURCE_COMMIT}"
  echo "checkpoint_commit=${CHECKPOINT_COMMIT}"
  echo "qualified_executable=${QUALIFIED_EXE}"
  echo "qualified_executable_sha256=${EXPECTED_EXE_SHA256}"
  echo "nodes=8"
  echo "ranks=96"
  echo "tiles=96"
  echo "grid=root96_mb32_outer24"
  echo "meshblocks=328"
  echo "finest_spacing=0.0625"
  echo "target_time=4.0"
  echo "history_interval=0.05"
  echo "restart_interval=1.0"
  echo "physical_field_times=0,4"
  echo "reference_path=fixed_core"
  echo "tau_transition=8.0"
  echo "prior_failure_dir=${PRIOR_FAILURE_DIR:-none}"
  echo "claim=main-relaxation discriminator only; no settling or long-time claim"
  git -C "${QUALIFIED_SOURCE}" status --short --branch
  git -C "${QUALIFIED_SOURCE}" submodule status
  module list 2>&1
  icpx --version | head -1
  mpicxx --version | head -1
  env | grep -E '^(ONEAPI_DEVICE_SELECTOR|ZE_|MPICH_GPU|FI_)' | sort
  sha256sum "${STAGED_INPUT}" "${ANALYZER}" "${PROFILE_ANALYZER}" "$0"
} > provenance.txt

if test -n "${PRIOR_FAILURE_DIR}"; then
  test -d "${PRIOR_FAILURE_DIR}/run/rst"
  find "${PRIOR_FAILURE_DIR}/run/rst" -type f -name '*.rst' -print0 \
    | sort -z | xargs -0 -r sha256sum > prior_failure_restart_sha256.txt
fi

mpiexec -n 96 --ppn 12 --depth=8 --cpu-bind depth \
  "${BINDER}" bash -lc '
    echo "host=$(hostname) rank=${PALS_RANKID:-unset} local_rank=${PALS_LOCAL_RANKID:-unset} ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-unset}"
  ' > rank_gpu_mapping.txt 2>&1
test "$(grep -c '^host=' rank_gpu_mapping.txt)" -eq 96
test "$(grep '^host=' rank_gpu_mapping.txt | awk '{print $1, $4}' | sort -u | wc -l)" -eq 96
test "$(grep '^host=' rank_gpu_mapping.txt | sed -n 's/^host=\([^ ]*\).*/\1/p' | sort -u | wc -l)" -eq 8

mkdir run
cd run
readonly BASENAME=refgh_relative_damped_wormhole_fixed_core_outer24_n96_t4
set +e
/usr/bin/time -p mpiexec -n 96 --ppn 12 --depth=8 --cpu-bind depth \
  "${BINDER}" "${QUALIFIED_EXE}" -i "${STAGED_INPUT}" \
  job/basename="${BASENAME}" ref_gh/debug_task_fences=false \
  time/nlim=-1 time/tlim=4.0 output1/dt=0.05 output2/dt=1.0 \
  output3/dt=4.0 output4/dt=4.0 output5/dt=4.0 output6/dt=4.0 \
  output7/dt=4.0 > run.log 2>&1
run_status=$?
set -e
{
  echo "run_exit_status=${run_status}"
  echo "run_completed=$(date -Is)"
} > run_status.txt
if test "${run_status}" -ne 0; then
  cd ..
  python3 "${ANALYZER}" \
    --case "n96=${OUT}/run" --spacing n96=0.0625 \
    --target 0 0.2 0.5 1 1.2 1.4 1.6 2 3 4 --target-tolerance 0.04 \
    --outer-distance 24 --late-fit-time 1 \
    --output-prefix "${OUT}/failure_analysis" > failure_analysis.log 2>&1 || true
  find run/rst -type f -name '*.rst' -printf '%s %p\n' \
    | sort -n > failure_restart_locations.txt
  exit "${run_status}"
fi
grep -q 'Total number of MeshBlocks = 328' run.log
grep -q 'Number of parallel ranks = 96' run.log
grep -q 'reference-GH puncture vertex audit passed' run.log
grep -q 'reference-GH controlled Schwarzschild final:' run.log
! grep -Eiq 'FATAL ERROR|NotPresent|page fault|SYCL exception|(^|[^[:alnum:]_])(nan|[-+]?inf)([^[:alnum:]_]|$)' run.log
awk 'BEGIN {ok=0} !/^#/ && $1 >= 4.0 - 1.0e-12 && $22 == 0 {ok=1} END {exit !ok}' \
  "${BASENAME}.ref_gh.hst"
test "$(find rst -type f -name '*.rst' | wc -l)" -ge 4
test "$(find . -type f -name '*.cbin' | wc -l)" -ge 10
find . -type f -name '*.cbin' -print0 \
  | xargs -0 -r grep -a -L -m1 'size of variable=8' \
  | awk 'END {exit NR != 0}'

cd ..
python3 "${ANALYZER}" \
  --case "n96=${OUT}/run" --spacing n96=0.0625 \
  --target 0 0.2 0.5 1 2 4 --target-tolerance 0.04 \
  --outer-distance 24 --late-fit-time 2 \
  --output-prefix "${OUT}/wormhole_outer24_t4" > analysis.log 2>&1
python3 -m json.tool wormhole_outer24_t4.json >/dev/null
python3 "${PROFILE_ANALYZER}" \
  --run-dir "${OUT}/run" --source-root "${QUALIFIED_SOURCE}" \
  --target 0 --target 4 --stencil-radius 3 \
  --output-prefix "${OUT}/wormhole_outer24_profiles" \
  > profile_analysis.log 2>&1
python3 -m json.tool wormhole_outer24_profiles.json >/dev/null

find run/rst -type f -name '*.rst' -print0 \
  | sort -z | xargs -0 -r sha256sum > restart_sha256.txt
find run -type f -name '*.cbin' -print0 \
  | sort -z | xargs -0 -r sha256sum > physical_cbin_sha256.txt
sha256sum provenance.txt rank_gpu_mapping.txt bootstrap.log analysis.log \
  profile_analysis.log wormhole_outer24_profiles.json \
  wormhole_outer24_profiles.tsv \
  wormhole_outer24_t4.json wormhole_outer24_t4.tsv \
  run/run.log run/run_status.txt run/*.hst run/*.tsv \
  restart_sha256.txt physical_cbin_sha256.txt > compact_sha256.txt
echo "wormhole_outer24_t4_complete=$(date -Is)"
