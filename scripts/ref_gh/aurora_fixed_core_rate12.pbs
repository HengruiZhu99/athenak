#!/bin/bash -l
# Phase-5 rate ablation for the fixed-core reference path.  This job reuses a
# provenance-checked executable, maps one rank to every PVC tile, and evaluates
# tau_transition=8M and 16M independently through the t=2.2M and t=4M gates.
#PBS -A CompactBinaryMerger
#PBS -q capacity
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=05:00:00
#PBS -l filesystems=home:flare
#PBS -N refgh_rate12
#PBS -j oe

set -euo pipefail

: "${CAMPAIGN_ROOT:?submit with CAMPAIGN_ROOT=<absolute path>}"
: "${EXPECTED_COMMIT:?submit with EXPECTED_COMMIT=<full source SHA>}"
: "${EXPECTED_EXE_SHA256:?submit with EXPECTED_EXE_SHA256=<sha256>}"

SRC="${CAMPAIGN_ROOT}/src"
BUILD="${CAMPAIGN_ROOT}/build_${EXPECTED_COMMIT:0:12}"
EXE="${BUILD}/src/athena"
INPUT="${SRC}/inputs/ref_gh/ref_gh_transition_path_medium.athinput"
OUT="${CAMPAIGN_ROOT}/runs/fixed_core_rate12_${PBS_JOBID}"

mkdir -p "${OUT}"
cd "${OUT}"
source "${HOME}/athenak_env"
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export FI_MR_CACHE_MONITOR=disabled
export FI_LOG_LEVEL=ERROR

actual_commit=$(git -C "${SRC}" rev-parse HEAD)
actual_exe_sha256=$(sha256sum "${EXE}" | awk '{print $1}')
test "${actual_commit}" = "${EXPECTED_COMMIT}"
test "${actual_exe_sha256}" = "${EXPECTED_EXE_SHA256}"
test -z "$(git -C "${SRC}" status --porcelain --untracked-files=no)"

{
  date -Is
  hostname
  qstat -f "${PBS_JOBID}"
  echo "source_commit=${actual_commit}"
  echo "executable_sha256=${actual_exe_sha256}"
  git -C "${SRC}" status --short --branch
  git -C "${SRC}" submodule status
  icpx --version | head -1
  mpicxx --version | head -1
  env | grep -E '^(ONEAPI_DEVICE_SELECTOR|ZE_|MPICH_GPU|FI_)' | sort
  sha256sum "${INPUT}" "$0"
} > provenance.txt

mpiexec -n 12 --ppn 12 --depth=8 --cpu-bind depth \
  gpu_tile_compact.sh bash -lc '
    echo "host=$(hostname) rank=${PALS_RANKID:-unset} local_rank=${PALS_LOCAL_RANKID:-unset} ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-unset}"
    sycl-ls 2>&1 | grep "Data Center GPU Max"
  ' > rank_gpu_mapping.txt 2>&1
test "$(grep -c '^host=' rank_gpu_mapping.txt)" -eq 12
test "$(grep '^host=' rank_gpu_mapping.txt | sed -n 's/.*ZE_AFFINITY_MASK=\([^ ]*\).*/\1/p' | sort -u | wc -l)" -eq 12

validate_segment() {
  local directory="$1"
  local label="$2"
  local target="$3"
  local status="$4"
  {
    echo "exit_status=${status}"
    echo "target=${target}"
    for history in "${label}.ref_gh.hst" "${label}.user.hst"; do
      if test -s "${directory}/${history}"; then
        echo -n "last_${history}="
        tail -1 "${directory}/${history}"
      fi
    done
  } > "${directory}/segment_status.txt"
  test "${status}" -eq 0 || return 1
  test -s "${directory}/${label}.ref_gh.hst" || return 1
  test -s "${directory}/${label}.user.hst" || return 1
  test -s "${directory}/${label}.ref_gh_maxloc.tsv" || return 1
  awk -v target="${target}" '
    BEGIN {ok=0}
    !/^#/ && $1 >= target-1.e-10 && $2 > 0 && $14 < 0 && $22 == 0 {ok=1}
    END {exit !ok}
  ' "${directory}/${label}.ref_gh.hst" || return 1
  awk '
    BEGIN {ok=1}
    !/^#/ && ($3 != 0 || $5 != 0 || $10 <= 0 || $12 <= 0 || $15 <= 0 || $25 != 0) {ok=0}
    END {exit !ok}
  ' "${directory}/${label}.user.hst" || return 1
  ! grep -Eiq 'NotPresent|page fault|SYCL exception|(^|[^[:alpha:]])(nan|inf)([^[:alpha:]]|$)' \
    "${directory}/${label}.log" || return 1
  return 0
}

run_initial() {
  local label="$1"
  local tau="$2"
  local target=2.2
  local directory="${OUT}/${label}_to_2p2"
  mkdir -p "${directory}"
  cd "${directory}"
  set +e
  /usr/bin/time -p mpiexec -n 12 --ppn 12 --depth=8 --cpu-bind depth \
    gpu_tile_compact.sh "${EXE}" -i "${INPUT}" \
    job/basename="${label}" ref_gh/reference=controlled_transition \
    ref_gh/transition_path=fixed_core ref_gh/tau_transition="${tau}" \
    ref_gh/controller_enabled=false time/tlim="${target}" time/nlim=-1 \
    > "${label}.log" 2>&1
  local status=$?
  set -e
  validate_segment "${directory}" "${label}" "${target}" "${status}" || return 1
  find rst -type f -name '*.rst' | sort | tail -1
}

run_continuation() {
  local label="$1"
  local tau="$2"
  local checkpoint="$3"
  local target=4.0
  local directory="${OUT}/${label}_to_4"
  mkdir -p "${directory}"
  cd "${directory}"
  set +e
  /usr/bin/time -p mpiexec -n 12 --ppn 12 --depth=8 --cpu-bind depth \
    gpu_tile_compact.sh "${EXE}" -r "${checkpoint}" -i "${INPUT}" \
    job/basename="${label}" ref_gh/reference=controlled_transition \
    ref_gh/transition_path=fixed_core ref_gh/tau_transition="${tau}" \
    ref_gh/controller_enabled=false time/tlim="${target}" time/nlim=-1 \
    > "${label}.log" 2>&1
  local status=$?
  set -e
  validate_segment "${directory}" "${label}" "${target}" "${status}"
}

run_rate_to_four() {
  local label="$1"
  local tau="$2"
  local relative_checkpoint
  relative_checkpoint=$(run_initial "${label}" "${tau}") || return 1
  local checkpoint="${OUT}/${label}_to_2p2/${relative_checkpoint}"
  test -s "${checkpoint}" || return 1
  sha256sum "${checkpoint}" > "${OUT}/${label}_to_2p2/checkpoint.sha256"
  run_continuation "${label}" "${tau}" "${checkpoint}"
}

tau8_status=0
run_rate_to_four fixed_core_tau8 8.0 || tau8_status=$?
tau16_status=0
run_rate_to_four fixed_core_tau16 16.0 || tau16_status=$?

cd "${OUT}"
{
  echo "tau8_status=${tau8_status}"
  echo "tau16_status=${tau16_status}"
  echo "controller_enabled=false"
  echo "delta_q=0"
  echo "delta_p=0"
} > rate_decision.txt
find . -type f \( -name '*.hst' -o -name '*.tsv' -o -name '*.txt' \
  -o -name '*.log' -o -name '*.sha256' \) -print0 | sort -z | \
  xargs -0 sha256sum > compact_sha256.txt
test "${tau8_status}" -eq 0
test "${tau16_status}" -eq 0
