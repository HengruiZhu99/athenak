#!/bin/bash -l
# Phase-8 three-resolution gate for the single promoted candidate:
# fixed core, tau_transition=8M, compatible Phi ordering, controller off.
#PBS -A CompactBinaryMerger
#PBS -q capacity
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=05:00:00
#PBS -l filesystems=home:flare
#PBS -N refgh_tau8_res
#PBS -j oe

set -euo pipefail

: "${CAMPAIGN_ROOT:?submit with CAMPAIGN_ROOT=<absolute path>}"
: "${EXPECTED_COMMIT:?submit with EXPECTED_COMMIT=<full source SHA>}"
: "${EXPECTED_EXE_SHA256:?submit with EXPECTED_EXE_SHA256=<sha256>}"
: "${RESOLUTION_LABEL:?coarse, medium, or fine}"
: "${ROOT_N:?96, 144, or 192}"
: "${MB_N:?32, 48, or 64}"

case "${RESOLUTION_LABEL}:${ROOT_N}:${MB_N}" in
  coarse:96:32) expected_dx=0.0625 ;;
  medium:144:48) expected_dx=0.0416666666666666667 ;;
  fine:192:64) expected_dx=0.03125 ;;
  *) echo "invalid resolution tuple" >&2; exit 2 ;;
esac

SRC="${CAMPAIGN_ROOT}/src"
BUILD="${CAMPAIGN_ROOT}/build_${EXPECTED_COMMIT:0:12}"
EXE="${BUILD}/src/athena"
INPUT="${SRC}/inputs/ref_gh/ref_gh_transition_path_medium.athinput"
OUT="${CAMPAIGN_ROOT}/runs/tau8_${RESOLUTION_LABEL}_${PBS_JOBID}"
LABEL="tau8_${RESOLUTION_LABEL}"

mkdir -p "${OUT}"
cd "${OUT}"
source "${HOME}/athenak_env"
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export FI_MR_CACHE_MONITOR=disabled
export FI_LOG_LEVEL=ERROR

actual_commit=$(git -C "${SRC}" rev-parse HEAD)
actual_exe_sha256=$(sha256sum "${EXE}" | awk '{print $1}')
test "${actual_commit}" = "${EXPECTED_COMMIT}"
test "${actual_exe_sha256}" = "${EXPECTED_EXE_SHA256}"
test -z "$(git -C "${SRC}" status --porcelain --untracked-files=no)"
{
  date -Is
  hostname
  qstat -f "${PBS_JOBID}"
  echo "source_commit=${actual_commit}"
  echo "executable_sha256=${actual_exe_sha256}"
  echo "resolution_label=${RESOLUTION_LABEL}"
  echo "root_cells=${ROOT_N}"
  echo "meshblock_cells=${MB_N}"
  echo "expected_dx_min=${expected_dx}"
  echo "expected_finest_extent=[-2M,2M]^3"
  git -C "${SRC}" status --short --branch
  git -C "${SRC}" submodule status
  icpx --version | head -1
  mpicxx --version | head -1
  env | grep -E '^(ONEAPI_DEVICE_SELECTOR|ZE_|MPICH_GPU|FI_)' | sort
  sha256sum "${INPUT}" "$0"
} > provenance.txt

mpiexec -n 12 --ppn 12 --depth=8 --cpu-bind depth \
  gpu_tile_compact.sh bash -lc '
    echo "host=$(hostname) rank=${PALS_RANKID:-unset} local_rank=${PALS_LOCAL_RANKID:-unset} ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-unset}"
    sycl-ls 2>&1 | grep "Data Center GPU Max"
  ' > rank_gpu_mapping.txt 2>&1
test "$(grep -c '^host=' rank_gpu_mapping.txt)" -eq 12
test "$(grep '^host=' rank_gpu_mapping.txt | sed -n 's/.*ZE_AFFINITY_MASK=\([^ ]*\).*/\1/p' | sort -u | wc -l)" -eq 12

set +e
mpiexec -n 1 --ppn 1 --depth=8 --cpu-bind depth \
  gpu_tile_compact.sh "${EXE}" -m -i "${INPUT}" \
  mesh/nx1="${ROOT_N}" mesh/nx2="${ROOT_N}" mesh/nx3="${ROOT_N}" \
  meshblock/nx1="${MB_N}" meshblock/nx2="${MB_N}" meshblock/nx3="${MB_N}" \
  > mesh_structure.txt 2>&1
mesh_status=$?
set -e
echo "mesh_only_exit_status=${mesh_status}" >> mesh_structure.txt
test "${mesh_status}" -eq 0 -o "${mesh_status}" -eq 139
grep -q 'Root grid = 3 x 3 x 3 MeshBlocks' mesh_structure.txt
grep -q 'Total number of MeshBlocks = 34' mesh_structure.txt
grep -q 'Number of physical levels of refinement = 1 (2 levels total)' mesh_structure.txt

validate_segment() {
  local directory="$1"
  local target="$2"
  local status="$3"
  {
    echo "exit_status=${status}"
    echo "target=${target}"
    for history in "${LABEL}.ref_gh.hst" "${LABEL}.user.hst"; do
      if test -s "${directory}/${history}"; then
        echo -n "last_${history}="
        tail -1 "${directory}/${history}"
      fi
    done
  } > "${directory}/segment_status.txt"
  test "${status}" -eq 0 || return 1
  test -s "${directory}/${LABEL}.ref_gh.hst" || return 1
  test -s "${directory}/${LABEL}.user.hst" || return 1
  test -s "${directory}/${LABEL}.ref_gh_maxloc.tsv" || return 1
  awk -v target="${target}" '
    BEGIN {ok=0}
    !/^#/ && $1 >= target-1.e-10 && $2 > 0 && $14 < 0 && $22 == 0 {ok=1}
    END {exit !ok}
  ' "${directory}/${LABEL}.ref_gh.hst" || return 1
  awk '
    BEGIN {ok=1}
    !/^#/ && ($3 != 0 || $5 != 0 || $10 <= 0 || $12 <= 0 || $15 <= 0 || $25 != 0) {ok=0}
    END {exit !ok}
  ' "${directory}/${LABEL}.user.hst" || return 1
  ! grep -Eiq 'NotPresent|page fault|SYCL exception|(^|[^[:alpha:]])(nan|inf)([^[:alpha:]]|$)' \
    "${directory}/${LABEL}.log" || return 1
  return 0
}

run_initial() {
  local target=2.2
  local directory="${OUT}/to_2p2"
  mkdir -p "${directory}"
  cd "${directory}"
  set +e
  /usr/bin/time -p mpiexec -n 12 --ppn 12 --depth=8 --cpu-bind depth \
    gpu_tile_compact.sh "${EXE}" -i "${INPUT}" \
    mesh/nx1="${ROOT_N}" mesh/nx2="${ROOT_N}" mesh/nx3="${ROOT_N}" \
    meshblock/nx1="${MB_N}" meshblock/nx2="${MB_N}" meshblock/nx3="${MB_N}" \
    job/basename="${LABEL}" ref_gh/reference=controlled_transition \
    ref_gh/transition_path=fixed_core ref_gh/tau_transition=8.0 \
    ref_gh/phi_ordering=compatible ref_gh/controller_enabled=false \
    time/tlim="${target}" time/nlim=-1 > "${LABEL}.log" 2>&1
  local status=$?
  set -e
  validate_segment "${directory}" "${target}" "${status}" || return 1
  find rst -type f -name '*.rst' | sort | tail -1
}

run_continuation() {
  local checkpoint="$1"
  local target=4.0
  local directory="${OUT}/to_4"
  mkdir -p "${directory}"
  cd "${directory}"
  set +e
  /usr/bin/time -p mpiexec -n 12 --ppn 12 --depth=8 --cpu-bind depth \
    gpu_tile_compact.sh "${EXE}" -r "${checkpoint}" -i "${INPUT}" \
    mesh/nx1="${ROOT_N}" mesh/nx2="${ROOT_N}" mesh/nx3="${ROOT_N}" \
    meshblock/nx1="${MB_N}" meshblock/nx2="${MB_N}" meshblock/nx3="${MB_N}" \
    job/basename="${LABEL}" ref_gh/reference=controlled_transition \
    ref_gh/transition_path=fixed_core ref_gh/tau_transition=8.0 \
    ref_gh/phi_ordering=compatible ref_gh/controller_enabled=false \
    time/tlim="${target}" time/nlim=-1 > "${LABEL}.log" 2>&1
  local status=$?
  set -e
  validate_segment "${directory}" "${target}" "${status}"
}

relative_checkpoint=$(run_initial)
checkpoint="${OUT}/to_2p2/${relative_checkpoint}"
test -s "${checkpoint}"
sha256sum "${checkpoint}" > "${OUT}/to_2p2/checkpoint.sha256"
run_continuation "${checkpoint}"

cd "${OUT}"
{
  echo "resolution=${RESOLUTION_LABEL}"
  echo "dx_min=${expected_dx}"
  echo "candidate=fixed_core_tau8_compatible"
  echo "controller_enabled=false"
  echo "delta_q=0"
  echo "delta_p=0"
  echo "result=PASS"
} > resolution_status.txt
find . -type f \( -name '*.hst' -o -name '*.tsv' -o -name '*.txt' \
  -o -name '*.log' -o -name '*.sha256' \) -print0 | sort -z | \
  xargs -0 sha256sum > compact_sha256.txt
