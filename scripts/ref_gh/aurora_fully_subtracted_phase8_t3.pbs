#!/bin/bash -l
# Gate 8A: frozen 96^3 STANDARD fully-subtracted stationary trumpet to 3M.
# Uses the already-qualified target-scoped SYCL executable; no generic preflight.
#PBS -A CompactBinaryMerger
#PBS -q debug-scaling
#PBS -l select=3
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -N refgh_sub_t3
#PBS -j oe

set -euo pipefail

: "${CAMPAIGN_ROOT:?existing PVC regression campaign root}"
: "${SOURCE_LABEL:?immutable qualified source label}"
: "${EXPECTED_COMMIT:?qualified source commit}"
: "${EXPECTED_TREE:?qualified source tree}"
: "${QUALIFIED_EXE:?qualified one-cycle executable}"
: "${EXPECTED_EXE_SHA256:?qualified executable SHA-256}"

readonly SRC="${CAMPAIGN_ROOT}/sources/${SOURCE_LABEL}"
readonly INPUT="${SRC}/inputs/ref_gh/ref_gh_ordering_gauge_case_d.athinput"
readonly ANALYZE="${SRC}/scripts/ref_gh/analyze_fully_subtracted_phase8.py"
readonly CONTROL_ROOT="${SRC}/artifacts/ref_gh_ordering_gauge_discriminator_20260829/phase67_aurora_8790947"
readonly CONTROL_A="${CONTROL_ROOT}/case_a_t5_fresh/case_a_t5_fresh.ref_gh.hst"
readonly CONTROL_B="${CONTROL_ROOT}/case_b_t5_fresh/case_b_t5_fresh.ref_gh.hst"
readonly EXPECTED_INPUT_SHA256=6d483ded11b70d640f4a166fd21757f956802622d4e3994ceda71ae8649235eb
readonly OUT="${CAMPAIGN_ROOT}/runs/phase8_t3_${PBS_JOBID}"
readonly BASENAME=refgh_fully_subtracted_t3
readonly NRANKS=36
readonly PPN=12

mkdir -p "${OUT}"
cd "${OUT}"
exec > >(tee -a bootstrap.log) 2>&1
trap 'status=$?; echo "phase8_t3_failure status=${status} line=${LINENO} command=${BASH_COMMAND}"; exit "${status}"' ERR

source "${HOME}/athenak_env"
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export FI_MR_CACHE_MONITOR=disabled
export FI_LOG_LEVEL=ERROR
readonly BINDER=$(command -v gpu_tile_compact.sh)
test -x "${BINDER}"

test "$(cat "${SRC}/.source_commit")" = "${EXPECTED_COMMIT}"
test "$(cat "${SRC}/.source_tree")" = "${EXPECTED_TREE}"
test "$(cat "${SRC}/.kokkos_commit")" = \
  6739bc623081648af9e752b616d9671527922cbf
test -x "${QUALIFIED_EXE}"
test "$(sha256sum "${QUALIFIED_EXE}" | awk '{print $1}')" = \
  "${EXPECTED_EXE_SHA256}"
test "$(sha256sum "${INPUT}" | awk '{print $1}')" = \
  "${EXPECTED_INPUT_SHA256}"
test -s "${ANALYZE}"
test -s "${CONTROL_A}"
test -s "${CONTROL_B}"

# Fail closed if the frozen Case-D formulation or numerics drifted.
for required in \
  'nx1 = 96' 'x1min = -2.0' 'x1max = 2.0' 'nghost = 4' \
  'integrator = rk4' 'cfl_number = 0.05' \
  'reference_backend = analytic_radial_q' 'phi_ordering = standard' \
  'q = 1.0' 'q_controller_enabled = false' \
  'q_prescribed_enabled = false' 'fd_order = 4' \
  'gamma0 = 1.0' 'gamma2 = 1.0' 'gauge_driver_enabled = true' \
  'gauge_reference_subtraction = true' 'gauge_mu = 1.0' \
  'gauge_eta = 1.0' 'shift_nu = 0.75' 'shift_eta = 1.0' \
  'exclude_puncture_stencil_diagnostics = true' 'diss = 0.02' \
  'common_adm_exclude_puncture_stencils = true'; do
  grep -Fqx "${required}" "${INPUT}"
done

{
  date -Is
  hostname
  qstat -f "${PBS_JOBID}"
  echo "campaign_root=${CAMPAIGN_ROOT}"
  echo "source_label=${SOURCE_LABEL}"
  echo "source_commit=${EXPECTED_COMMIT}"
  echo "source_tree=${EXPECTED_TREE}"
  echo "purpose=Gate 8A frozen fully-subtracted STANDARD evolution to 3M"
  echo "grid=96x96x96 meshblocks=216 ranks=${NRANKS} blocks_per_rank=6"
  echo "frozen_parameters=STANDARD gamma0=1 gamma2=1 gauge-on gauge-reference-subtraction-on q=1 q-controller-off q-prescribed-off FD4 RK4 CFL=0.05 KO=0.02"
  echo "history_dt=0.01 checkpoint_dt=0.5"
  echo "claim_boundary=3M Gate 8A only"
  module list 2>&1
  icpx --version | head -1
  mpicxx --version | head -1
  env | grep -E '^(ONEAPI_DEVICE_SELECTOR|ZE_|MPICH_GPU|FI_)' | sort
  sha256sum "${HOME}/athenak_env" "$0" "${INPUT}" "${ANALYZE}" \
    "${CONTROL_A}" "${CONTROL_B}" "${QUALIFIED_EXE}"
} > provenance.txt

mpiexec -n "${NRANKS}" --ppn "${PPN}" --depth=8 --cpu-bind depth \
  "${BINDER}" bash -lc '
    echo "host=$(hostname) rank=${PALS_RANKID:-unset} local_rank=${PALS_LOCAL_RANKID:-unset} ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-unset}"
    sycl-ls 2>&1 | grep "Data Center GPU Max"
  ' > rank_gpu_mapping.txt 2>&1
test "$(grep -c '^host=' rank_gpu_mapping.txt)" -eq "${NRANKS}"
test "$(grep '^host=' rank_gpu_mapping.txt | sed -n \
  's/^host=\([^ ]*\).*ZE_AFFINITY_MASK=\([^ ]*\).*/\1|\2/p' \
  | sort -u | wc -l)" -eq "${NRANKS}"
test "$(grep '^host=' rank_gpu_mapping.txt | sed -n \
  's/^host=\([^ ]*\).*/\1/p' | sort -u | wc -l)" -eq 3

mkdir run
if (
  cd run
  /usr/bin/time -p timeout 3300s mpiexec -n "${NRANKS}" \
    --ppn "${PPN}" --depth=8 --cpu-bind depth \
    "${BINDER}" "${QUALIFIED_EXE}" -i "${INPUT}" \
    job/basename="${BASENAME}" time/tlim=3.0 time/nlim=-1 \
    time/ndiag=1 output1/dt=0.01 output2/dt=0.5 \
    output3/dt=-1 output4/dt=-1 output5/dt=-1 \
    ref_gh/debug_task_fences=false > run.log 2>&1
); then
  run_status=0
else
  run_status=$?
fi

readonly HISTORY="run/${BASENAME}.ref_gh.hst"
last_time=$(awk 'NF && $1 !~ /^#/ {value=$1} END {print value+0}' \
  "${HISTORY}" 2>/dev/null || echo 0)
if test -d run/rst; then
  checkpoint_count=$(find run/rst -type f -name '*.rst' | wc -l)
else
  checkpoint_count=0
fi
level_zero_count=$(grep -cE \
  'NotPresent|ZE_RESULT_ERROR_DEVICE_LOST|Segmentation fault from GPU' \
  run/run.log || true)
nonfinite_count=$(grep -Eic \
  '(^|[^[:alnum:]_])(nan|[-+]?inf)([^[:alnum:]_]|$)' run/run.log || true)
{
  echo "run_exit_status=${run_status}"
  echo "requested_final_time=3.0"
  echo "latest_history_time=${last_time}"
  tail -1 "${HISTORY}" 2>/dev/null || true
} > run/run_status.txt

if test -d run/rst; then
  find run/rst -type f -name '*.rst' -print0 | sort -z \
    | xargs -0 -r sha256sum > restart_sha256.txt
else
  : > restart_sha256.txt
fi

if python3 "${ANALYZE}" \
    --run-dir run --basename "${BASENAME}" --target-time 3.0 \
    --control-history "${CONTROL_A}" --control-history "${CONTROL_B}" \
    --output-json phase8_t3_summary.json \
    --output-tsv phase8_t3_summary.tsv --require-hard-gate \
    > phase8_t3_analysis.log 2>&1; then
  analysis_status=0
else
  analysis_status=$?
fi

if [ "${run_status}" -eq 0 ] && [ "${analysis_status}" -eq 0 ] \
    && [ "${level_zero_count}" -eq 0 ] && [ "${nonfinite_count}" -eq 0 ] \
    && awk -v t="${last_time}" 'BEGIN {exit !(t >= 3.0 - 1.0e-10)}'; then
  classification=PASS_GATE_8A_TO_3M
  gate_exit=0
else
  classification=FAIL_GATE_8A
  gate_exit=1
fi
{
  echo "classification=${classification}"
  echo "run_exit_status=${run_status}"
  echo "analysis_exit_status=${analysis_status}"
  echo "latest_history_time=${last_time}"
  echo "checkpoint_file_count=${checkpoint_count}"
  echo "level_zero_error_count=${level_zero_count}"
  echo "nonfinite_log_count=${nonfinite_count}"
  echo "claim_boundary=Gate 8A only; no 5M, convergence, or long-time claim"
  sha256sum "${QUALIFIED_EXE}" "${INPUT}"
  tail -1 "${HISTORY}" 2>/dev/null || true
  tail -1 "run/${BASENAME}.user.hst" 2>/dev/null || true
} > gate_status.txt

find . -type f ! -name compact_sha256.txt \
  \( -name '*.hst' -o -name '*.tsv' -o -name '*.txt' \
  -o -name '*.log' -o -name '*.json' -o -name '*.dat' \) \
  -print0 | sort -z | xargs -0 sha256sum > compact_sha256.txt

echo "phase8_t3_complete=$(date -Is)"
exit "${gate_exit}"
