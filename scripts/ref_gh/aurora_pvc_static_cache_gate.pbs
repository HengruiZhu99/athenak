#!/bin/bash -l
# Correctness, stage-time, performance, and profile gate for the current
# equation-neutral reference-cache revision.
#PBS -A CompactBinaryMerger
#PBS -q debug
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -N refgh_cache_gate
#PBS -j oe

set -euo pipefail

ROOT=/lus/flare/projects/CompactBinaryMerger/hzhu/refgh_pvc_performance_convergence_20260821
SRC="${ROOT}/athenak"
: "${EXPECTED_COMMIT:?submit with qsub -v EXPECTED_COMMIT=<full-sha>}"
RUN_TAG=${RUN_TAG:-diagnostic_split}
CHECKED_BUILD="${ROOT}/build_${RUN_TAG}_checked_${PBS_JOBID}"
PERF_BUILD="${ROOT}/build_${RUN_TAG}_performance_${PBS_JOBID}"
OUT="${ROOT}/runs/${RUN_TAG}_${PBS_JOBID}"
BINDER="${SRC}/scripts/ref_gh/aurora_gpu_tile_slot.sh"
GATE_INPUT="${SRC}/inputs/ref_gh/ref_gh_stationary_trumpet.athinput"
BENCH_INPUT="${SRC}/inputs/ref_gh/ref_gh_stationary_trumpet_benchmark.athinput"
TIME_INPUT="${SRC}/tst/inputs/ref_gh_time_dependent_reference.athinput"
SOURCE_INPUT="${SRC}/inputs/ref_gh/ref_gh_source_unit.athinput"
TOOL="${OUT}/librefgh_kokkos_kernel_timer.so"
PREVIOUS_THROUGHPUT=${PREVIOUS_THROUGHPUT:-3.033790e5}

mkdir -p "${OUT}"
cd "${OUT}"

source "${HOME}/athenak_env"
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export FI_MR_CACHE_MONITOR=disabled
export FI_LOG_LEVEL=ERROR

actual_commit=$(git -C "${SRC}" rev-parse HEAD)
test "${actual_commit}" = "${EXPECTED_COMMIT}"
test -z "$(git -C "${SRC}" status --porcelain --untracked-files=no)"

{
  date -Is
  hostname
  qstat -f "${PBS_JOBID}"
  echo "source_commit=${actual_commit}"
  git -C "${SRC}" submodule status
  icpx --version | head -1
  mpicxx --version | head -1
  cmake --version | head -1
  env | grep -E '^(ONEAPI_DEVICE_SELECTOR|ZE_|MPICH_GPU|FI_)' | sort
  sha256sum "${GATE_INPUT}" "${BENCH_INPUT}" "${TIME_INPUT}" \
    "${SOURCE_INPUT}" "$0"
} > provenance.txt

configure_build() {
  local build="$1"
  local bounds="$2"
  local label="$3"
  cmake -S "${SRC}" -B "${build}" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER="$(command -v icx)" \
    -DCMAKE_CXX_COMPILER="$(command -v icpx)" \
    -DAthena_ENABLE_MPI=ON \
    -DAthena_ENABLE_OPENMP=OFF \
    -DKokkos_ENABLE_SERIAL=ON \
    -DKokkos_ENABLE_OPENMP=OFF \
    -DKokkos_ENABLE_SYCL=ON \
    -DKokkos_ARCH_INTEL_PVC=ON \
    -DKokkos_ENABLE_DEBUG_BOUNDS_CHECK="${bounds}" \
    -DPROBLEM=built_in_pgens \
    > "configure_${label}.log" 2>&1
  cmake --build "${build}" -j 64 > "build_${label}.log" 2>&1
  {
    echo "build=${label}"
    grep -E 'CMAKE_(C|CXX)_COMPILER:|CMAKE_BUILD_TYPE:|Athena_ENABLE_MPI:|Athena_ENABLE_OPENMP:|Kokkos_ENABLE_(SYCL|SERIAL|OPENMP|DEBUG_BOUNDS_CHECK):|Kokkos_ARCH_INTEL_PVC:|PROBLEM:' \
      "${build}/CMakeCache.txt"
    sha256sum "${build}/src/athena"
  } >> provenance.txt
}

configure_build "${CHECKED_BUILD}" ON checked
configure_build "${PERF_BUILD}" OFF performance
python3 - "${OUT}/build_checked.log" "${OUT}/build_performance.log" \
  > compiler_pressure.tsv <<'PY'
import pathlib
import re
import sys

print("build\tkernel\tevent\tdetail")
for path in sys.argv[1:]:
    build = pathlib.Path(path).stem.replace("build_", "")
    lines = pathlib.Path(path).read_text(errors="replace").splitlines()
    for line_number, line in enumerate(lines):
        if "compiled SIMD" in line and "ref_gh" in line.lower():
            match = re.search(r"compiled SIMD(\d+) allocated (\d+) regs "
                              r"and spilled around (\d+)", line)
            if match:
                print("{}\tref_gh\tregister_spill\tline={};simd={};regs={};spill={}".
                      format(build, line_number + 1, *match.groups()))
        if "[RetryManager] Start recompilation" not in line:
            continue
        context = " ".join(lines[line_number + 1:line_number + 4])
        match = re.search(r"RefGh::CalcRHS<(\d+)>.*?'(lambda\d*)'", context)
        if match:
            print("{}\tCalcRHS<{}>::{}\tretry_recompile\tline={}".
                  format(build, match.group(1), match.group(2), line_number + 1))
PY
icpx -std=c++17 -O2 -fPIC -shared \
  "${SRC}/scripts/ref_gh/kokkos_kernel_timer.cpp" -o "${TOOL}"

mpiexec -n 1 --ppn 1 --depth=16 --cpu-bind depth \
  "${BINDER}" 0.0 bash -lc '
    echo "hostname=$(hostname)"
    echo "ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-unset}"
    sycl-ls 2>&1
  ' > gpu_mapping.txt 2>&1

mkdir source_oracle
cd source_oracle
/usr/bin/time -p mpiexec -n 1 --ppn 1 --depth=16 --cpu-bind depth \
  "${BINDER}" 0.0 "${CHECKED_BUILD}/src/athena" -i "${SOURCE_INPUT}" \
  > ref_gh_source_oracle.log 2>&1
grep -q 'reference-GH flat covariant source unit passed' \
  ref_gh_source_oracle.log
grep -q 'reference-GH nonflat covariant source unit passed' \
  ref_gh_source_oracle.log
! grep -Eiq 'NotPresent|page fault|SYCL exception|(^|[^[:alpha:]])(nan|inf)([^[:alpha:]]|$)' \
  ref_gh_source_oracle.log

cd "${OUT}"
mkdir checked_gate
cd checked_gate
/usr/bin/time -p mpiexec -n 1 --ppn 1 --depth=16 --cpu-bind depth \
  "${BINDER}" 0.0 "${CHECKED_BUILD}/src/athena" -i "${GATE_INPUT}" \
  job/basename=ref_gh_static_cache_gate \
  mesh/nx1=64 mesh/nx2=64 mesh/nx3=64 \
  meshblock/nx1=64 meshblock/nx2=64 meshblock/nx3=64 \
  ref_gh/debug_task_fences=true ref_gh/validate_reference_cache=true \
  output1/dt=1.0e-6 output2/dt=1.0e-6 time/nlim=1 time/tlim=1.0 \
  > ref_gh_static_cache_gate.log 2>&1
test -s ref_gh_static_cache_gate.ref_gh.hst
awk 'BEGIN {rows=0; positive=0} !/^#/ {rows++; if ($1 > 0) positive=1} END {exit !(rows >= 2 && positive)}' \
  ref_gh_static_cache_gate.ref_gh.hst
grep -q 'reference-GH stationary initial RHS Linf' ref_gh_static_cache_gate.log
grep -q 'reference-GH production cache oracle conditioned scaled Linf' \
  ref_gh_static_cache_gate.log
! grep -Eiq 'NotPresent|page fault|SYCL exception|(^|[^[:alpha:]])(nan|inf)([^[:alpha:]]|$)' \
  ref_gh_static_cache_gate.log

cd "${OUT}"
mkdir performance_gate
cd performance_gate
/usr/bin/time -p mpiexec -n 1 --ppn 1 --depth=16 --cpu-bind depth \
  "${BINDER}" 0.0 "${PERF_BUILD}/src/athena" -i "${GATE_INPUT}" \
  job/basename=ref_gh_performance_output_gate \
  mesh/nx1=64 mesh/nx2=64 mesh/nx3=64 \
  meshblock/nx1=64 meshblock/nx2=64 meshblock/nx3=64 \
  ref_gh/debug_task_fences=true ref_gh/validate_reference_cache=true \
  output1/dt=1.0e-6 output2/dt=1.0e-6 time/nlim=1 time/tlim=1.0 \
  > ref_gh_performance_output_gate.log 2>&1
test -s ref_gh_performance_output_gate.ref_gh.hst
test -s rst/ref_gh_performance_output_gate.00002.rst
awk 'BEGIN {rows=0; positive=0} !/^#/ {rows++; if ($1 > 0) positive=1} END {exit !(rows >= 2 && positive)}' \
  ref_gh_performance_output_gate.ref_gh.hst
grep -q 'reference-GH stationary initial RHS Linf' \
  ref_gh_performance_output_gate.log
grep -q 'reference-GH production cache oracle conditioned scaled Linf' \
  ref_gh_performance_output_gate.log
! grep -Eiq 'NotPresent|page fault|SYCL exception|(^|[^[:alpha:]])(nan|inf)([^[:alpha:]]|$)' \
  ref_gh_performance_output_gate.log

cd "${OUT}"
python3 - <<'PY' > full_output_comparison.tsv
import math
import pathlib

checked = pathlib.Path("checked_gate")
performance = pathlib.Path("performance_gate")
file_pairs = [
    (checked / "ref_gh_static_cache_gate.ref_gh.hst",
     performance / "ref_gh_performance_output_gate.ref_gh.hst")]
for index in range(6):
    file_pairs.append(
        (checked / "ref_gh_static_cache_gate.adm_common{}.hst".format(index),
         performance / "ref_gh_performance_output_gate.adm_common{}.hst".
         format(index)))

maximum = 0.0
where = ""
for checked_path, performance_path in file_pairs:
    def rows(path):
        return [[float(value) for value in line.split()]
                for line in path.read_text().splitlines()
                if line and not line.startswith("#")]
    checked_rows = rows(checked_path)
    performance_rows = rows(performance_path)
    if len(checked_rows) != len(performance_rows):
        raise SystemExit("history row count mismatch: {}".format(checked_path))
    for row_index, (checked_row, performance_row) in enumerate(
            zip(checked_rows, performance_rows)):
        if len(checked_row) != len(performance_row):
            raise SystemExit("history column mismatch: {}".format(checked_path))
        for column, (checked_value, performance_value) in enumerate(
                zip(checked_row, performance_row)):
            difference = abs(checked_value - performance_value)
            if not math.isfinite(difference):
                raise SystemExit("nonfinite history comparison")
            if difference > maximum:
                maximum = difference
                where = "{}:{}:{}".format(checked_path.name, row_index, column)
            tolerance = 1024.0*2.220446049250313e-16*(1.0 + abs(checked_value))
            if difference > tolerance:
                raise SystemExit("history mismatch at {}: {} > {}".
                                 format(where, difference, tolerance))
print("metric\tvalue")
print("checked_performance_history_linf\t{:.17g}".format(maximum))
print("maximum_location\t{}".format(where or "identical"))
PY

mkdir "${OUT}/time_dependent"
cd "${OUT}/time_dependent"
KOKKOS_TOOLS_LIBS="${TOOL}" \
REF_GH_KERNEL_TIMING_FILE="${OUT}/time_dependent_kernel_timing.tsv" \
/usr/bin/time -p mpiexec -n 1 --ppn 1 --depth=16 --cpu-bind depth \
  "${BINDER}" 0.0 "${CHECKED_BUILD}/src/athena" -i "${TIME_INPUT}" \
  job/basename=ref_gh_time_dependent_static_gate \
  > ref_gh_time_dependent_static_gate.log 2>&1
grep -q 'reference-GH Minkowski evolution passed' \
  ref_gh_time_dependent_static_gate.log
! grep -Eiq 'NotPresent|page fault|SYCL exception|(^|[^[:alpha:]])(nan|inf)([^[:alpha:]]|$)' \
  ref_gh_time_dependent_static_gate.log

run_benchmark() {
  local cycles="$1"
  local label="$2"
  local work="${OUT}/${label}"
  mkdir -p "${work}"
  cd "${work}"
  /usr/bin/time -p mpiexec -n 1 --ppn 1 --depth=16 --cpu-bind depth \
    "${BINDER}" 0.0 "${PERF_BUILD}/src/athena" -i "${BENCH_INPUT}" \
    job/basename="${label}" time/nlim="${cycles}" time/tlim=100.0 \
    > "${label}.log" 2>&1
  grep -q "cycle=${cycles}" "${label}.log"
  grep -q 'zone-cycles/cpu_second' "${label}.log"
  ! grep -Eiq 'NotPresent|page fault|SYCL exception|(^|[^[:alpha:]])(nan|inf)([^[:alpha:]]|$)' \
    "${label}.log"
}

run_benchmark 20 ref_gh_static_cache_warmup
run_benchmark 100 ref_gh_static_cache

mkdir "${OUT}/profile"
cd "${OUT}/profile"
KOKKOS_TOOLS_LIBS="${TOOL}" \
REF_GH_KERNEL_TIMING_FILE="${OUT}/static_kernel_timing.tsv" \
/usr/bin/time -p mpiexec -n 1 --ppn 1 --depth=16 --cpu-bind depth \
  "${BINDER}" 0.0 "${PERF_BUILD}/src/athena" -i "${BENCH_INPUT}" \
  job/basename=ref_gh_static_profile time/nlim=20 time/tlim=100.0 \
  > ref_gh_static_profile.log 2>&1
grep -q 'cycle=20' ref_gh_static_profile.log
! grep -Eiq 'NotPresent|page fault|SYCL exception|(^|[^[:alpha:]])(nan|inf)([^[:alpha:]]|$)' \
  ref_gh_static_profile.log

cd "${OUT}"
awk -F'= ' '/zone-cycles\/cpu_second/ {print "static_cache\t" $2}' \
  ref_gh_static_cache/ref_gh_static_cache.log > throughput.tsv
python3 - "${PREVIOUS_THROUGHPUT}" <<'PY' > speedup.tsv
import csv
import pathlib
import sys

previous = float(sys.argv[1])
measured = float(pathlib.Path("throughput.tsv").read_text().split("\t")[1])

def calls(path, target):
    with pathlib.Path(path).open() as stream:
        rows = {row["kernel"]: int(row["calls"])
                for row in csv.DictReader(stream, delimiter="\t")}
    return rows.get(target, 0)

static_builds = calls("static_kernel_timing.tsv",
                      "ref_gh reference provider profiles")
dynamic_builds = calls("time_dependent_kernel_timing.tsv",
                       "ref_gh reference provider profiles")
profile_ricci_builds = calls("static_kernel_timing.tsv",
                             "ref_gh reference Ricci")
assert static_builds == 1
assert dynamic_builds > static_builds
# The stationary problem generator requests one initial diagnostic pass.  The
# validation-off time-dependent follow-up distinguishes that diagnostic call
# from production-stage cache rebuilds.
assert profile_ricci_builds <= static_builds
print("metric\tvalue")
print("previous_zone_cycles_per_s\t{:.12g}".format(previous))
print("static_cache_zone_cycles_per_s\t{:.12g}".format(measured))
print("static_cache_speedup\t{:.12g}".format(measured/previous))
print("static_provider_builds_20_cycles\t{}".format(static_builds))
print("time_dependent_provider_builds\t{}".format(dynamic_builds))
print("profile_reference_ricci_builds\t{}".format(profile_ricci_builds))
PY

head -31 static_kernel_timing.tsv > top30_static_kernel_timing.tsv
sha256sum provenance.txt gpu_mapping.txt throughput.tsv speedup.tsv \
  compiler_pressure.tsv full_output_comparison.tsv \
  static_kernel_timing.tsv time_dependent_kernel_timing.tsv \
  top30_static_kernel_timing.tsv source_oracle/ref_gh_source_oracle.log \
  > compact_sha256.txt
