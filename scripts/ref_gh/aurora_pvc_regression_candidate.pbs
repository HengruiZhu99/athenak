#!/bin/bash -l
# One-candidate Aurora PVC source-bisect driver.  It uses the exact Phase-1
# toolchain and frozen one-cycle workload.  Source exports are immutable and
# identified by explicit commit/tree marker files.
#PBS -A CompactBinaryMerger
#PBS -q debug
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -l filesystems=home:flare
#PBS -N refgh_pvc_bisect
#PBS -j oe

set -euo pipefail

: "${CAMPAIGN_ROOT:?existing PVC regression campaign root}"
: "${CANDIDATE_LABEL:?short candidate label}"
: "${EXPECTED_COMMIT:?exact source identifier}"
: "${EXPECTED_TREE:?exact tree or manifest identifier}"
readonly TEST_PURPOSE=${TEST_PURPOSE:-one midpoint of the W-to-R source bisect}
readonly CLAIM_BOUNDARY=${CLAIM_BOUNDARY:-one-cycle source-bisect discriminator only}
readonly DEVICE_CODE_SPLIT=${DEVICE_CODE_SPLIT:-default}
readonly RANK_SEQUENCE=${RANK_SEQUENCE:-${NRANKS:-12}}
IFS=',' read -r -a RANK_COUNTS <<< "${RANK_SEQUENCE}"
test "${#RANK_COUNTS[@]}" -ge 1
for nranks in "${RANK_COUNTS[@]}"; do
  test "${nranks}" -ge 1
  test "${nranks}" -le 12
  test $((216 % nranks)) -eq 0
done

readonly KOKKOS_COMMIT=6739bc623081648af9e752b616d9671527922cbf
readonly SRC="${CAMPAIGN_ROOT}/sources/${CANDIDATE_LABEL}"
readonly BUILD="${CAMPAIGN_ROOT}/build_${CANDIDATE_LABEL}_${PBS_JOBID}"
readonly OUT="${CAMPAIGN_ROOT}/runs/bisect_${CANDIDATE_LABEL}_${PBS_JOBID}"
readonly INPUT="${SRC}/inputs/ref_gh/ref_gh_ordering_gauge_case_d.athinput"
readonly BASENAME="pvc_bisect_${CANDIDATE_LABEL}"

mkdir -p "${OUT}"
cd "${OUT}"
exec > >(tee -a bootstrap.log) 2>&1
trap 'status=$?; echo "candidate_failure status=${status} line=${LINENO} command=${BASH_COMMAND}"; exit "${status}"' ERR

source "${HOME}/athenak_env"
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export FI_MR_CACHE_MONITOR=disabled
export FI_LOG_LEVEL=ERROR
readonly BINDER=$(command -v gpu_tile_compact.sh)
test -x "${BINDER}"

test "$(cat "${SRC}/.source_commit")" = "${EXPECTED_COMMIT}"
test "$(cat "${SRC}/.source_tree")" = "${EXPECTED_TREE}"
test "$(cat "${SRC}/.kokkos_commit")" = "${KOKKOS_COMMIT}"
test -f "${SRC}/kokkos/CMakeLists.txt"
test -f "${INPUT}"
cmp "${INPUT}" "${CAMPAIGN_ROOT}/sources/W/inputs/ref_gh/ref_gh_ordering_gauge_case_d.athinput"

{
  date -Is
  hostname
  qstat -f "${PBS_JOBID}"
  echo "campaign_root=${CAMPAIGN_ROOT}"
  echo "candidate_label=${CANDIDATE_LABEL}"
  echo "candidate_commit=${EXPECTED_COMMIT}"
  echo "candidate_tree=${EXPECTED_TREE}"
  echo "Kokkos_commit=${KOKKOS_COMMIT}"
  echo "purpose=${TEST_PURPOSE}"
  echo "grid=96x96x96 meshblocks=216 rank_sequence=${RANK_SEQUENCE}"
  for nranks in "${RANK_COUNTS[@]}"; do
    echo "rank_case=${nranks} blocks_per_rank=$((216 / nranks))"
  done
  echo "frozen_parameters=STANDARD gamma0=1 gamma2=1 gauge-on gauge-reference-subtraction-on q=1 q-controller-off q-prescribed-off FD4 RK4 CFL=0.05 KO=0.02"
  echo "debug_task_fences=true"
  echo "Kokkos_ENABLE_DEBUG_BOUNDS_CHECK=OFF"
  echo "source_unit=OFF"
  echo "device_code_split_base=toolchain_and_source_default"
  echo "device_code_split_override=${DEVICE_CODE_SPLIT}"
  echo "restart_and_field_outputs=disabled"
  sha256sum "${HOME}/athenak_env" "$0" "${INPUT}"
  module list 2>&1
  icpx --version | head -1
  mpicxx --version | head -1
  cmake --version | head -1
  env | grep -E '^(ONEAPI_DEVICE_SELECTOR|ZE_|MPICH_GPU|FI_)' | sort
} > provenance.txt

for nranks in "${RANK_COUNTS[@]}"; do
  mapping="rank_gpu_mapping_n${nranks}.txt"
  mpiexec -n "${nranks}" --ppn "${nranks}" --depth=8 --cpu-bind depth \
    "${BINDER}" bash -lc '
      echo "host=$(hostname) rank=${PALS_RANKID:-unset} local_rank=${PALS_LOCAL_RANKID:-unset} ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-unset}"
      sycl-ls 2>&1 | grep "Data Center GPU Max"
    ' > "${mapping}" 2>&1
  test "$(grep -c '^host=' "${mapping}")" -eq "${nranks}"
  test "$(grep '^host=' "${mapping}" \
    | sed -n 's/.*ZE_AFFINITY_MASK=\([^ ]*\).*/\1/p' \
    | sort -u | wc -l)" -eq "${nranks}"
done

cmake_extra_args=()
if [ "${DEVICE_CODE_SPLIT}" != default ]; then
  cmake_extra_args+=(
    "-DCMAKE_CXX_FLAGS=-fsycl-device-code-split=${DEVICE_CODE_SPLIT}")
fi
cmake -S "${SRC}" -B "${BUILD}" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER="$(command -v icx)" \
  -DCMAKE_CXX_COMPILER="$(command -v icpx)" \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DAthena_ENABLE_MPI=ON \
  -DAthena_ENABLE_OPENMP=OFF \
  -DAthena_ENABLE_REF_GH_SOURCE_UNIT=OFF \
  -DKokkos_ENABLE_SERIAL=ON \
  -DKokkos_ENABLE_OPENMP=OFF \
  -DKokkos_ENABLE_SYCL=ON \
  -DKokkos_ARCH_INTEL_PVC=ON \
  -DKokkos_ENABLE_DEBUG_BOUNDS_CHECK=OFF \
  "${cmake_extra_args[@]}" \
  -DPROBLEM=built_in_pgens > configure.log 2>&1
timeout 1500s cmake --build "${BUILD}" --verbose -j 64 > build.log 2>&1
readonly EXE="${BUILD}/src/athena"
test -x "${EXE}"
{
  grep -E 'CMAKE_(C|CXX)_COMPILER:|CMAKE_CXX_FLAGS:|CMAKE_BUILD_TYPE:|Athena_ENABLE_MPI:|Athena_ENABLE_OPENMP:|Athena_ENABLE_REF_GH_SOURCE_UNIT:|Kokkos_ENABLE_(SYCL|SERIAL|OPENMP|DEBUG_BOUNDS_CHECK):|Kokkos_ARCH_INTEL_PVC:|PROBLEM:' \
    "${BUILD}/CMakeCache.txt"
  sha256sum "${BUILD}/CMakeCache.txt" "${BUILD}/compile_commands.json" "${EXE}"
} > build_identity.txt
grep -q '^Athena_ENABLE_MPI:BOOL=ON$' "${BUILD}/CMakeCache.txt"
grep -q '^Athena_ENABLE_REF_GH_SOURCE_UNIT:BOOL=OFF$' "${BUILD}/CMakeCache.txt"
grep -q '^Kokkos_ENABLE_SYCL:BOOL=ON$' "${BUILD}/CMakeCache.txt"
grep -q '^Kokkos_ARCH_INTEL_PVC:BOOL=ON$' "${BUILD}/CMakeCache.txt"
grep -q '^Kokkos_ENABLE_OPENMP:BOOL=OFF$' "${BUILD}/CMakeCache.txt"
grep -q '^Kokkos_ENABLE_DEBUG_BOUNDS_CHECK:BOOL=OFF$' "${BUILD}/CMakeCache.txt"

for nranks in "${RANK_COUNTS[@]}"; do
  run_dir="run_n${nranks}"
  run_basename="${BASENAME}_n${nranks}"
  mkdir "${run_dir}"
  set +e
  (
    cd "${run_dir}"
    /usr/bin/time -p timeout 600s mpiexec -n "${nranks}" \
      --ppn "${nranks}" --depth=8 \
      --cpu-bind depth "${BINDER}" "${EXE}" -i "${INPUT}" \
      job/basename="${run_basename}" time/tlim=0.01 time/nlim=1 \
      ref_gh/debug_task_fences=true \
      output2/dt=-1 output3/dt=-1 output4/dt=-1 output5/dt=-1 \
      > run.log 2>&1
  )
  run_status=$?
  set -e

  fence_trace="fence_trace_n${nranks}.txt"
  grep 'ref_gh debug fence passed:' "${run_dir}/run.log" \
    > "${fence_trace}" || true
  history="${run_dir}/${run_basename}.ref_gh.hst"
  last_time=$(awk 'NF && $1 !~ /^#/ {value=$1} END {print value+0}' \
    "${history}" 2>/dev/null || echo 0)
  if [ "${run_status}" -eq 0 ] && awk -v t="${last_time}" \
      'BEGIN {exit !(t > 0)}'; then
    classification=PASS_ONE_CYCLE_PVC
  elif grep -qE 'NotPresent|ZE_RESULT_ERROR_DEVICE_LOST|Segmentation fault from GPU' \
      "${run_dir}/run.log"; then
    classification=FAIL_LEVEL_ZERO
  else
    classification="FAIL_OTHER_STATUS_${run_status}"
  fi
  {
    echo "nranks=${nranks}"
    echo "blocks_per_rank=$((216 / nranks))"
    echo "classification=${classification}"
    echo "run_exit_status=${run_status}"
    echo "latest_history_time=${last_time}"
    echo "last_completed_fence=$(tail -1 "${fence_trace}" 2>/dev/null || true)"
    sha256sum "${EXE}" "${INPUT}"
    echo "claim_boundary=${CLAIM_BOUNDARY}"
  } > "result_n${nranks}.txt"
done

{
  echo "rank_sequence=${RANK_SEQUENCE}"
  for nranks in "${RANK_COUNTS[@]}"; do
    grep -E '^(nranks|classification|run_exit_status|latest_history_time)=' \
      "result_n${nranks}.txt"
  done
} > result.txt

find . -type f ! -name compact_sha256.txt \
  \( -name '*.hst' -o -name '*.tsv' -o -name '*.txt' \
  -o -name '*.log' -o -name '*.json' \) \
  -print0 | sort -z | xargs -0 sha256sum > compact_sha256.txt

echo "candidate_complete=$(date -Is)"
