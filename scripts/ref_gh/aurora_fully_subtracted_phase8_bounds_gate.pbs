#!/bin/bash -l
# Focused Phase-8 PVC bounds/lifecycle discriminator.  This builds the
# production source with Kokkos bounds checking and executes exactly one RK4
# cycle of the frozen 96^3 STANDARD matched case on twelve PVC tiles.
# It is not a stability, convergence, or performance run.
#PBS -A CompactBinaryMerger
#PBS -q debug
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -N refgh_sub_p8bnd
#PBS -j oe

set -euo pipefail

: "${CAMPAIGN_ROOT:?fresh dedicated Phase-8 bounds directory}"
: "${EXPECTED_COMMIT:?full source commit}"

SRC="${CAMPAIGN_ROOT}/src"
BUILD="${CAMPAIGN_ROOT}/build_bounds_${PBS_JOBID}"
OUT="${CAMPAIGN_ROOT}/runs/bounds_cycle_${PBS_JOBID}"
EXE="${BUILD}/src/athena"
INPUT="${SRC}/inputs/ref_gh/ref_gh_ordering_gauge_case_d.athinput"
BASENAME=phase8_bounds_cycle

mkdir -p "${OUT}"
cd "${OUT}"
exec > >(tee -a bootstrap.log) 2>&1
trap 'status=$?; echo "phase8_bounds_failure status=${status} line=${LINENO} command=${BASH_COMMAND}"; exit "${status}"' ERR

echo "bootstrap_begin=$(date -Is)"
source "${HOME}/athenak_env"
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export FI_MR_CACHE_MONITOR=disabled
export FI_LOG_LEVEL=ERROR
BINDER=$(command -v gpu_tile_compact.sh)
test -x "${BINDER}"

actual_commit=$(git -C "${SRC}" rev-parse HEAD)
test "${actual_commit}" = "${EXPECTED_COMMIT}"
test -z "$(git -C "${SRC}" status --porcelain --untracked-files=no)"
test -f "${SRC}/kokkos/CMakeLists.txt"

{
  date -Is
  hostname
  qstat -f "${PBS_JOBID}"
  echo "campaign_root=${CAMPAIGN_ROOT}"
  echo "source_commit=${actual_commit}"
  echo "purpose=one-cycle PVC Kokkos-bounds and communication-lifecycle gate"
  echo "grid=96x96x96 meshblocks=216 ranks=12"
  echo "frozen_parameters=STANDARD gamma0=1 gamma2=1 gauge-on q=1 FD4 RK4 CFL=0.05 KO=0.02"
  echo "debug_task_fences=true"
  echo "Kokkos_ENABLE_DEBUG_BOUNDS_CHECK=ON"
  echo "restart_and_field_outputs=disabled"
  git -C "${SRC}" status --short --branch
  git -C "${SRC}" submodule status
  module list 2>&1
  icpx --version | head -1
  mpicxx --version | head -1
  cmake --version | head -1
  python3 --version
  env | grep -E '^(ONEAPI_DEVICE_SELECTOR|ZE_|MPICH_GPU|FI_)' | sort
  sha256sum "${INPUT}" "$0"
} > provenance.txt

cmake -S "${SRC}" -B "${BUILD}" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER="$(command -v icx)" \
  -DCMAKE_CXX_COMPILER="$(command -v icpx)" \
  -DAthena_ENABLE_MPI=ON \
  -DAthena_ENABLE_OPENMP=OFF \
  -DAthena_ENABLE_REF_GH_SOURCE_UNIT=OFF \
  -DKokkos_ENABLE_SERIAL=ON \
  -DKokkos_ENABLE_OPENMP=OFF \
  -DKokkos_ENABLE_SYCL=ON \
  -DKokkos_ARCH_INTEL_PVC=ON \
  -DKokkos_ENABLE_DEBUG_BOUNDS_CHECK=ON \
  -DPROBLEM=built_in_pgens > configure.log 2>&1
cmake --build "${BUILD}" --verbose -j 64 > build.log 2>&1

{
  grep -E 'CMAKE_(C|CXX)_COMPILER:|CMAKE_BUILD_TYPE:|Athena_ENABLE_MPI:|Athena_ENABLE_OPENMP:|Athena_ENABLE_REF_GH_SOURCE_UNIT:|Kokkos_ENABLE_(SYCL|SERIAL|OPENMP|DEBUG_BOUNDS_CHECK):|Kokkos_ARCH_INTEL_PVC:|PROBLEM:' \
    "${BUILD}/CMakeCache.txt"
  sha256sum "${BUILD}/CMakeCache.txt" "${EXE}"
} >> provenance.txt
grep -q '^Athena_ENABLE_MPI:BOOL=ON$' "${BUILD}/CMakeCache.txt"
grep -q '^Athena_ENABLE_REF_GH_SOURCE_UNIT:BOOL=OFF$' "${BUILD}/CMakeCache.txt"
grep -q '^Kokkos_ENABLE_SYCL:BOOL=ON$' "${BUILD}/CMakeCache.txt"
grep -q '^Kokkos_ARCH_INTEL_PVC:BOOL=ON$' "${BUILD}/CMakeCache.txt"
grep -q '^Kokkos_ENABLE_OPENMP:BOOL=OFF$' "${BUILD}/CMakeCache.txt"
grep -q '^Kokkos_ENABLE_DEBUG_BOUNDS_CHECK:BOOL=ON$' "${BUILD}/CMakeCache.txt"

mpiexec -n 12 --ppn 12 --depth=8 --cpu-bind depth \
  "${BINDER}" bash -lc '
    echo "host=$(hostname) rank=${PALS_RANKID:-unset} local_rank=${PALS_LOCAL_RANKID:-unset} ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-unset}"
    sycl-ls 2>&1 | grep "Data Center GPU Max"
  ' > rank_gpu_mapping.txt 2>&1
test "$(grep -c '^host=' rank_gpu_mapping.txt)" -eq 12
test "$(grep '^host=' rank_gpu_mapping.txt \
  | sed -n 's/.*ZE_AFFINITY_MASK=\([^ ]*\).*/\1/p' \
  | sort -u | wc -l)" -eq 12

mkdir run_cycle
if (
  cd run_cycle
  /usr/bin/time -p mpiexec -n 12 --ppn 12 --depth=8 --cpu-bind depth \
    "${BINDER}" "${EXE}" -i "${INPUT}" \
    job/basename="${BASENAME}" time/tlim=0.01 time/nlim=1 \
    ref_gh/debug_task_fences=true \
    output2/dt=-1 output3/dt=-1 output4/dt=-1 output5/dt=-1 \
    > run.log 2>&1
); then
  run_status=0
else
  run_status=$?
fi

history="run_cycle/${BASENAME}.ref_gh.hst"
last_time=$(awk 'NF && $1 !~ /^#/ {value=$1} END {print value+0}' \
  "${history}" 2>/dev/null || echo 0)
grep 'ref_gh debug fence passed:' run_cycle/run.log > fence_trace.txt || true
last_fence=$(tail -1 fence_trace.txt 2>/dev/null || true)
for label in \
  'ClearSend enter' 'ClearSend exit' 'ClearRecv enter' 'ClearRecv exit' \
  'CalcRHS' 'ExpRKUpdate' 'ApplyPhysicalBCs projected trumpet gauge' \
  'NewTimeStep'; do
  count=$(grep -c "${label}" fence_trace.txt || true)
  printf '%s\t%s\n' "${label}" "${count}"
done > fence_counts.tsv

if [ "${run_status}" -eq 0 ] && awk -v t="${last_time}" 'BEGIN {exit !(t > 0)}'; then
  result=PASS_PHASE8_PVC_BOUNDS_ONE_CYCLE
else
  result=FAIL_PHASE8_PVC_BOUNDS_ONE_CYCLE
fi
{
  echo "result=${result}"
  echo "run_exit_status=${run_status}"
  echo "latest_history_time=${last_time}"
  echo "last_completed_fence=${last_fence}"
  echo "bounds_check=ON"
  echo "claim_boundary=one bounded PVC cycle; no stability or convergence claim"
  sha256sum "${EXE}"
} > gate_status.txt

echo "phase8_bounds_complete=$(date -Is)"
find . -type f ! -name compact_sha256.txt \
  \( -name '*.hst' -o -name '*.tsv' -o -name '*.txt' \
  -o -name '*.log' -o -name '*.json' -o -name '*-trumpet.dat' \) \
  -print0 | sort -z | xargs -0 sha256sum > compact_sha256.txt

exit "${run_status}"
