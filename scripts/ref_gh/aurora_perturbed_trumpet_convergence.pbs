#!/bin/bash -l
# 8-rank/8-tile smooth perturbed-trumpet 64/96/128 convergence ladder.
#PBS -A CompactBinaryMerger
#PBS -q debug
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -N refgh_pert_conv
#PBS -j oe

set -euo pipefail

ROOT=/lus/flare/projects/CompactBinaryMerger/hzhu/refgh_reference_cache_task_20260820
SRC="${ROOT}/athenak"
BUILD="${ROOT}/build_sycl_pvc_8770307.aurora-pbs-0001.hostmgmt.cm.aurora.alcf.anl.gov"
BUILD_SOURCE_COMMIT=6eed3d9d6fb5d31ee8f240a771e18bfc220a0701
EXE="${BUILD}/src/athena"
INPUT="${SRC}/inputs/ref_gh/ref_gh_perturbed_trumpet.athinput"
ANALYZER="${SRC}/scripts/ref_gh/analyze_perturbed_trumpet_convergence.py"
OUT="${ROOT}/runs/perturbed_convergence_${PBS_JOBID}"

mkdir -p "${OUT}"
cd "${OUT}"

source "${HOME}/athenak_env"
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export FI_MR_CACHE_MONITOR=disabled
export FI_LOG_LEVEL=ERROR

git -C "${SRC}" diff --quiet "${BUILD_SOURCE_COMMIT}" HEAD -- src inputs

{
  date -Is
  hostname
  qstat -f "${PBS_JOBID}"
  git -C "${SRC}" rev-parse HEAD
  echo "build_source_commit=${BUILD_SOURCE_COMMIT}"
  git -C "${SRC}" status --short
  git -C "${SRC}" submodule status
  sha256sum "${EXE}"
  icpx --version | head -1
  grep -E 'CMAKE_(C|CXX)_COMPILER:|CMAKE_BUILD_TYPE:|Athena_ENABLE_MPI:|Athena_ENABLE_OPENMP:|Kokkos_ENABLE_(SYCL|SERIAL|OPENMP|DEBUG_BOUNDS_CHECK):|Kokkos_ARCH_INTEL_PVC:|PROBLEM:' "${BUILD}/CMakeCache.txt"
} > provenance.txt

mpiexec -n 8 --ppn 8 --depth=16 --cpu-bind depth \
  gpu_tile_compact.sh bash -lc '
    echo "host=$(hostname) rank=${PALS_RANKID:-unset} local_rank=${PALS_LOCAL_RANKID:-unset} ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-unset}"
    sycl-ls 2>&1 | grep "Data Center GPU Max"
  ' > rank_gpu_mapping.txt 2>&1

run_case() (
  local label="$1"
  local ncell="$2"
  local mbcell="$3"
  local work="${OUT}/${label}"
  mkdir -p "${work}"
  cd "${work}"
  /usr/bin/time -p mpiexec -n 8 --ppn 8 --depth=16 --cpu-bind depth \
    gpu_tile_compact.sh "${EXE}" -i "${INPUT}" \
    job/basename="${label}" \
    mesh/nx1="${ncell}" mesh/nx2="${ncell}" mesh/nx3="${ncell}" \
    meshblock/nx1="${mbcell}" meshblock/nx2="${mbcell}" meshblock/nx3="${mbcell}" \
    ref_gh/debug_task_fences=false \
    ref_gh/validate_reference_cache=false \
    output1/dt=0.02 output2/dt=0.1 \
    output3/dt=0.2 output4/dt=0.2 \
    time/nlim=-1 time/tlim=0.2 \
    > "${label}.log" 2>&1
  test -s "${label}.ref_gh.hst"
  awk 'BEGIN {reached=0} !/^#/ && $1 >= 0.199999999 {reached=1} END {exit !reached}' \
    "${label}.ref_gh.hst"
  test -s "cbin_ref_gh_perturb_1/${label}.ref_gh_perturb.00001.cbin"
  test -s "cbin_ref_gh_native_con_1/${label}.ref_gh_native_con.00001.cbin"
  ! grep -Eiq 'NotPresent|page fault|SYCL exception|(^|[^[:alpha:]])(nan|inf)([^[:alpha:]]|$)' \
    "${label}.log"
  grep 'reference-GH perturbed trumpet:' "${label}.log" | tail -1
)

run_case ref_gh_perturbed_trumpet_n64 64 32 > n64_status.txt
run_case ref_gh_perturbed_trumpet_n96 96 48 > n96_status.txt
run_case ref_gh_perturbed_trumpet_n128 128 64 > n128_status.txt
cat n64_status.txt n96_status.txt n128_status.txt > case_status.txt

python3 "${ANALYZER}" \
  --field \
    "${OUT}/ref_gh_perturbed_trumpet_n64/cbin_ref_gh_perturb_1/ref_gh_perturbed_trumpet_n64.ref_gh_perturb.00001.cbin" \
    "${OUT}/ref_gh_perturbed_trumpet_n96/cbin_ref_gh_perturb_1/ref_gh_perturbed_trumpet_n96.ref_gh_perturb.00001.cbin" \
    "${OUT}/ref_gh_perturbed_trumpet_n128/cbin_ref_gh_perturb_1/ref_gh_perturbed_trumpet_n128.ref_gh_perturb.00001.cbin" \
  --constraint \
    "${OUT}/ref_gh_perturbed_trumpet_n64/cbin_ref_gh_native_con_1/ref_gh_perturbed_trumpet_n64.ref_gh_native_con.00001.cbin" \
    "${OUT}/ref_gh_perturbed_trumpet_n96/cbin_ref_gh_native_con_1/ref_gh_perturbed_trumpet_n96.ref_gh_native_con.00001.cbin" \
    "${OUT}/ref_gh_perturbed_trumpet_n128/cbin_ref_gh_native_con_1/ref_gh_perturbed_trumpet_n128.ref_gh_native_con.00001.cbin" \
  --output convergence.json > convergence.log
