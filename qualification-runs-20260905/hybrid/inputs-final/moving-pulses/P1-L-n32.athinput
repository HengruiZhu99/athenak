# Research candidate input; no numerical qualification implied.

<job>
basename = pc_gh_gauge_wave

<mesh>
nghost = 4
nx1 = 32
x1min = -2
x1max = 2
ix1_bc = periodic
ox1_bc = periodic
nx2 = 32
x2min = -2
x2max = 2
ix2_bc = periodic
ox2_bc = periodic
nx3 = 32
x3min = -2
x3max = 2
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<time>
evolution = dynamic
integrator = rk3
cfl_number = .2
nlim = -1
tlim = .25
ndiag = 1

<pc_gh>
spatial_order = 6
gauge = z4c_mp_hyperbolic
kappa = 1
dissipation = .3
boundedness_output = false
shift_eta = 0
reduction_system = advective
reduction_rate = 1
reduction_monitor = true
project_reduction_constraints = true
project_gauge_constraints = false
reduction_profile = constant
reduction_inner_rate = 1
reduction_core_radius = 0.125
reduction_taper_radius = 0.5
reduction_follow_trackers = true
co_0 = true
co_0_type = BH
co_0_x = -0.25
co_0_y = 0
co_0_z = 0
co_1 = true
co_1_type = BH
co_1_x = 0.25
co_1_y = 0
co_1_z = 0
reduction_projection_profile = smooth_core
research_dt_ceiling = 0.0125
hybrid_monitor = true

<problem>
pgen_name = regular_extension_pulse
pulse_family = L
pulse_direction = 1
pulse_amplitude = 1e-8
pulse_width = 0.75
pulse_shift = 0.5
pulse_radial = true
require_cuda = true
pulse_allow_reduction_projection = true

<output1>
file_type = rst
dt = .125
