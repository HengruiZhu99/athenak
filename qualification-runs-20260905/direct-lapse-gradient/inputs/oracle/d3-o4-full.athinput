# Research candidate input; no numerical qualification implied.

<job>
basename = regular_extension_oracle

<mesh>
nghost = 4
nx1 = 16
nx2 = 16
nx3 = 16
x1min = -1
x1max = 1
x2min = -1
x2max = 1
x3min = -1
x3max = 1
ix1_bc = periodic
ox1_bc = periodic
ix2_bc = periodic
ox2_bc = periodic
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
evolution = dynamic
integrator = rk3
cfl_number = .2
nlim = 0
tlim = 0
ndiag = 1

<pc_gh>
spatial_order = 4
gauge = z4c_mp_hyperbolic
reduction_system = advective
reduction_rate = 1
kappa = 1
dissipation = 0
project_reduction_constraints = false
boundedness_output = false
reduction_inner_rate = 1
reduction_profile = constant
project_gauge_constraints = false
reduction_projection_profile = smooth_core
reduction_core_radius = 4
reduction_taper_radius = 5
research_dt_ceiling = 0.0125
hybrid_monitor = true
reduction_monitor = true

<problem>
pgen_name = regular_projection_oracle
require_cuda = true
